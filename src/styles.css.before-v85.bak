  color: inherit;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof {
  margin-top: 26px !important;
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 10px 18px !important;
  align-items: center !important;
  color: #6a6158 !important;
  font-size: 14px !important;
  font-weight: 500 !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span {
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  padding: 0 !important;
  border-right: 0 !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span + span::before {
  content: '' !important;
  width: 1px !important;
  height: 14px !important;
  margin-right: 2px !important;
  background: rgba(105, 95, 85, 0.22) !important;
  position: static !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof-icon {
  width: 18px;
  height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #cc6c79;
  flex: 0 0 auto;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof-icon svg {
  width: 18px;
  height: 18px;
  display: block;
}

@media (max-width: 720px) {
