}

.story--fixed-narrative .strategy-story-card--hero .hero-actions .button {
  min-height: 54px !important;
  padding: 0 20px !important;
  border-radius: 12px !important;
  font-size: 13px !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof {
  margin-top: 16px !important;
  font-size: 10px !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span,
.story--fixed-narrative .strategy-story-card--hero .micro-proof span + span {
  font-size: 10px !important;
}

/* Later stages: no giant white veil. Use a compact editorial readability strip only. */
.story--fixed-narrative .strategy-story-ui--zone {
  padding-left: 72px !important;
}

.story--fixed-narrative .strategy-story-ui--zone .strategy-story-card--zone {
  width: min(560px, 34vw) !important;
  padding: 18px 24px 20px 30px !important;
