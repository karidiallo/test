/* Last stage CTA — editorial action row, not another card */
.strategy-zone-action {
  max-width: 520px;
  margin-top: 26px !important;
  padding: 20px 0 0 !important;
  border: 0 !important;
  border-top: 1px solid rgba(31,25,21,.13) !important;
  border-radius: 0 !important;
