/* =========================================================
   V37 — premium journey rail instead of generic proof tag
   ========================================================= */

.story--fixed-narrative .strategy-story-card--zone .strategy-zone-proof {
  display: none !important;
}

.journey-rail {
  margin-top: 26px;
  padding-top: 18px;
  border-top: 1px solid rgba(28, 24, 21, 0.10);
}

.journey-rail__label {
  margin-bottom: 18px;
  color: #9b7160;
  font: 800 10px/1 var(--body);
  letter-spacing: .16em;
  text-transform: uppercase;
}

.journey-rail__track {
  position: relative;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  align-items: start;
}

.journey-rail__track::before {
  content: '';
  position: absolute;
  left: 12px;
  right: 12px;
  top: 7px;
  height: 1px;
  background: linear-gradient(90deg, rgba(179,151,129,.28), rgba(179,151,129,.58), rgba(179,151,129,.28));
}

.journey-rail__item {
  position: relative;
  z-index: 1;
  display: grid;
  justify-items: start;
  gap: 10px;
  min-width: 0;
  padding-right: 10px;
}

.journey-rail__node {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 2px solid #fffaf5;
  background: #cab29d;
  box-shadow: 0 0 0 1px rgba(142,112,91,.22), 0 4px 12px rgba(94,68,52,.10);
  transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
}

.journey-rail__item b {
  display: block;
  max-width: 11ch;
  color: #4f4842;
  font: 650 11px/1.35 var(--body);
  letter-spacing: .01em;
  overflow-wrap: anywhere;
}

.journey-rail__item:hover .journey-rail__node {
  transform: scale(1.18);
  background: #d96b78;
  box-shadow: 0 0 0 5px rgba(217,107,120,.10);
}

.journey-rail__item:hover b {
  color: #1f1a17;
}

.journey-rail__item.is-active .journey-rail__node {
  background: linear-gradient(135deg, #ef8e70, #c83261);
  box-shadow: 0 0 0 6px rgba(203,67,102,.11), 0 8px 18px rgba(176,58,89,.18);
}

.journey-rail__item.is-active b {
  color: #b62e59;
  font-weight: 760;
}

@media (max-width: 1080px) {
  .journey-rail__track {
    grid-template-columns: repeat(5, minmax(86px, 1fr));
    overflow-x: auto;
    padding-bottom: 8px;
  }
}

@media (max-width: 760px) {
  .journey-rail {
    margin-top: 20px;
    padding-top: 14px;
  }

  .journey-rail__label {
    margin-bottom: 14px;
  }

  .journey-rail__track {
    grid-template-columns: repeat(5, 92px);
  }

  .journey-rail__item b {
    font-size: 10.5px;
  }
}

/* =========================================================
   V40 — client-value rework: problems, sample answer, method, industries
   ========================================================= */

/* Problems / buying situations */
.problems-section {
  padding: 132px 0;
  background: #f7f3ed;
  color: var(--ink);
}

.problems-heading { margin-bottom: 46px; }
.problems-heading h2 { max-width: 1040px; }
.problems-heading p { max-width: 720px; }

.problems-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-top: 1px solid rgba(18,17,16,.10);
  border-left: 1px solid rgba(18,17,16,.10);
}

.problem-card {
  min-height: 220px;
  padding: 28px 30px 30px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 34px;
  text-decoration: none;
  color: var(--ink);
  border-right: 1px solid rgba(18,17,16,.10);
  border-bottom: 1px solid rgba(18,17,16,.10);
  background: rgba(255,255,255,.34);
  transition: background .22s ease, transform .22s ease, box-shadow .22s ease;
}

.problem-card:hover {
  background: #fffaf5;
  transform: translateY(-2px);
  box-shadow: 0 22px 50px rgba(54,42,34,.06);
}

.problem-card-top {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-start;
}

.problem-card-top span {
  max-width: 15ch;
  font: 560 clamp(30px, 2.8vw, 44px)/.98 var(--display);
  letter-spacing: -.045em;
}

.problem-card-top i {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  font-style: normal;
  background: rgba(165,46,85,.08);
  color: var(--wine);
  transition: transform .2s ease, background .2s ease;
}

.problem-card:hover .problem-card-top i {
  transform: translate(2px,-2px);
  background: rgba(165,46,85,.14);
}

.problem-card p {
  max-width: 58ch;
  margin: 0;
  color: #625a53;
  font-size: 16px;
  line-height: 1.7;
}

/* Sample answer: sell clarity, not a report UI */
.sample-section--decision {
  background: linear-gradient(180deg, #eee6dc 0%, #e9e1d7 100%);
}

.sample-heading--decision { margin-bottom: 44px; }
.sample-heading--decision h2 { max-width: 980px; }
.sample-heading--decision p { max-width: 760px; font-size: 16px; line-height: 1.75; }

.decision-example {
  overflow: hidden;
  border-radius: 30px;
  border: 1px solid rgba(18,17,16,.12);
  background: #171412;
  box-shadow: 0 36px 90px rgba(56,43,34,.18);
}

.decision-example-lead {
  padding: 44px 46px 42px;
  border-bottom: 1px solid rgba(255,255,255,.10);
  background:
    radial-gradient(circle at 100% 0%, rgba(205,74,107,.16), transparent 34%),
    #171412;
}

.decision-example-lead > span,
.decision-example-card > span,
.decision-example-bottom > span {
  display: block;
  color: #e997aa;
  font: 800 11px/1 var(--body);
  letter-spacing: .15em;
}

.decision-example-lead h3 {
  margin: 18px 0 20px;
  max-width: 980px;
  color: #fff;
  font: 520 clamp(50px, 5vw, 78px)/.92 var(--display);
  letter-spacing: -.06em;
}

.decision-example-lead h3 strong {
  color: #ef7d78;
  font-weight: inherit;
}

.decision-example-lead p {
  max-width: 850px;
  margin: 0;
  color: rgba(255,255,255,.68);
  font-size: 17px;
  line-height: 1.72;
}

.decision-example-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.decision-example-card {
  min-height: 300px;
  padding: 32px 34px 34px;
  border-right: 1px solid rgba(255,255,255,.09);
  border-bottom: 1px solid rgba(255,255,255,.09);
  background: rgba(255,255,255,.02);
  transition: background .2s ease;
}

.decision-example-card:nth-child(2n) { border-right: 0; }
.decision-example-card:nth-child(n+3) { border-bottom: 0; }
.decision-example-card:hover { background: rgba(255,255,255,.045); }

.decision-example-card h4 {
  margin: 20px 0 16px;
  max-width: 22ch;
  color: #fff;
  font: 520 clamp(28px, 2.6vw, 40px)/1.02 var(--display);
  letter-spacing: -.045em;
}

.decision-example-card p {
  max-width: 56ch;
  margin: 0;
  color: rgba(255,255,255,.58);
  font-size: 15px;
  line-height: 1.72;
}

.decision-example-bottom {
  padding: 30px 34px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 24px;
  background: #fffaf5;
}

.decision-example-bottom > span { color: var(--wine); white-space: nowrap; }
.decision-example-bottom strong {
  color: #211c19;
  font-size: 17px;
  line-height: 1.5;
  font-weight: 600;
}
.decision-example-bottom a {
  min-height: 52px;
  padding: 0 18px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: #fff;
  background: var(--ink);
  font-size: 13px;
  font-weight: 700;
}

/* Method: deliberately de-emphasize tools */
.method-v6--simple {
  padding: 132px 0;
  background: #12100f;
  color: #fff;
}

.method-simple-shell {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 80px;
  align-items: center;
}

.method-simple-copy .eyebrow { color: rgba(255,255,255,.45); }
.method-simple-copy h2 {
  margin: 20px 0 24px;
  max-width: 900px;
  font: 520 clamp(54px, 5.6vw, 88px)/.91 var(--display);
  letter-spacing: -.062em;
}
.method-simple-copy p {
  max-width: 760px;
  margin: 0;
  color: rgba(255,255,255,.60);
  font-size: 17px;
  line-height: 1.75;
}
.method-simple-copy > strong {
  display: block;
  max-width: 780px;
  margin-top: 26px;
  color: #fff;
  font-size: 19px;
  line-height: 1.6;
}

.method-simple-tools {
  padding: 30px;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 24px;
  background: rgba(255,255,255,.025);
}
.method-simple-tools > span {
  display: block;
  margin-bottom: 22px;
  color: #e390a5;
  font: 800 10px/1 var(--body);
  letter-spacing: .14em;
}
.method-simple-tools > div {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 12px;
}
.method-simple-tools b {
  padding: 11px 13px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 10px;
  color: rgba(255,255,255,.82);
  font-size: 13px;
  font-weight: 600;
  background: rgba(255,255,255,.025);
}
.method-simple-tools small {
  display: block;
  margin-top: 24px;
  color: rgba(255,255,255,.42);
  font-size: 13px;
  line-height: 1.7;
}

/* Industries: simple names, no internal taxonomy */
.industries-layout--simple { grid-template-columns: .82fr 1.18fr; }
.industry-grid--simple {
  gap: 1px !important;
  background: rgba(255,255,255,.10);
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 20px;
  overflow: hidden;
}
.industry-grid--simple article {
  min-height: 128px !important;
  padding: 20px 24px !important;
  justify-content: center !important;
  align-items: flex-start !important;
  text-align: left !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: #1b1816 !important;
}
.industry-grid--simple article:hover {
  transform: none !important;
  background: #231e1b !important;
}
.industry-grid--simple h3 {
  margin: 0 !important;
  max-width: none !important;
  color: #fff !important;
  font-size: clamp(25px, 2.2vw, 34px) !important;
  line-height: 1.05 !important;
}
.industry-grid--simple p { display: none !important; }

@media (max-width: 980px) {
  .problems-grid,
  .decision-example-grid,
  .method-simple-shell,
  .industries-layout--simple {
    grid-template-columns: 1fr;
  }
  .problem-card { min-height: 0; }
  .decision-example-card { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.09) !important; min-height: 0; }
  .decision-example-card:last-child { border-bottom: 0 !important; }
  .decision-example-bottom { grid-template-columns: 1fr; }
  .decision-example-bottom > span { white-space: normal; }
}

@media (max-width: 720px) {
  .problems-section,
  .method-v6--simple { padding: 88px 0; }
  .problem-card { padding: 22px 20px; gap: 24px; }
  .problem-card-top span { font-size: 30px; }
  .decision-example { border-radius: 22px; }
  .decision-example-lead { padding: 28px 22px 26px; }
  .decision-example-lead h3 { font-size: 44px; }
  .decision-example-card { padding: 24px 22px; }
  .decision-example-card h4 { font-size: 28px; }
  .decision-example-bottom { padding: 24px 22px; }
  .method-simple-copy h2 { font-size: 50px; }
  .method-simple-tools { padding: 22px 18px; }
}

/* =========================================================
   V41 — interactive premium Problems section
   ========================================================= */

.problems-section--interactive {
  position: relative;
  overflow: hidden;
  padding: 138px 0 144px;
  background:
    radial-gradient(circle at 86% 12%, rgba(174, 56, 91, .16), transparent 24%),
    radial-gradient(circle at 18% 84%, rgba(217, 126, 94, .10), transparent 26%),
    #14110f;
  color: #f8f3ed;
}

.problems-section--interactive::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    repeating-linear-gradient(125deg, rgba(255,255,255,.022) 0 1px, transparent 1px 32px),
    linear-gradient(90deg, rgba(255,255,255,.025) 0 1px, transparent 1px 100%);
  opacity: .72;
}

.problems-experience {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(320px, .88fr) minmax(520px, 1.12fr);
  gap: clamp(64px, 7vw, 120px);
  align-items: start;
}

.problems-intro {
  position: sticky;
  top: 128px;
  align-self: start;
}

.problems-intro .eyebrow {
  color: #d99a80;
}

.problems-intro h2 {
  max-width: 760px;
  margin: 18px 0 22px;
  color: #fffaf5;
  font: 560 clamp(46px, 4.2vw, 72px)/.95 var(--display);
  letter-spacing: -.06em;
  text-wrap: balance;
}

.problems-intro .accent-text {
  background: linear-gradient(135deg, #ee9a79 0%, #e56875 54%, #ba3159 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.problems-intro > p {
  max-width: 590px;
  margin: 0;
  color: rgba(255,248,241,.68);
  font-size: 17px;
  line-height: 1.72;
}

.problem-active-summary {
  margin-top: 42px;
  padding-top: 26px;
  border-top: 1px solid rgba(255,255,255,.12);
}

.problem-active-summary > span {
  display: block;
  margin-bottom: 12px;
  color: rgba(242,164,134,.82);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .16em;
}

.problem-active-summary strong {
  display: block;
  max-width: 18ch;
  color: #fffaf5;
  font: 560 clamp(28px, 2.5vw, 42px)/1 var(--display);
  letter-spacing: -.045em;
}

.problem-active-summary p {
  max-width: 560px;
  margin: 16px 0 22px;
  color: rgba(255,248,241,.70);
  font-size: 15px;
  line-height: 1.72;
}

.problem-active-summary a {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  color: #fffaf5;
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  border-bottom: 1px solid rgba(255,255,255,.30);
  padding-bottom: 7px;
  transition: color .2s ease, border-color .2s ease, gap .2s ease;
}

.problem-active-summary a:hover {
  color: #f19a7c;
  border-color: #f19a7c;
  gap: 18px;
}

.problem-navigator {
  border-top: 1px solid rgba(255,255,255,.12);
}

.problem-row {
  width: 100%;
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0 26px;
  min-height: 112px;
  padding: 28px 4px 26px;
  border: 0;
  border-bottom: 1px solid rgba(255,255,255,.12);
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
  overflow: hidden;
}

.problem-row::before {
  content: '';
  position: absolute;
  inset: 8px -18px;
  border-radius: 18px;
  background: linear-gradient(90deg, rgba(255,255,255,.06), rgba(255,255,255,.015));
  opacity: 0;
  transform: translateX(14px);
  transition: opacity .24s ease, transform .24s ease;
}

.problem-row:hover::before,
.problem-row.is-active::before {
  opacity: 1;
  transform: translateX(0);
}

.problem-row-title,
.problem-row-action,
.problem-row-copy,
.problem-row-line {
  position: relative;
  z-index: 1;
}

.problem-row-title {
  color: rgba(255,250,245,.58);
  font: 520 clamp(28px, 2.5vw, 42px)/1 var(--display);
  letter-spacing: -.045em;
  transition: color .22s ease, transform .22s ease;
}

.problem-row-action {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 999px;
  color: rgba(255,255,255,.46);
  font-size: 15px;
  transition: color .22s ease, border-color .22s ease, background .22s ease, transform .22s ease;
}

.problem-row-copy {
  grid-column: 1 / -1;
  max-width: 660px;
  max-height: 0;
  margin-top: 0;
  overflow: hidden;
  color: rgba(255,248,241,.66);
  font-size: 15px;
  line-height: 1.7;
  opacity: 0;
  transform: translateY(-4px);
  transition: max-height .34s ease, opacity .26s ease, margin-top .3s ease, transform .3s ease;
}

.problem-row-line {
  grid-column: 1 / -1;
  height: 2px;
  margin-top: 22px;
  background: rgba(255,255,255,.08);
  overflow: hidden;
}

.problem-row-line i {
  display: block;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, #ee9a79, #c7335e);
  transition: width .34s ease;
}

.problem-row:hover .problem-row-title,
.problem-row.is-active .problem-row-title {
  color: #fffaf5;
  transform: translateX(8px);
}

.problem-row:hover .problem-row-action,
.problem-row.is-active .problem-row-action {
  color: #fff;
  border-color: rgba(235,113,122,.50);
  background: rgba(194,50,91,.14);
  transform: translate(-4px, 0);
}

.problem-row.is-active .problem-row-copy {
  max-height: 140px;
  margin-top: 16px;
  opacity: 1;
  transform: translateY(0);
}

.problem-row.is-active .problem-row-line i {
  width: 100%;
}

@media (max-width: 980px) {
  .problems-section--interactive {
    padding: 100px 0 108px;
  }

  .problems-experience {
    grid-template-columns: 1fr;
    gap: 52px;
  }

  .problems-intro {
    position: static;
  }

  .problem-active-summary {
    display: none;
  }

  .problems-intro h2 {
    max-width: 880px;
  }
}

@media (max-width: 680px) {
  .problems-section--interactive {
    padding: 82px 0 88px;
  }

  .problems-intro h2 {
    font-size: clamp(40px, 10.8vw, 56px);
  }

  .problems-intro > p {
    font-size: 15px;
  }

  .problem-row {
    min-height: 96px;
    padding: 24px 0 22px;
  }

  .problem-row-title {
    font-size: clamp(28px, 8vw, 38px);
  }

  .problem-row-action {
    width: 36px;
    height: 36px;
  }

  .problem-row-copy {
    font-size: 14px;
  }
}

/* =========================================================
   V42 — compact premium problems navigator
   ========================================================= */
.problems-section--compact {
  position: relative;
  overflow: hidden;
  padding: 92px 0 96px;
  background:
    radial-gradient(circle at 82% 8%, rgba(214, 82, 111, .08), transparent 24%),
    linear-gradient(180deg, #f4ede5 0%, #efe6dd 100%);
  color: var(--ink);
  border-top: 1px solid rgba(29, 23, 20, .08);
  border-bottom: 1px solid rgba(29, 23, 20, .08);
}

.problems-section--compact::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    repeating-linear-gradient(125deg, rgba(108, 87, 72, .035) 0 1px, transparent 1px 34px),
    radial-gradient(circle at 8% 88%, rgba(214, 112, 87, .07), transparent 26%);
}

.problems-compact-shell {
  position: relative;
  z-index: 1;
  max-width: 1320px;
}

.problems-compact-head {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, .65fr);
  gap: clamp(44px, 7vw, 110px);
  align-items: end;
  padding-bottom: 36px;
  border-bottom: 1px solid rgba(30, 24, 21, .11);
}

.problems-compact-head .eyebrow {
  color: #9b6f57;
}

.problems-compact-head h2 {
  max-width: 880px;
  margin: 14px 0 0;
  font: 560 clamp(42px, 4vw, 66px)/.97 var(--display);
  letter-spacing: -.058em;
  text-wrap: balance;
}

.problem-head-active {
  align-self: end;
  min-height: 118px;
  padding: 0 0 4px;
  animation: problemHeadIn .34s cubic-bezier(.2,.78,.2,1) both;
}

.problem-head-active-kicker {
  display: block;
  margin-bottom: 10px;
  color: #9c765e;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .16em;
}

.problem-head-active h3 {
  max-width: 12ch;
  margin: 0;
  font: 560 clamp(30px, 3vw, 48px)/1 var(--display);
  letter-spacing: -.048em;
  text-wrap: balance;
}

@keyframes problemHeadIn {
  from { opacity: .2; transform: translateY(10px); filter: blur(3px); }
  to { opacity: 1; transform: translateY(0); filter: blur(0); }
}

.problem-tabs {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  border-bottom: 1px solid rgba(30, 24, 21, .11);
}

.problem-tab {
  position: relative;
  min-height: 92px;
  padding: 22px 15px 20px;
  border: 0;
  border-right: 1px solid rgba(30, 24, 21, .09);
  background: transparent;
  color: #877d74;
  text-align: left;
  cursor: pointer;
  transition: color .2s ease, background .24s ease;
}

.problem-tab:last-child { border-right: 0; }

.problem-tab span {
  display: block;
  max-width: 15ch;
  font: 600 14px/1.32 var(--body);
}

.problem-tab i {
  position: absolute;
  left: 15px;
  right: 15px;
  bottom: -1px;
  height: 2px;
  background: linear-gradient(90deg, #e8896f, #c83460);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .28s cubic-bezier(.2,.75,.2,1);
}

.problem-tab:hover,
.problem-tab:focus-visible {
  color: #2a211d;
  background: rgba(255,255,255,.22);
}

.problem-tab.is-active {
  color: #171310;
  background: rgba(255,255,255,.38);
}

.problem-tab.is-active i { transform: scaleX(1); }

.problem-stage {
  position: relative;
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 34px;
  padding: 38px 0 0;
}

.problem-stage-index {
  padding-top: 5px;
  color: #b65b67;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .15em;
}

.problem-stage-content {
  display: block;
  max-width: 760px;
  animation: problemStageIn .34s cubic-bezier(.2,.78,.2,1) both;
}

@keyframes problemStageIn {
  from { opacity: .25; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.problem-stage-kicker {
  display: block;
  margin-bottom: 10px;
  color: #9c765e;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .16em;
}

.problems-helper-copy {
  max-width: 760px;
  margin: 26px 0 0 134px;
  color: #7a7068;
  font-size: 13px;
  line-height: 1.65;
}

.problem-stage-detail p {
  max-width: 650px;
  margin: 0;
  color: #5f5750;
  font-size: 17px;
  line-height: 1.72;
}

.problem-stage-detail a {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 22px;
  color: #181310;
  text-decoration: none;
  font-size: 14px;
  font-weight: 750;
  border-bottom: 1px solid rgba(24,19,16,.28);
  padding-bottom: 6px;
  transition: gap .2s ease, color .2s ease, border-color .2s ease;
}

.problem-stage-detail a:hover {
  gap: 17px;
  color: #b43b60;
  border-color: #b43b60;
}

.problem-stage-progress {
  grid-column: 2;
  height: 2px;
  margin-top: 34px;
  background: rgba(30,24,21,.08);
  overflow: hidden;
}

.problem-stage-progress span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, #e8896f, #c83460);
  transition: width .34s cubic-bezier(.2,.78,.2,1);
}

@media (max-width: 1080px) {
  .problem-tabs { grid-template-columns: repeat(3, 1fr); }
  .problem-tab:nth-child(3n) { border-right: 0; }
  .problem-tab:nth-child(-n+3) { border-bottom: 1px solid rgba(30,24,21,.08); }
}

@media (max-width: 820px) {
  .problems-section--compact { padding: 72px 0 76px; }
  .problems-compact-head { grid-template-columns: 1fr; gap: 26px; padding-bottom: 28px; }
  .problem-head-active { min-height: 0; }
  .problem-head-active h3 { font-size: clamp(30px, 8vw, 42px); }
  .problem-tabs { display: flex; overflow-x: auto; scrollbar-width: none; }
  .problem-tabs::-webkit-scrollbar { display: none; }
  .problem-tab { min-width: 180px; flex: 0 0 auto; min-height: 78px; }
  .problem-stage { grid-template-columns: 1fr; gap: 16px; padding-top: 28px; }
  .problem-stage-content { max-width: none; }
  .problem-stage-index { padding: 0; }
  .problem-stage-progress { grid-column: 1; margin-top: 26px; }
  .problems-helper-copy { margin-left: 0; }
  .problem-stage-detail p { font-size: 15px; }
}

/* =========================================================
   V43 — concrete sample map: less report, more decision
   ========================================================= */
.sample-section--decision {
  background: linear-gradient(180deg, #efe7dd 0%, #eae2d8 100%);
}

.sample-heading--decision {
  margin-bottom: 34px;
}

.sample-heading--decision h2 {
  max-width: 900px;
}

.sample-heading--decision p {
  max-width: 680px;
  font-size: 17px;
  line-height: 1.65;
}

.decision-snapshot {
  overflow: hidden;
  border: 1px solid rgba(18,17,16,.11);
  border-radius: 28px;
  background: #171412;
  color: #fff;
  box-shadow: 0 32px 86px rgba(52,39,31,.16);
}

.decision-snapshot-top {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(320px, .65fr);
  border-bottom: 1px solid rgba(255,255,255,.10);
}

.decision-snapshot-summary {
  padding: 38px 42px 34px;
  background: radial-gradient(circle at 100% 0%, rgba(201,66,99,.16), transparent 34%);
}

.decision-snapshot-summary > span,
.decision-priority > span,
.decision-not-now > span,
.decision-measure > span {
  display: block;
  color: #ec95a9;
  font: 800 10px/1 var(--body);
  letter-spacing: .15em;
}

.decision-snapshot-summary h3 {
  max-width: 820px;
  margin: 16px 0 14px;
  color: #fff;
  font: 520 clamp(42px, 4.4vw, 68px)/.95 var(--display);
  letter-spacing: -.055em;
}

.decision-snapshot-summary h3 strong {
  color: #ef7b77;
  font-weight: inherit;
}

.decision-snapshot-summary p {
  max-width: 650px;
  margin: 0;
  color: rgba(255,255,255,.66);
  font-size: 16px;
  line-height: 1.65;
}

.decision-scoreboard {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-content: stretch;
  border-left: 1px solid rgba(255,255,255,.10);
}

.decision-scoreboard > div {
  padding: 32px 24px 28px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 8px;
  background: rgba(255,255,255,.025);
}

.decision-scoreboard > div + div {
  border-left: 1px solid rgba(255,255,255,.09);
}

.decision-scoreboard span {
  color: rgba(255,255,255,.50);
  font-size: 12px;
}

.decision-scoreboard strong {
  color: #fff;
  font: 600 clamp(46px, 4vw, 66px)/.9 var(--display);
  letter-spacing: -.055em;
}

.decision-scoreboard small {
  color: rgba(255,255,255,.48);
  font-size: 11px;
  line-height: 1.3;
}

.decision-scoreboard .is-critical {
  background: linear-gradient(180deg, rgba(200,68,104,.10), rgba(200,68,104,.035));
}

.decision-scoreboard .is-critical strong,
.decision-scoreboard .is-critical small {
  color: #ef8a9f;
}

.decision-snapshot-body {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(320px, .6fr);
}

.decision-priority {
  padding: 34px 40px 38px;
  border-right: 1px solid rgba(255,255,255,.09);
}

.decision-priority h4 {
  max-width: 760px;
  margin: 14px 0 26px;
  color: #fff;
  font: 520 clamp(30px, 3vw, 46px)/1 var(--display);
  letter-spacing: -.045em;
}

.decision-action-list {
  border-top: 1px solid rgba(255,255,255,.10);
}

.decision-action-list article {
  min-height: 88px;
  padding: 17px 0;
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  border-bottom: 1px solid rgba(255,255,255,.08);
  transition: padding-left .22s ease, background .22s ease;
}

.decision-action-list article:hover {
  padding-left: 10px;
  background: linear-gradient(90deg, rgba(255,255,255,.035), transparent 70%);
}

.decision-action-list article > b {
  color: #e78da2;
  font: 800 11px/1.4 var(--body);
}

.decision-action-list article strong {
  display: block;
  color: #fff;
  font-size: 17px;
  line-height: 1.3;
}

.decision-action-list article p {
  margin: 5px 0 0;
  color: rgba(255,255,255,.56);
  font-size: 14px;
  line-height: 1.55;
}

.decision-snapshot-side {
  display: grid;
  grid-template-rows: auto 1fr;
}

.decision-not-now,
.decision-measure {
  padding: 30px 30px 28px;
}

.decision-not-now {
  border-bottom: 1px solid rgba(255,255,255,.09);
  background: rgba(255,255,255,.018);
}

.decision-not-now strong {
  display: block;
  margin-top: 15px;
  color: rgba(255,255,255,.84);
  font-size: 16px;
  line-height: 1.45;
  font-weight: 600;
}

.decision-measure > div {
  padding: 15px 0;
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 12px;
  border-bottom: 1px solid rgba(255,255,255,.07);
}

.decision-measure > div:last-child {
  border-bottom: 0;
}

.decision-measure b {
  color: #fff;
  font-size: 14px;
}

.decision-measure p {
  margin: 0;
  color: rgba(255,255,255,.52);
  font-size: 13px;
  line-height: 1.5;
}

.decision-snapshot-footer {
  min-height: 78px;
  padding: 18px 24px 18px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  background: #fffaf5;
  color: #211c19;
}

.decision-snapshot-footer strong {
  max-width: 820px;
  font-size: 16px;
  line-height: 1.45;
  font-weight: 650;
}

.decision-snapshot-footer a {
  min-height: 48px;
  padding: 0 17px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex: 0 0 auto;
  text-decoration: none;
  color: #fff;
  background: #171412;
  font-size: 13px;
  font-weight: 700;
  transition: transform .2s ease, box-shadow .2s ease;
}

.decision-snapshot-footer a:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(24,20,18,.16);
}

@media (max-width: 980px) {
  .decision-snapshot-top,
  .decision-snapshot-body {
    grid-template-columns: 1fr;
  }

  .decision-scoreboard {
    border-left: 0;
    border-top: 1px solid rgba(255,255,255,.09);
  }

  .decision-priority {
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,.09);
  }
}

@media (max-width: 680px) {
  .decision-snapshot {
    border-radius: 22px;
  }

  .decision-snapshot-summary,
  .decision-priority,
  .decision-not-now,
  .decision-measure {
    padding-left: 22px;
    padding-right: 22px;
  }

  .decision-scoreboard {
    grid-template-columns: 1fr 1fr;
  }

  .decision-scoreboard > div {
    padding: 24px 18px 22px;
  }

  .decision-snapshot-summary h3 {
    font-size: 44px;
  }

  .decision-action-list article {
    grid-template-columns: 34px 1fr;
  }

  .decision-snapshot-footer {
    padding: 22px;
    align-items: flex-start;
    flex-direction: column;
  }

  .decision-snapshot-footer a {
    width: 100%;
    justify-content: space-between;
  }
}

/* =========================================================
   V47 — interactive sample map only
   Isolated to .sample-section--atlas; no global typography/layout overrides.
   ========================================================= */
.sample-section--atlas {
  background:
    radial-gradient(circle at 14% 12%, rgba(206, 122, 94, .08), transparent 28%),
    linear-gradient(180deg, #efe7dd 0%, #e9e1d7 100%);
}

.sample-heading--atlas {
  margin-bottom: 32px;
}

.sample-heading--atlas h2 {
  max-width: 900px;
}

.sample-heading--atlas p {
  max-width: 720px;
  font-size: 16px;
  line-height: 1.65;
}

.sample-atlas-shell {
  overflow: hidden;
  border: 1px solid rgba(27, 24, 22, .11);
  border-radius: 28px;
  background: #f8f2eb;
  box-shadow: 0 30px 82px rgba(56, 43, 35, .13);
}

.sample-atlas-topline {
  min-height: 78px;
  padding: 18px 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid rgba(27, 24, 22, .09);
  background: rgba(255, 252, 248, .82);
  backdrop-filter: blur(14px);
}

.sample-atlas-topline > div {
  display: flex;
  align-items: baseline;
  gap: 12px;
  min-width: 0;
}

.sample-atlas-topline span {
  color: #887d74;
  font: 800 9px/1 var(--body);
  letter-spacing: .16em;
  white-space: nowrap;
}

.sample-atlas-topline strong {
  color: #211c19;
  font-size: 14px;
  line-height: 1.35;
}

.sample-atlas-summary {
  justify-content: flex-end;
  text-align: right;
}

.sample-atlas-summary strong {
  color: #a93f58;
}

.sample-atlas-layout {
  min-height: 600px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  background: #f3ece4;
}

.sample-atlas-map {
  position: relative;
  min-height: 600px;
  overflow: hidden;
  border-right: 1px solid rgba(27, 24, 22, .09);
  background:
    radial-gradient(circle at 52% 46%, rgba(255,255,255,.9) 0 7%, transparent 8%),
    linear-gradient(135deg, rgba(255,255,255,.46), rgba(255,255,255,.06));
  isolation: isolate;
}

.sample-atlas-map::before,
.sample-atlas-map::after {
  content: '';
  position: absolute;
  border: 1px solid rgba(53, 45, 40, .055);
  border-radius: 999px;
  pointer-events: none;
}

.sample-atlas-map::before {
  width: 520px;
  height: 260px;
  left: -120px;
  top: 90px;
  transform: rotate(-12deg);
}

.sample-atlas-map::after {
  width: 460px;
  height: 240px;
  right: -90px;
  bottom: 38px;
  transform: rotate(16deg);
}

.sample-atlas-contours {
  position: absolute;
  inset: 0;
  opacity: .42;
  background:
    repeating-radial-gradient(ellipse at 22% 65%, transparent 0 34px, rgba(65,54,47,.045) 35px 36px, transparent 37px 58px),
    repeating-radial-gradient(ellipse at 74% 28%, transparent 0 30px, rgba(65,54,47,.04) 31px 32px, transparent 33px 54px);
  pointer-events: none;
  z-index: 0;
}

.sample-atlas-route {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
  z-index: 1;
}

.sample-atlas-route path {
  fill: none;
  vector-effect: non-scaling-stroke;
}

.sample-atlas-route__glow {
  opacity: .07;
  filter: url(#atlasRouteGlow);
}

.sample-atlas-route__glow path {
  stroke-width: 3.2px;
}

.sample-atlas-route__line {
  opacity: .48;
}

.sample-atlas-route__line path {
  stroke-width: 1.05px;
}


.sample-map-node {
  --node-accent: #8e7f73;
  position: absolute;
  left: var(--node-x);
  top: var(--node-y);
  z-index: 3;
  appearance: none;
  border: 0;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  /* x/y opisują środek właściwego punktu mapy, nie środek całego przycisku z etykietą */
  transform: translate(-17px, -50%);
  background: transparent;
  color: #29231f;
  text-align: left;
  cursor: pointer;
  font: inherit;
}

.sample-map-node--good { --node-accent: #7f887a; }
.sample-map-node--opportunity { --node-accent: #bb835e; }
.sample-map-node--warning { --node-accent: #c36f58; }
.sample-map-node--critical { --node-accent: #b3435c; }

.sample-map-node-dot {
  position: relative;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  border: 1px solid color-mix(in srgb, var(--node-accent) 45%, transparent);
  border-radius: 50%;
  background: rgba(250,246,241,.92);
  box-shadow: 0 8px 18px rgba(55,43,35,.10);
  transition: transform .28s cubic-bezier(.2,.8,.2,1), box-shadow .28s ease, border-color .28s ease, background .28s ease;
}

.sample-map-node-dot::before {
  content: '';
  position: absolute;
  inset: -7px;
  border: 1px solid color-mix(in srgb, var(--node-accent) 20%, transparent);
  border-radius: 50%;
  opacity: 0;
  transform: scale(.72);
  transition: opacity .28s ease, transform .28s ease;
}

.sample-map-node-dot i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--node-accent);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--node-accent) 10%, transparent);
}

.sample-map-node-copy {
  min-width: 0;
  padding: 8px 10px 8px 0;
  transition: transform .28s cubic-bezier(.2,.8,.2,1);
}

.sample-map-node-copy b,
.sample-map-node-copy small {
  display: block;
  white-space: nowrap;
}

.sample-map-node-copy b {
  color: #2c2521;
  font-size: 12px;
  line-height: 1.2;
  font-weight: 750;
}

.sample-map-node-copy small {
  margin-top: 3px;
  color: #8a7e75;
  font-size: 9.5px;
  line-height: 1.15;
}

.sample-map-node:hover .sample-map-node-dot,
.sample-map-node:focus-visible .sample-map-node-dot,
.sample-map-node.is-active .sample-map-node-dot {
  transform: scale(1.18);
  border-color: color-mix(in srgb, var(--node-accent) 72%, transparent);
  background: #fffaf5;
  box-shadow: 0 13px 28px rgba(55,43,35,.16);
}

.sample-map-node:hover .sample-map-node-dot::before,
.sample-map-node:focus-visible .sample-map-node-dot::before,
.sample-map-node.is-active .sample-map-node-dot::before {
  opacity: 1;
  transform: scale(1);
}

.sample-map-node:hover .sample-map-node-copy,
.sample-map-node:focus-visible .sample-map-node-copy,
.sample-map-node.is-active .sample-map-node-copy {
  transform: translateX(3px);
}

.sample-map-node.is-active .sample-map-node-copy b {
  color: var(--node-accent);
}

.sample-map-node:focus-visible {
  outline: none;
}

.sample-atlas-compass {
  position: absolute;
  left: 24px;
  bottom: 25px;
  z-index: 2;
  width: 30px;
  height: 46px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  color: rgba(57,48,43,.45);
}

.sample-atlas-compass span {
  font: 800 8px/1 var(--body);
  letter-spacing: .15em;
}

.sample-atlas-compass i {
  position: relative;
  width: 1px;
  height: 27px;
  background: rgba(57,48,43,.25);
}

.sample-atlas-compass i::before {
  content: '';
  position: absolute;
  left: -3px;
  top: 0;
  width: 7px;
  height: 7px;
  border-top: 1px solid rgba(57,48,43,.45);
  border-left: 1px solid rgba(57,48,43,.45);
  transform: rotate(45deg);
}

.sample-atlas-legend {
  position: absolute;
  right: 20px;
  bottom: 18px;
  z-index: 3;
  padding: 9px 11px;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 9px 12px;
  border: 1px solid rgba(45,38,33,.08);
  border-radius: 12px;
  background: rgba(255,250,245,.72);
  backdrop-filter: blur(10px);
}

.sample-atlas-legend span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #81766e;
  font-size: 9px;
}

.sample-atlas-legend i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #8b8179;
}

.sample-atlas-legend .is-good { background: #7f887a; }
.sample-atlas-legend .is-opportunity { background: #bb835e; }
.sample-atlas-legend .is-warning { background: #c36f58; }
.sample-atlas-legend .is-critical { background: #b3435c; }

.sample-atlas-detail {
  --detail-accent: #9b7764;
  position: relative;
  padding: 30px 28px 24px;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--detail-accent) 12%, transparent), transparent 32%),
    #191613;
  color: #fff;
  animation: sampleDetailIn .34s cubic-bezier(.2,.8,.2,1) both;
}

.sample-atlas-detail--good { --detail-accent: #8e9a87; }
.sample-atlas-detail--opportunity { --detail-accent: #ca9168; }
.sample-atlas-detail--warning { --detail-accent: #dc8063; }
.sample-atlas-detail--critical { --detail-accent: #d65f79; }

@keyframes sampleDetailIn {
  from { opacity: .28; transform: translateX(12px); }
  to { opacity: 1; transform: translateX(0); }
}

.sample-atlas-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.sample-atlas-detail-head > span {
  color: rgba(255,255,255,.38);
  font: 800 9px/1 var(--body);
  letter-spacing: .14em;
}

.sample-atlas-detail-head em {
  max-width: 160px;
  padding: 6px 8px;
  border: 1px solid color-mix(in srgb, var(--detail-accent) 30%, transparent);
  border-radius: 999px;
  background: color-mix(in srgb, var(--detail-accent) 11%, transparent);
  color: color-mix(in srgb, var(--detail-accent) 88%, white);
  font-size: 9px;
  line-height: 1.2;
  font-style: normal;
  font-weight: 750;
  text-align: right;
}

.sample-atlas-detail h3 {
  margin: 26px 0 28px;
  color: #fff;
  font: 520 clamp(30px, 2.6vw, 43px)/.96 var(--display);
  letter-spacing: -.045em;
}

.sample-atlas-detail-grid {
  border-top: 1px solid rgba(255,255,255,.09);
}

.sample-atlas-detail-grid > div {
  padding: 20px 0;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.sample-atlas-detail-grid span {
  display: block;
  margin-bottom: 7px;
  color: color-mix(in srgb, var(--detail-accent) 88%, white);
  font: 800 9px/1 var(--body);
  letter-spacing: .14em;
}

.sample-atlas-detail-grid p {
  margin: 0;
  color: rgba(255,255,255,.68);
  font-size: 13.5px;
  line-height: 1.55;
}

.sample-atlas-detail-grid .sample-atlas-next p {
  color: #fff;
  font-weight: 650;
}

.sample-atlas-detail-foot {
  margin-top: auto;
  padding-top: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  color: rgba(255,255,255,.36);
  font-size: 10px;
}

.sample-atlas-detail-foot b {
  color: rgba(255,255,255,.72);
  font-size: 11px;
}

.sample-atlas-footer {
  min-height: 76px;
  padding: 17px 22px 17px 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  border-top: 1px solid rgba(27,24,22,.08);
  background: #fffaf5;
}

.sample-atlas-footer p {
  max-width: 820px;
  margin: 0;
  color: #675d56;
  font-size: 13.5px;
  line-height: 1.55;
}

.sample-atlas-footer p strong {
  color: #251f1b;
}

.sample-atlas-footer a {
  min-height: 46px;
  padding: 0 16px;
  border-radius: 11px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  flex: 0 0 auto;
  color: #fff;
  background: #171412;
  text-decoration: none;
  font-size: 12px;
  font-weight: 750;
  transition: transform .2s ease, box-shadow .2s ease;
}

.sample-atlas-footer a:hover {
  transform: translateY(-2px);
  box-shadow: 0 11px 24px rgba(24,20,18,.15);
}

@media (prefers-reduced-motion: reduce) {
  .sample-atlas-detail,
  .sample-map-node-dot,
  .sample-map-node-copy,
  .sample-atlas-footer a {
    animation: none !important;
    transition: none !important;
  }
}

@media (max-width: 1050px) {
  .sample-atlas-layout {
    grid-template-columns: minmax(0, 1fr) 300px;
  }

  .sample-atlas-map,
  .sample-atlas-layout {
    min-height: 560px;
  }

  .sample-map-node-copy b { font-size: 11px; }
  .sample-map-node-copy small { display: none; }
}

@media (max-width: 820px) {
  .sample-atlas-topline {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .sample-atlas-summary {
    justify-content: flex-start;
    text-align: left;
  }

  .sample-atlas-layout {
    grid-template-columns: 1fr;
  }

  .sample-atlas-map {
    min-height: 520px;
    border-right: 0;
    border-bottom: 1px solid rgba(27,24,22,.09);
  }

  .sample-atlas-detail {
    min-height: 0;
  }

  .sample-atlas-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .sample-atlas-detail-grid > div {
    padding: 18px 16px 4px 0;
    border-bottom: 0;
  }
}

@media (max-width: 620px) {
  .sample-atlas-shell { border-radius: 22px; }
  .sample-heading--atlas { margin-bottom: 24px; }

  .sample-atlas-topline {
    padding: 16px 18px;
  }

  .sample-atlas-topline > div {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }

  .sample-atlas-map {
    min-height: 560px;
  }

  .sample-map-node-copy {
    padding-right: 0;
  }

  .sample-map-node-copy b {
    max-width: 112px;
    white-space: normal;
    font-size: 10.5px;
  }

  .sample-map-node-dot {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
  }

  .sample-atlas-legend {
    left: 18px;
    right: 18px;
    justify-content: flex-start;
  }

  .sample-atlas-detail {
    padding: 24px 20px 20px;
  }

  .sample-atlas-detail h3 {
    margin: 22px 0 20px;
    font-size: 36px;
  }

  .sample-atlas-detail-grid {
    grid-template-columns: 1fr;
  }

  .sample-atlas-detail-grid > div {
    padding: 16px 0;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .sample-atlas-footer {
    align-items: flex-start;
    flex-direction: column;
    padding: 19px;
  }
}

/* =========================================================
   V59 — diagnostic problem selector
   ========================================================= */
.problems-section--diagnostic {
  position: relative;
  overflow: hidden;
  padding: 86px 0 90px;
  background: #f2ebe3;
  color: var(--ink);
  border-top: 1px solid rgba(29, 23, 20, .08);
  border-bottom: 1px solid rgba(29, 23, 20, .08);
}

.problems-section--diagnostic::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .58;
  background:
    linear-gradient(rgba(64, 48, 38, .028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(64, 48, 38, .028) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: linear-gradient(to bottom, transparent 0, #000 18%, #000 82%, transparent 100%);
}

.problems-diagnostic-shell {
  position: relative;
  z-index: 1;
  max-width: 1280px;
}

.problems-diagnostic-intro {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, .55fr);
  column-gap: clamp(48px, 8vw, 128px);
  align-items: end;
  margin-bottom: 34px;
}

.problems-diagnostic-intro .eyebrow {
  grid-column: 1 / -1;
  margin-bottom: 14px;
  color: #9a7058;
}

.problems-diagnostic-intro h2 {
  max-width: 820px;
  margin: 0;
  font: 560 clamp(38px, 3.55vw, 58px)/.98 var(--display);
  letter-spacing: -.052em;
  text-wrap: balance;
}

.problems-diagnostic-intro > p {
  max-width: 430px;
  margin: 0 0 4px;
  color: #71675f;
  font-size: 15px;
  line-height: 1.65;
}

.problem-diagnostic-console {
  display: grid;
  grid-template-columns: minmax(330px, .82fr) minmax(0, 1.18fr);
  min-height: 440px;
  border: 1px solid rgba(35, 27, 23, .11);
  border-radius: 22px;
  overflow: hidden;
  background: rgba(255, 252, 248, .64);
  box-shadow: 0 28px 70px rgba(61, 43, 31, .08);
  backdrop-filter: blur(18px);
}

.problem-signal-list {
  padding: 16px;
  border-right: 1px solid rgba(35, 27, 23, .09);
  background: rgba(255, 255, 255, .38);
}

.problem-signal-caption {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 10px 10px 16px;
  color: #9a8f86;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.problem-signal {
  position: relative;
  display: grid;
  grid-template-columns: 34px 1fr 24px;
  gap: 10px;
  align-items: center;
  width: 100%;
  min-height: 58px;
  padding: 10px 12px;
  border: 0;
  border-top: 1px solid rgba(35, 27, 23, .075);
  border-radius: 12px;
  background: transparent;
  color: #756b63;
  text-align: left;
  cursor: pointer;
  transition: background .24s ease, color .24s ease, transform .24s cubic-bezier(.2,.72,.2,1);
}

.problem-signal:first-of-type { border-top-color: transparent; }

.problem-signal::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12px;
  bottom: 12px;
  width: 2px;
  border-radius: 2px;
  background: linear-gradient(180deg, #df8b6c, #c43b61);
  transform: scaleY(0);
  transition: transform .28s cubic-bezier(.2,.72,.2,1);
}

.problem-signal:hover,
.problem-signal:focus-visible {
  color: #231b17;
  background: rgba(255, 255, 255, .55);
  transform: translateX(2px);
  outline: none;
}

.problem-signal.is-active {
  color: #1c1613;
  background: #fffaf5;
  box-shadow: 0 12px 28px rgba(49, 34, 25, .07);
}

.problem-signal.is-active::before { transform: scaleY(1); }

.problem-signal-no {
  color: #b5a89d;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .12em;
}

.problem-signal-label {
  font-size: 13px;
  font-weight: 700;
  line-height: 1.3;
}

.problem-signal-arrow {
  justify-self: end;
  opacity: 0;
  transform: translate(-5px, 5px);
  color: #c64262;
  font-size: 15px;
  transition: opacity .22s ease, transform .22s ease;
}

.problem-signal.is-active .problem-signal-arrow,
.problem-signal:hover .problem-signal-arrow {
  opacity: 1;
  transform: translate(0, 0);
}

.problem-diagnostic-result {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 24px 34px 30px;
  color: #f7f0e9;
  background:
    radial-gradient(circle at 88% 10%, rgba(211, 68, 98, .14), transparent 26%),
    radial-gradient(circle at 6% 94%, rgba(222, 137, 100, .10), transparent 30%),
    #1c1816;
}

.problem-diagnostic-result::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .16;
  background:
    linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: linear-gradient(135deg, #000, transparent 74%);
}

.problem-result-topline {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(255,255,255,.11);
  color: #a99e96;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .16em;
}

.problem-result-body {
  position: relative;
  z-index: 2;
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-top: 28px;
  animation: problemResultReveal .42s cubic-bezier(.2,.78,.2,1) both;
}

@keyframes problemResultReveal {
  from { opacity: 0; transform: translateY(12px); filter: blur(4px); }
  to { opacity: 1; transform: translateY(0); filter: blur(0); }
}

.problem-result-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: fit-content;
  margin-bottom: 12px;
  color: #bfb3aa;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .15em;
}

.problem-result-status i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #df7f6b;
  box-shadow: 0 0 0 5px rgba(223,127,107,.10);
}

.problem-result-body h3 {
  max-width: 13ch;
  margin: 0;
  color: #fffaf5;
  font: 560 clamp(30px, 3vw, 46px)/.98 var(--display);
  letter-spacing: -.045em;
  text-wrap: balance;
}

.problem-result-body > p {
  max-width: 610px;
  margin: 16px 0 0;
  color: #c5bab2;
  font-size: 14px;
  line-height: 1.65;
}

.problem-source-block {
  margin-top: auto;
  padding-top: 28px;
}

.problem-source-label {
  display: block;
  margin-bottom: 12px;
  color: #8f837b;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.problem-source-map {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.problem-source-map::before {
  content: '';
  position: absolute;
  left: 7%;
  right: 7%;
  top: 50%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(231,148,113,.45) 12%, rgba(199,56,92,.5) 88%, transparent);
  transform: translateY(-50%);
}

.problem-source-node {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  padding: 7px 9px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 999px;
  background: rgba(28,24,22,.86);
  color: #f2e8e0;
  font-size: 10px;
  font-weight: 700;
  text-align: center;
  opacity: 0;
  transform: translateY(7px);
  animation: problemSourceIn .35s cubic-bezier(.2,.78,.2,1) forwards;
  animation-delay: calc(var(--source-i) * 60ms + 90ms);
}

.problem-source-node i {
  width: 5px;
  height: 5px;
  flex: 0 0 auto;
  margin-right: 7px;
  border-radius: 50%;
  background: linear-gradient(135deg, #e49372, #c53d61);
}

@keyframes problemSourceIn {
  to { opacity: 1; transform: translateY(0); }
}

.problem-result-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  margin-top: 22px;
  color: #fff8f2;
  font-size: 12px;
  font-weight: 750;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,248,242,.35);
  padding-bottom: 5px;
  transition: gap .22s ease, border-color .22s ease, color .22s ease;
}

.problem-result-cta:hover {
  gap: 15px;
  color: #f2a184;
  border-color: #f2a184;
}

.problem-diagnostic-scan {
  position: absolute;
  z-index: 1;
  left: -30%;
  right: -30%;
  top: 0;
  height: 1px;
  opacity: .65;
  background: linear-gradient(90deg, transparent, #e99374, #c53b61, transparent);
  box-shadow: 0 0 22px rgba(211,67,98,.26);
  animation: problemScan 5.2s ease-in-out infinite;
}

@keyframes problemScan {
  0%, 12% { transform: translateY(0); opacity: 0; }
  22% { opacity: .58; }
  76% { opacity: .38; }
  88%, 100% { transform: translateY(438px); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .problem-result-body,
  .problem-source-node,
  .problem-diagnostic-scan { animation: none; opacity: 1; transform: none; }
}

@media (max-width: 980px) {
  .problems-diagnostic-intro {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .problems-diagnostic-intro > p { margin-top: 6px; }
  .problem-diagnostic-console { grid-template-columns: minmax(280px, .75fr) minmax(0, 1.25fr); }
  .problem-source-map { grid-template-columns: repeat(2, 1fr); }
  .problem-source-map::before { display: none; }
}

@media (max-width: 760px) {
  .problems-section--diagnostic { padding: 68px 0 72px; }
  .problems-diagnostic-intro { margin-bottom: 24px; }
  .problems-diagnostic-intro h2 { font-size: clamp(36px, 10vw, 48px); }
  .problem-diagnostic-console { display: block; min-height: 0; border-radius: 18px; }
  .problem-signal-list { border-right: 0; border-bottom: 1px solid rgba(35,27,23,.09); }
  .problem-signal-caption { padding-bottom: 10px; }
  .problem-signal { min-height: 50px; }
  .problem-diagnostic-result { min-height: 400px; padding: 22px 22px 26px; }
  .problem-result-body h3 { font-size: clamp(32px, 9vw, 42px); }
  .problem-source-map { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @keyframes problemScan { 0%, 12% { transform: translateY(0); opacity: 0; } 22% { opacity: .5; } 88%, 100% { transform: translateY(400px); opacity: 0; } }
}

/* =========================================================
   V65 — Dla kogo: compact interactive industry decision grid
   ========================================================= */
.industries--interactive {
  position: relative;
  overflow: hidden;
  padding: 126px 0 132px;
  background:
    radial-gradient(circle at 8% 8%, rgba(182, 73, 92, .055), transparent 24%),
    #eee7de;
}

.industries--interactive::after {
  content: '';
  position: absolute;
  right: -120px;
  bottom: -170px;
  width: 460px;
  height: 460px;
  border: 1px solid rgba(101, 72, 59, .07);
  border-radius: 50%;
  box-shadow: 0 0 0 58px rgba(101, 72, 59, .025), 0 0 0 116px rgba(101, 72, 59, .018);
  pointer-events: none;
}

.industries-layout--interactive {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(300px, .72fr) minmax(560px, 1.28fr);
  gap: clamp(54px, 6vw, 96px);
  align-items: start;
}

.industries-copy--interactive {
  position: sticky;
  top: 122px;
}

.industries-copy--interactive h2 {
  max-width: 620px;
  margin: 20px 0 22px;
  font: 520 clamp(40px, 4.2vw, 66px)/.95 var(--display);
  letter-spacing: -.055em;
  text-wrap: balance;
}

.industries-copy--interactive p {
  max-width: 470px;
  margin: 0;
  color: #6f665e;
  font-size: 12px;
  line-height: 1.72;
}

.industries-copy--interactive .text-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: 28px;
}

.industry-accordion {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.industry-row {
  overflow: hidden;
  min-width: 0;
  border: 1px solid rgba(39, 30, 25, .10);
  border-radius: 16px;
  background: rgba(255, 252, 248, .66);
  box-shadow: 0 10px 30px rgba(67, 50, 40, .025);
  transition: border-color .26s ease, background .26s ease, box-shadow .26s ease, transform .26s ease;
}

.industry-row:hover {
  border-color: rgba(150, 56, 79, .22);
  background: rgba(255, 253, 250, .9);
  transform: translateY(-2px);
}

.industry-row.is-open {
  border-color: rgba(150, 56, 79, .30);
  background: #fffaf5;
  box-shadow: 0 22px 52px rgba(64, 45, 37, .075);
}

.industry-row__trigger {
  width: 100%;
  min-height: 74px;
  padding: 16px 17px;
  border: 0;
  background: transparent;
  color: var(--ink);
  cursor: pointer;
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr) 26px;
  gap: 12px;
  align-items: center;
  text-align: left;
}

.industry-row__no {
  color: #a5988e;
  font: 800 8px/1 var(--body);
  letter-spacing: .12em;
}

.industry-row__trigger h3 {
  margin: 0;
  color: var(--ink);
  font: 560 clamp(17px, 1.35vw, 21px)/1.05 var(--display);
  letter-spacing: -.035em;
  text-wrap: balance;
}

.industry-row.is-open .industry-row__trigger h3 {
  color: #6e233b;
}

.industry-row__toggle {
  width: 26px;
  height: 26px;
  border: 1px solid rgba(39, 30, 25, .12);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #756960;
  font: 500 16px/1 var(--body);
  transition: background .25s ease, color .25s ease, border-color .25s ease, transform .25s ease;
}

.industry-row.is-open .industry-row__toggle {
  border-color: #7f2844;
  background: #7f2844;
  color: #fff;
  transform: rotate(180deg);
}

.industry-row__reveal {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition: grid-template-rows .34s cubic-bezier(.2,.75,.25,1), opacity .26s ease;
}

.industry-row.is-open .industry-row__reveal {
  grid-template-rows: 1fr;
  opacity: 1;
}

.industry-row__reveal-inner {
  min-height: 0;
  overflow: hidden;
  margin: 0 17px;
  border-top: 1px solid rgba(39, 30, 25, .09);
  padding: 0 0 0;
  transition: padding .34s cubic-bezier(.2,.75,.25,1);
}

.industry-row.is-open .industry-row__reveal-inner {
  padding: 15px 0 18px;
}

.industry-row__reveal-inner > span {
  display: block;
  margin-bottom: 9px;
  color: #9b3152;
  font: 800 7px/1 var(--body);
  letter-spacing: .13em;
}

.industry-row__reveal-inner p {
  margin: 0;
  color: #5f5750;
  font-size: 11px;
  line-height: 1.62;
}

.industry-row__reveal-inner a {
  width: fit-content;
  margin-top: 14px;
  color: var(--ink);
  text-decoration: none;
  display: inline-flex;
  gap: 7px;
  align-items: center;
  font-size: 9px;
  font-weight: 800;
  border-bottom: 1px solid rgba(39, 30, 25, .24);
  padding-bottom: 3px;
}

.industry-row__reveal-inner a:hover {
  color: #7f2844;
  border-bottom-color: #7f2844;
}

@media (max-width: 1020px) {
  .industries-layout--interactive {
    grid-template-columns: 1fr;
    gap: 42px;
  }
  .industries-copy--interactive { position: static; }
  .industries-copy--interactive h2 { max-width: 820px; }
}

@media (max-width: 720px) {
  .industries--interactive { padding: 90px 0 96px; }
  .industries-copy--interactive h2 { font-size: 42px !important; }
  .industry-accordion { grid-template-columns: 1fr; }
  .industry-row__trigger { min-height: 68px; padding: 15px; }
  .industry-row__trigger h3 { font-size: 18px !important; }
  .industry-row__reveal-inner { margin: 0 15px; }
}

@media (prefers-reduced-motion: reduce) {
  .industry-row,
  .industry-row__toggle,
  .industry-row__reveal,
  .industry-row__reveal-inner { transition: none !important; }
}

/* =========================================================
   V66 — Dla kogo: dark interactive industry atlas
   ========================================================= */
.industries--atlas {
  position: relative;
  overflow: hidden;
  padding: 118px 0 124px;
  background:
    radial-gradient(circle at 82% 28%, rgba(168, 54, 89, .14), transparent 24%),
    radial-gradient(circle at 8% 85%, rgba(217, 130, 89, .07), transparent 27%),
    #151210;
  color: #fff;
  isolation: isolate;
}

.industries--atlas::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  opacity: .17;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 100%);
}

.industries-atlas-shell { position: relative; z-index: 1; }

.industries-atlas-head {
  display: grid;
  grid-template-columns: minmax(130px, .28fr) minmax(0, 1fr);
  gap: clamp(34px, 5vw, 78px);
  align-items: start;
  margin-bottom: 54px;
}

.industries--atlas .eyebrow {
  margin-top: 9px;
  color: rgba(255,255,255,.42);
}

.industries-atlas-head__copy {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(230px, .42fr);
  gap: clamp(36px, 5vw, 76px);
  align-items: end;
}

.industries-atlas-head__copy h2 {
  max-width: 920px;
  margin: 0;
  color: #f7f2ed;
  font: 520 clamp(38px, 4vw, 62px)/.96 var(--display);
  letter-spacing: -.055em;
  text-wrap: balance;
}

.industries-atlas-head__copy p {
  max-width: 360px;
  margin: 0 0 5px;
  color: rgba(255,255,255,.5);
  font-size: 12px;
  line-height: 1.72;
}

.industries-atlas-grid {
  display: grid;
  grid-template-columns: minmax(520px, 1.08fr) minmax(380px, .92fr);
  gap: clamp(36px, 5vw, 74px);
  align-items: start;
}

.industry-index {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 34px;
  border-top: 1px solid rgba(255,255,255,.11);
}

.industry-index__item {
  position: relative;
  width: 100%;
  min-height: 58px;
  padding: 0 8px 0 0;
  border: 0;
  border-bottom: 1px solid rgba(255,255,255,.09);
  background: transparent;
  color: rgba(255,255,255,.68);
  cursor: pointer;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) 20px;
  gap: 9px;
  align-items: center;
  text-align: left;
  transition: color .24s ease, padding-left .28s cubic-bezier(.2,.8,.2,1), background .24s ease;
}

.industry-index__item::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 0;
  height: 1px;
  background: linear-gradient(90deg, #bc4669, #e2a071);
  transition: width .38s cubic-bezier(.2,.8,.2,1);
}

.industry-index__item:hover,
.industry-index__item:focus-visible,
.industry-index__item.is-active {
  color: #fff;
  padding-left: 8px;
}

.industry-index__item:hover::before,
.industry-index__item:focus-visible::before,
.industry-index__item.is-active::before { width: 100%; }

.industry-index__item:focus-visible { outline: none; background: rgba(255,255,255,.025); }

.industry-index__no {
  color: rgba(255,255,255,.28);
  font: 800 8px/1 var(--body);
  letter-spacing: .14em;
  transition: color .24s ease;
}

.industry-index__item.is-active .industry-index__no { color: #e28ba4; }

.industry-index__name {
  font: 540 clamp(15px, 1.2vw, 18px)/1.12 var(--display);
  letter-spacing: -.025em;
}

.industry-index__arrow {
  color: rgba(255,255,255,.18);
  font-size: 13px;
  transform: translate(-5px, 5px);
  opacity: 0;
  transition: opacity .22s ease, transform .28s ease, color .22s ease;
}

.industry-index__item:hover .industry-index__arrow,
.industry-index__item:focus-visible .industry-index__arrow,
.industry-index__item.is-active .industry-index__arrow {
  opacity: 1;
  transform: translate(0, 0);
  color: #e28ba4;
}

.industry-lens {
  position: sticky;
  top: 112px;
  overflow: hidden;
  min-height: 432px;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 24px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.018) 55%, rgba(255,255,255,.035)),
    rgba(25,20,18,.76);
  box-shadow: 0 30px 90px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.04);
  backdrop-filter: blur(16px);
}

.industry-lens::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(115deg, transparent 0 44%, rgba(255,255,255,.025) 50%, transparent 56%);
  transform: translateX(-120%);
  animation: industrySheen 8s ease-in-out infinite;
}

.industry-lens__visual {
  position: absolute;
  width: 310px;
  height: 310px;
  right: -78px;
  top: -102px;
  opacity: .68;
  pointer-events: none;
}

.industry-lens__orbit,
.industry-lens__pulse,
.industry-lens__axis {
  position: absolute;
  display: block;
}

.industry-lens__orbit {
  left: 50%;
  top: 50%;
  border: 1px solid rgba(225,139,164,.20);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.industry-lens__orbit--one { width: 90px; height: 90px; }
.industry-lens__orbit--two { width: 174px; height: 174px; }
.industry-lens__orbit--three { width: 262px; height: 262px; border-color: rgba(225,139,164,.10); }

.industry-lens__pulse {
  left: 50%;
  top: 50%;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #d45a7d;
  box-shadow: 0 0 0 10px rgba(212,90,125,.08), 0 0 34px rgba(212,90,125,.45);
  transform: translate(-50%, -50%);
  animation: industryPulse 2.4s ease-in-out infinite;
}

.industry-lens__axis--x { left: 22px; right: 22px; top: 50%; height: 1px; background: rgba(255,255,255,.05); }
.industry-lens__axis--y { top: 22px; bottom: 22px; left: 50%; width: 1px; background: rgba(255,255,255,.05); }

.industry-lens__topline {
  position: relative;
  z-index: 2;
  min-height: 52px;
  padding: 0 22px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: rgba(255,255,255,.34);
  font: 800 8px/1 var(--body);
  letter-spacing: .13em;
}

.industry-lens__topline b { color: rgba(255,255,255,.62); font-weight: 800; }

.industry-lens__content {
  position: relative;
  z-index: 2;
  padding: 34px 30px 30px;
  animation: industryReveal .42s cubic-bezier(.2,.75,.2,1) both;
}

.industry-lens__content h3 {
  max-width: 430px;
  margin: 0 0 30px;
  color: #fff;
  font: 540 clamp(28px, 3vw, 42px)/.98 var(--display);
  letter-spacing: -.045em;
  text-wrap: balance;
}

.industry-lens__label {
  margin-bottom: 10px;
  color: #dd809c;
  font: 800 8px/1 var(--body);
  letter-spacing: .13em;
}

.industry-lens__content > p {
  max-width: 510px;
  min-height: 66px;
  margin: 0;
  color: rgba(255,255,255,.68);
  font-size: 13px;
  line-height: 1.65;
}

.industry-lens__route {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 25px;
  border-top: 1px solid rgba(255,255,255,.08);
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.industry-lens__route span {
  min-width: 0;
  padding: 14px 12px 14px 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.industry-lens__route span + span {
  padding-left: 12px;
  border-left: 1px solid rgba(255,255,255,.08);
}

.industry-lens__route i {
  color: rgba(255,255,255,.26);
  font: 800 7px/1 var(--body);
  letter-spacing: .12em;
}

.industry-lens__route b {
  overflow: hidden;
  color: rgba(255,255,255,.84);
  font-size: 10px;
  font-weight: 650;
  line-height: 1.2;
  text-overflow: ellipsis;
}

.industry-lens__cta {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: 24px;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(255,255,255,.34);
  color: #fff;
  text-decoration: none;
  font-size: 10px;
  font-weight: 800;
  transition: color .22s ease, border-color .22s ease, gap .22s ease;
}

.industry-lens__cta:hover { color: #ef9ab2; border-bottom-color: #ef9ab2; gap: 13px; }

.industries-atlas-foot {
  margin-top: 34px;
  padding-top: 18px;
  border-top: 1px solid rgba(255,255,255,.08);
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  color: rgba(255,255,255,.38);
  font-size: 10px;
}

.industries-atlas-foot a {
  color: #fff;
  text-decoration: none;
  font-weight: 750;
}

@keyframes industryReveal {
  from { opacity: 0; transform: translateY(10px); filter: blur(3px); }
  to { opacity: 1; transform: translateY(0); filter: blur(0); }
}

@keyframes industryPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(.88); opacity: .75; }
  50% { transform: translate(-50%, -50%) scale(1.14); opacity: 1; }
}

@keyframes industrySheen {
  0%, 72% { transform: translateX(-120%); opacity: 0; }
  78% { opacity: 1; }
  92%, 100% { transform: translateX(120%); opacity: 0; }
}

@media (max-width: 1080px) {
  .industries-atlas-head,
  .industries-atlas-head__copy,
  .industries-atlas-grid { grid-template-columns: 1fr; }
  .industries-atlas-head__copy { gap: 18px; }
  .industries-atlas-head__copy p { max-width: 620px; }
  .industry-lens { position: relative; top: auto; }
}

@media (max-width: 720px) {
  .industries--atlas { padding: 88px 0 92px; }
  .industries-atlas-head { gap: 18px; margin-bottom: 36px; }
  .industries-atlas-head__copy h2 { font-size: 40px !important; }
  .industry-index { grid-template-columns: 1fr; }
  .industry-index__item { min-height: 54px; }
  .industry-index__name { font-size: 16px; }
  .industry-lens { min-height: 0; border-radius: 18px; }
  .industry-lens__content { padding: 28px 20px 24px; }
  .industry-lens__content h3 { font-size: 32px !important; }
  .industry-lens__route b { font-size: 9px; }
  .industries-atlas-foot { justify-content: flex-start; flex-wrap: wrap; }
}

@media (prefers-reduced-motion: reduce) {
  .industry-index__item,
  .industry-index__item::before,
  .industry-index__arrow,
  .industry-lens__content,
  .industry-lens::after,
  .industry-lens__pulse { transition: none !important; animation: none !important; }
}

/* =========================================================
   V67 — OFFER PRICE ALIGNMENT
   Align the active offer price with the product heading on desktop.
   ========================================================= */
@media (min-width: 821px) {
  .offer-focus-title {
    align-items: start !important;
  }

  .offer-focus-title > strong {
    align-self: start !important;
    margin-top: 2px !important;
  }
}

/* =========================================================
   V70 — OFFER / QUESTION-FIRST INTERACTIVE SELECTOR
   Isolated from previous offer layouts.
   ========================================================= */
.offer-v70 {
  position: relative;
  overflow: hidden;
  padding: 138px 0 126px;
  background:
    radial-gradient(circle at 88% 13%, rgba(224, 55, 99, .10), transparent 25%),
    linear-gradient(180deg, #f4efe8 0%, #eee7df 100%);
  color: #171310;
}

.offer-v70::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .34;
  background-image: linear-gradient(135deg, rgba(80, 57, 45, .055) 1px, transparent 1px);
  background-size: 44px 44px;
}

.offer-v70 .section-shell { position: relative; z-index: 1; }

.offer-v70-head {
  display: grid;
  grid-template-columns: .34fr 1.66fr;
  gap: 56px;
  align-items: start;
  margin-bottom: 58px;
}

.offer-v70-head .eyebrow { color: #9d725f; }

.offer-v70-head h2 {
  max-width: 970px;
  margin: 0;
  font: 520 clamp(52px, 5.6vw, 84px)/.92 var(--display);
  letter-spacing: -.062em;
}

.offer-v70-head p {
  max-width: 650px;
  margin: 22px 0 0;
  color: #6c625b;
  font-size: 17px;
  line-height: 1.65;
}

.offer-v70-question-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  color: #8b786c;
  font-size: 10px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: .13em;
}

.offer-v70-question-label small {
  color: #b32c59;
  font: 800 10px/1 var(--sans);
  letter-spacing: .12em;
}

.offer-v70-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid rgba(61, 49, 41, .15);
  border-bottom: 1px solid rgba(61, 49, 41, .15);
  margin-bottom: 18px;
}

.offer-v70-nav__item {
  appearance: none;
  position: relative;
  min-height: 142px;
  padding: 22px 18px 20px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-template-rows: auto 1fr;
  gap: 9px 14px;
  text-align: left;
  border: 0;
  border-right: 1px solid rgba(61, 49, 41, .12);
  background: rgba(255,255,255,.08);
  color: #675e58;
  cursor: pointer;
  transition: background .32s ease, color .32s ease, transform .32s ease;
}

.offer-v70-nav__item:last-child { border-right: 0; }

.offer-v70-nav__item::after {
  content: '';
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: -1px;
  height: 2px;
  transform: scaleX(0);
  transform-origin: left;
  background: linear-gradient(90deg, #ee806e, #d91f5f);
  transition: transform .35s ease;
}

.offer-v70-nav__item:hover { background: rgba(255,255,255,.46); color: #171310; }

.offer-v70-nav__item.is-active {
  background: #1a1515;
  color: #fff;
  transform: translateY(-5px);
  box-shadow: 0 18px 38px rgba(42, 28, 24, .13);
}

.offer-v70-nav__item.is-active::after { transform: scaleX(1); }

.offer-v70-nav__no {
  grid-row: 1 / span 2;
  color: #b29483;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .1em;
}

.offer-v70-nav__item.is-active .offer-v70-nav__no { color: #ef8ca6; }

.offer-v70-nav__copy { display: grid; gap: 9px; }
.offer-v70-nav__copy b {
  color: inherit;
  font-size: 10px;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: .10em;
  text-transform: uppercase;
}
.offer-v70-nav__copy strong {
  max-width: 18ch;
  color: inherit;
  font: 620 17px/1.15 var(--display);
  letter-spacing: -.025em;
}
.offer-v70-nav__price {
  align-self: start;
  color: #ad315a;
  font-size: 14px;
  font-weight: 800;
  white-space: nowrap;
}
.offer-v70-nav__item.is-active .offer-v70-nav__price { color: #ff789c; }
.offer-v70-nav__item > i {
  grid-column: 3;
  grid-row: 2;
  align-self: end;
  justify-self: end;
  font-style: normal;
  opacity: .45;
  transition: transform .25s ease, opacity .25s ease;
}
.offer-v70-nav__item:hover > i,
.offer-v70-nav__item.is-active > i { transform: translate(2px, -2px); opacity: 1; }

.offer-v70-panel {
  position: relative;
  overflow: hidden;
  min-height: 690px;
  padding: 38px 42px 36px;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 30px;
  background:
    linear-gradient(130deg, rgba(255,255,255,.025), transparent 28%),
    #171313;
  color: #fff;
  box-shadow: 0 45px 110px rgba(39, 24, 20, .20);
  animation: offerV70Reveal .42s cubic-bezier(.2,.7,.2,1) both;
}

.offer-v70-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .11;
  background-image:
    linear-gradient(rgba(255,255,255,.10) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.10) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: linear-gradient(180deg, rgba(0,0,0,.75), transparent 72%);
}

.offer-v70-panel__glow {
  position: absolute;
  width: 520px;
  height: 520px;
  right: -180px;
  top: -240px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(211, 41, 92, .25), rgba(196, 52, 77, .06) 46%, transparent 70%);
  filter: blur(2px);
  pointer-events: none;
  animation: offerV70Glow 8s ease-in-out infinite alternate;
}

.offer-v70-panel__topline,
.offer-v70-panel__hero,
.offer-v70-choose-if,
.offer-v70-details,
.offer-v70-result { position: relative; z-index: 1; }

.offer-v70-panel__topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(255,255,255,.12);
  color: #f18baa;
  font-size: 10px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: .13em;
}

.offer-v70-panel__topline b {
  padding: 8px 11px;
  border: 1px solid rgba(249, 102, 143, .28);
  border-radius: 999px;
  background: rgba(226, 51, 101, .13);
  font-size: 9px;
  letter-spacing: .08em;
}

.offer-v70-panel__hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 48px;
  align-items: start;
  padding: 42px 0 34px;
}

.offer-v70-panel__intro h3 {
  max-width: 840px;
  margin: 0;
  color: #fff;
  font: 540 clamp(46px, 5vw, 78px)/.92 var(--display);
  letter-spacing: -.058em;
}

.offer-v70-panel__intro p {
  max-width: 770px;
  margin: 22px 0 0;
  color: rgba(255,255,255,.66);
  font-size: 16px;
  line-height: 1.7;
}

.offer-v70-panel__price {
  padding-top: 2px;
  color: #ff7098;
  font: 560 clamp(44px, 4.7vw, 72px)/.88 var(--display);
  letter-spacing: -.055em;
  white-space: nowrap;
}

.offer-v70-choose-if {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 28px;
  align-items: start;
  padding: 22px 0;
  border-top: 1px solid rgba(255,255,255,.12);
  border-bottom: 1px solid rgba(255,255,255,.12);
}

.offer-v70-choose-if span,
.offer-v70-audience > span,
.offer-v70-includes > span,
.offer-v70-result span {
  color: #f18baa;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;
}

.offer-v70-choose-if p {
  max-width: 820px;
  margin: 0;
  color: rgba(255,255,255,.92);
  font-size: 17px;
  line-height: 1.55;
  font-weight: 620;
}

.offer-v70-details {
  display: grid;
  grid-template-columns: .82fr 1.18fr;
  gap: 0;
  margin-top: 0;
}

.offer-v70-audience,
.offer-v70-includes {
  padding: 30px 0 28px;
}

.offer-v70-audience {
  padding-right: 38px;
  border-right: 1px solid rgba(255,255,255,.12);
}

.offer-v70-audience p {
  max-width: 520px;
  margin: 16px 0 0;
  color: rgba(255,255,255,.68);
  font-size: 15px;
  line-height: 1.7;
}

.offer-v70-includes { padding-left: 38px; }

.offer-v70-includes__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 22px;
  margin-top: 14px;
}

.offer-v70-includes__item {
  min-height: 54px;
  display: grid;
  grid-template-columns: 28px 1fr;
  gap: 10px;
  align-items: center;
  border-bottom: 1px solid rgba(255,255,255,.09);
}

.offer-v70-includes__item i {
  color: #bd8f80;
  font-style: normal;
  font-size: 8px;
  letter-spacing: .08em;
}

.offer-v70-includes__item strong {
  color: rgba(255,255,255,.87);
  font-size: 12px;
  line-height: 1.35;
  font-weight: 650;
}

.offer-v70-result {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 32px;
  align-items: center;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,.12);
}

.offer-v70-result > div { display: grid; gap: 9px; }
.offer-v70-result > div strong {
  max-width: 780px;
  color: #fff;
  font: 560 20px/1.35 var(--display);
  letter-spacing: -.02em;
}

.offer-v70-cta {
  min-height: 54px;
  padding: 0 20px;
  display: inline-flex;
  align-items: center;
  gap: 20px;
  border-radius: 999px;
  background: linear-gradient(100deg, #ef796d, #d82862);
  color: #fff;
  text-decoration: none;
  font-size: 13px;
  font-weight: 800;
  box-shadow: 0 12px 30px rgba(214, 39, 95, .20);
  transition: transform .25s ease, box-shadow .25s ease;
}

.offer-v70-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 36px rgba(214, 39, 95, .28);
}

.offer-v70-after {
  margin-top: 22px;
  padding: 34px 38px;
  display: grid;
  grid-template-columns: .95fr 1.05fr;
  gap: 52px;
  align-items: end;
  border: 1px solid rgba(66, 49, 39, .13);
  border-radius: 26px;
  background: rgba(255,255,255,.58);
  backdrop-filter: blur(14px);
}

.offer-v70-after__copy .eyebrow { color: #a56a59; }
.offer-v70-after__copy h3 {
  max-width: 620px;
  margin: 14px 0 16px;
  font: 560 clamp(34px, 3.5vw, 54px)/.96 var(--display);
  letter-spacing: -.045em;
}
.offer-v70-after__copy h3 span { color: #bb2a59; }
.offer-v70-after__copy p {
  max-width: 650px;
  margin: 0;
  color: #645b54;
  font-size: 15px;
  line-height: 1.65;
}
.offer-v70-after__copy > strong {
  display: block;
  margin-top: 18px;
  color: #2e2824;
  font-size: 13px;
  line-height: 1.5;
}

.offer-v70-after__route {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  border-top: 1px solid rgba(60, 43, 35, .18);
}
.offer-v70-after__route::before {
  content: '';
  position: absolute;
  left: 0;
  top: -1px;
  width: 25%;
  height: 1px;
  background: linear-gradient(90deg, #ef796d, #d82862);
  animation: offerV70Route 5.2s ease-in-out infinite alternate;
}
.offer-v70-after__route div {
  min-height: 96px;
  padding: 18px 14px 0;
  display: grid;
  align-content: start;
  gap: 14px;
  border-right: 1px solid rgba(60, 43, 35, .12);
  transition: background .25s ease, transform .25s ease;
}
.offer-v70-after__route div:last-child { border-right: 0; }
.offer-v70-after__route div:hover { background: rgba(255,255,255,.62); transform: translateY(-3px); }
.offer-v70-after__route i {
  color: #ad8e7d;
  font-style: normal;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .1em;
}
.offer-v70-after__route span {
  color: #332d29;
  font-size: 12px;
  font-weight: 760;
}
.offer-v70-after__route .is-accent span { color: #b82856; }

@keyframes offerV70Reveal {
  from { opacity: 0; transform: translateY(12px) scale(.995); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes offerV70Glow {
  from { transform: translate3d(-12px, 6px, 0) scale(.96); opacity: .72; }
  to { transform: translate3d(18px, 20px, 0) scale(1.08); opacity: 1; }
}

@keyframes offerV70Route {
  from { transform: translateX(0); }
  to { transform: translateX(300%); }
}

@media (max-width: 1100px) {
  .offer-v70-head { grid-template-columns: 1fr; gap: 20px; }
  .offer-v70-nav { grid-template-columns: repeat(2, 1fr); }
  .offer-v70-nav__item:nth-child(2) { border-right: 0; }
  .offer-v70-nav__item:nth-child(-n+2) { border-bottom: 1px solid rgba(61,49,41,.12); }
  .offer-v70-panel__hero { grid-template-columns: 1fr; gap: 22px; }
  .offer-v70-panel__price { grid-row: 1; }
  .offer-v70-details { grid-template-columns: 1fr; }
  .offer-v70-audience { padding-right: 0; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.12); }
  .offer-v70-includes { padding-left: 0; }
  .offer-v70-after { grid-template-columns: 1fr; gap: 30px; }
}

@media (max-width: 720px) {
  .offer-v70 { padding: 88px 0 82px; }
  .offer-v70-head { margin-bottom: 38px; }
  .offer-v70-head h2 { font-size: 43px; }
  .offer-v70-head p { font-size: 15px; }
  .offer-v70-nav { grid-template-columns: 1fr; }
  .offer-v70-nav__item,
  .offer-v70-nav__item:nth-child(2) { border-right: 0; border-bottom: 1px solid rgba(61,49,41,.12); }
  .offer-v70-nav__item:last-child { border-bottom: 0; }
  .offer-v70-nav__item { min-height: 112px; }
  .offer-v70-panel { min-height: 0; padding: 26px 20px 24px; border-radius: 22px; }
  .offer-v70-panel__hero { padding: 30px 0 25px; }
  .offer-v70-panel__intro h3 { font-size: 43px; }
  .offer-v70-panel__intro p { font-size: 15px; }
  .offer-v70-panel__price { font-size: 48px; }
  .offer-v70-choose-if { grid-template-columns: 1fr; gap: 10px; }
  .offer-v70-includes__grid { grid-template-columns: 1fr; }
  .offer-v70-result { grid-template-columns: 1fr; }
  .offer-v70-cta { justify-content: space-between; }
  .offer-v70-after { padding: 28px 20px; border-radius: 20px; }
  .offer-v70-after__copy h3 { font-size: 38px; }
  .offer-v70-after__route { grid-template-columns: repeat(2, 1fr); }
  .offer-v70-after__route div:nth-child(2) { border-right: 0; }
  .offer-v70-after__route div:nth-child(-n+2) { border-bottom: 1px solid rgba(60,43,35,.12); }
}

@media (prefers-reduced-motion: reduce) {
  .offer-v70-panel,
  .offer-v70-panel__glow,
  .offer-v70-after__route::before,
  .offer-v70-nav__item,
  .offer-v70-nav__item::after,
  .offer-v70-cta { animation: none !important; transition: none !important; }
}

/* =========================================================
   V71 — stronger product-name hierarchy in Offer
   Scope: Offer section only
   ========================================================= */

/* Product names in the 4-option selector should read as headings,
   while the question below becomes supporting copy. */
.offer-v70-nav__copy {
  gap: 8px;
}

.offer-v70-nav__copy b {
  color: inherit;
  font: 650 clamp(18px, 1.35vw, 22px)/1.02 var(--display) !important;
  letter-spacing: -.035em !important;
  text-transform: none !important;
}

.offer-v70-nav__copy strong {
  max-width: 21ch;
  font: 520 14px/1.28 var(--body) !important;
  letter-spacing: -.012em !important;
  opacity: .76;
}

.offer-v70-nav__price {
  font-size: 17px !important;
  line-height: 1;
}

/* The selected product name inside the large detail panel is also
   a real heading instead of tiny metadata. */
.offer-v70-panel__topline {
  padding-bottom: 26px;
}

.offer-v70-panel__topline > span {
  font: 650 clamp(18px, 1.45vw, 23px)/1 var(--display) !important;
  letter-spacing: -.028em !important;
  text-transform: none;
}

.offer-v70-panel__topline b {
  font-size: 10px;
}

@media (max-width: 760px) {
  .offer-v70-nav__copy b {
    font-size: 20px !important;
  }

  .offer-v70-nav__copy strong {
    font-size: 13px !important;
  }

  .offer-v70-panel__topline > span {
    font-size: 20px !important;
  }
}


.work-card--featured .work-preview > img {
  object-fit: cover;
  object-position: center center;
}

@media (max-width: 760px) {
  .work-card--featured .work-preview {
    min-height: 0;
    aspect-ratio: 16 / 9;
  }
}


/* V76 — CostWarden: real screenshot placed inside the existing light browser mock */
.work-card--featured .work-preview {
  min-height: 560px;
  padding: 34px 42px 42px;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at 78% 22%, rgba(76,61,255,.16), transparent 32%),
    radial-gradient(circle at 88% 76%, rgba(26,224,205,.11), transparent 30%),
    #151210;
}

.browser-mock--costwarden {
  width: min(1240px, 94%);
  margin: 0 auto;
  transform: rotate(-.55deg);
  border-color: rgba(255,255,255,.22);
  border-radius: 19px 19px 9px 9px;
  background: #f4f0e9;
  box-shadow:
    0 34px 90px rgba(0,0,0,.34),
    0 0 0 1px rgba(255,255,255,.035);
}

.browser-bar--costwarden {
  height: 42px;
  padding: 0 15px;
  background: #ebe5dd;
}

.browser-bar--costwarden i {
  width: 7px;
  height: 7px;
}

.browser-bar--costwarden span {
  font-size: 8px;
  color: #82786f;
}

.browser-page--costwarden {
  min-height: 0 !important;
  padding: 0 !important;
  overflow: hidden;
  background: #080913;
}

.browser-page--costwarden > img {
  position: static !important;
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  object-position: center top;
}

@media (max-width: 1050px) {
  .work-card--featured .work-preview {
    min-height: 0;
    padding: 26px;
  }

  .browser-mock--costwarden {
    width: 96%;
  }
}

@media (max-width: 760px) {
  .work-card--featured .work-preview {
    padding: 16px 12px 20px;
  }

  .browser-mock--costwarden {
    width: 100%;
    transform: none;
    border-radius: 12px 12px 7px 7px;
  }

  .browser-bar--costwarden {
    height: 30px;
  }
}
