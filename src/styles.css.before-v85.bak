  z-index: 2;
  max-width: 12ch !important;
  margin: 0;
  font-size: clamp(64px, 5vw, 90px) !important;
  line-height: .92 !important;
  letter-spacing: -.072em;
}

.strategy-story-card--hero .hero-title-line {
  color: #fffaf6;
  text-shadow: 0 3px 26px rgba(0,0,0,.18);
}

.strategy-story-card--hero .hero-title-line--accent {
  background: linear-gradient(135deg, #f0a07f 0%, #e46a75 54%, #bb315c 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.strategy-story-card--hero .hero-lead {
  position: relative;
  z-index: 2;
  max-width: 35ch;
  margin-top: 22px;
