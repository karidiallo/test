:root {
  --paper: #f1eee8;
  --paper-2: #faf8f4;
  --ink: #121110;
  --ink-2: #1a1816;
  --ink-3: #27231f;
  --muted: #746e67;
  --line: rgba(18, 17, 16, 0.13);
  --light-line: rgba(255,255,255,.12);
  --coral: #df765f;
  --wine: #a52e55;
  --pink: #c84468;
  --champagne: #bc9276;
  --accent: linear-gradient(120deg, #df8c69 0%, #c84468 58%, #932448 100%);
  --display: "Inter Tight", ui-sans-serif, system-ui, sans-serif;
  --body: "Manrope", ui-sans-serif, system-ui, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--paper); }
body { margin: 0; font-family: var(--body); color: var(--ink); background: var(--paper); -webkit-font-smoothing: antialiased; }
a { color: inherit; }
button, input { font: inherit; }
button { color: inherit; }
::selection { background: #c84468; color: white; }

.header {
  position: fixed; z-index: 60; top: 18px; left: 50%; transform: translateX(-50%);
  width: min(1380px, calc(100% - 36px)); height: 68px; padding: 0 12px 0 18px;
  display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 26px;
  background: rgba(250,248,244,.72); border: 1px solid rgba(24,20,17,.11); border-radius: 18px;
  backdrop-filter: blur(18px); box-shadow: 0 14px 42px rgba(38,31,26,.08);
}
.header nav { justify-self: center; display: flex; gap: 30px; }
.header nav a { text-decoration: none; font: 600 12px/1 var(--body); color: #4f4944; }
.header-cta { text-decoration: none; min-height: 44px; padding: 0 15px; border-radius: 12px; display: inline-flex; align-items: center; gap: 12px; background: var(--ink); color: #fff; font-size: 11px; font-weight: 650; }

.brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); }
.brand-mark { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
.brand-mark circle { fill: var(--pink); stroke: none; }
.brand-mark .brand-route { stroke: var(--pink); stroke-width: 2; }
.brand-word { font: 700 19px/1 var(--body); letter-spacing: -.065em; }
.brand-word span { color: var(--pink); }
.brand--inverted { color: white; }

.story { position: relative; min-height: 400vh; background: var(--paper); overflow: clip; }
.story-canvas-wrap { position: sticky; top: 0; height: 100vh; z-index: 0; }
.story-steps { position: relative; z-index: 2; margin-top: -100vh; pointer-events: none; }
.story-step { min-height: 100vh; width: min(1440px, calc(100% - 48px)); margin: auto; padding: 120px 0 52px; display: flex; align-items: center; }
.step-copy { pointer-events: auto; width: min(610px, 45vw); }
.step-copy--hero { width: min(730px, 50vw); }
.step-copy--right { margin-left: auto; }
.eyebrow { font: 700 10px/1 var(--body); letter-spacing: .17em; text-transform: uppercase; color: #6f6760; }
.step-copy h1 { margin: 20px 0 0; font: 520 clamp(56px, 6vw, 98px)/.88 var(--display); letter-spacing: -.065em; max-width: 850px; }
.step-copy h1 span, .accent-text { background: var(--accent); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero-lead { margin: 28px 0 0; max-width: 650px; font-size: 16px; line-height: 1.72; color: #5f5953; }
.hero-lead b { color: #1f1c19; font-weight: 600; }
.hero-actions { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
.button { min-height: 52px; padding: 0 18px; border-radius: 13px; display: inline-flex; align-items: center; justify-content: center; gap: 12px; text-decoration: none; font-size: 11px; font-weight: 700; transition: transform .25s ease, box-shadow .25s ease; }
.button:hover { transform: translateY(-2px); }
.button--dark { background: var(--ink); color: #fff; box-shadow: 0 16px 36px rgba(18,17,16,.14); }
.button--ghost { border: 1px solid var(--line); background: rgba(255,255,255,.35); }
.micro-proof { margin-top: 24px; display: flex; gap: 0; flex-wrap: wrap; color: #777068; font-size: 10px; }
.micro-proof span { padding: 0 11px; border-right: 1px solid var(--line); }
.micro-proof span:first-child { padding-left: 0; }
.micro-proof span:last-child { border-right: 0; }

.step-copy--panel { padding: 30px; border: 1px solid rgba(24,20,17,.11); border-radius: 24px; background: rgba(250,248,244,.79); backdrop-filter: blur(18px); box-shadow: 0 24px 70px rgba(53,43,35,.10); }
.step-copy--panel h2 { margin: 16px 0 16px; font: 520 clamp(42px, 4.5vw, 70px)/.94 var(--display); letter-spacing: -.055em; }
.step-copy--panel p { margin: 0; color: #655e57; font-size: 14px; line-height: 1.72; }
.symptom-mini-list { margin-top: 24px; display: grid; border-top: 1px solid var(--line); }
.symptom-mini-list button { cursor: pointer; border: 0; border-bottom: 1px solid var(--line); background: transparent; padding: 15px 0; display: flex; justify-content: space-between; text-align: left; font: 600 13px/1.2 var(--body); }
.symptom-mini-list button:hover { color: var(--wine); }
.signal-line { margin-top: 24px; display: flex; align-items: center; gap: 9px; flex-wrap: wrap; font-size: 10px; font-weight: 750; letter-spacing: .12em; color: var(--wine); }
.signal-line i { width: 9px; height: 9px; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 8px rgba(200,68,104,.11); }
.signal-line span { margin-left: auto; color: #756d66; font-weight: 600; letter-spacing: 0; }
.text-link { display: inline-flex; gap: 10px; margin-top: 24px; font-weight: 700; font-size: 12px; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 3px; }

.living-map { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(ellipse at 70% 48%, rgba(255,255,255,.98) 0, rgba(242,237,230,.88) 34%, var(--paper) 68%); }
.living-map canvas { position: relative; z-index: 1; }
.living-map-fallback { position: absolute; width: min(920px, 62vw); aspect-ratio: 1.7; right: -4vw; top: 50%; transform: translateY(-45%) rotate(-4deg); border-radius: 48% 52% 46% 54%; background: radial-gradient(circle at 40% 30%, #fff 0 10%, #e5ddd4 38%, #c9beb3 72%, transparent 73%); filter: blur(.2px); opacity: .18; }
.map-ui-status { position: absolute; z-index: 3; right: 28px; bottom: 28px; display: flex; align-items: center; gap: 8px; font: 700 9px/1 var(--body); letter-spacing: .14em; color: #81776f; }
.map-ui-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 6px rgba(200,68,104,.10); }
.map-ui-corner { position: absolute; z-index: 2; width: 58px; height: 58px; opacity: .45; }
.map-ui-corner--tl { top: 110px; right: 32px; border-top: 1px solid #81776f; border-right: 1px solid #81776f; }
.map-ui-corner--br { right: 32px; bottom: 52px; border-bottom: 1px solid #81776f; border-left: 1px solid #81776f; }
.map-label { white-space: nowrap; padding: 7px 9px; border-radius: 8px; background: rgba(250,248,244,.78); border: 1px solid rgba(30,25,21,.1); backdrop-filter: blur(8px); color: #5d554f; font: 750 8px/1 var(--body); letter-spacing: .12em; }

.section { padding: 150px 0; }
.section-shell { width: min(1320px, calc(100% - 48px)); margin: auto; }
.section--dark { background: #12100f; color: #fff; }
.section--paper { background: var(--paper-2); }
.section--ink { background: #181412; color: white; }
.section-heading--split { display: grid; grid-template-columns: .38fr 1.62fr; gap: 52px; align-items: start; margin-bottom: 70px; }
.section--dark .eyebrow, .section--ink .eyebrow { color: rgba(255,255,255,.54); }
.section-heading h2 { margin: 0; max-width: 980px; font: 520 clamp(50px, 5.7vw, 86px)/.91 var(--display); letter-spacing: -.06em; }
.section-heading p { max-width: 620px; margin: 22px 0 0; line-height: 1.75; font-size: 14px; color: #756d66; }
.section--dark .section-heading p, .section--ink .section-heading p { color: rgba(255,255,255,.57); }

.diagnosis-ui { display: grid; grid-template-columns: 205px 1fr; min-height: 720px; border: 1px solid rgba(255,255,255,.11); border-radius: 28px; overflow: hidden; background: #1a1715; box-shadow: 0 42px 110px rgba(0,0,0,.34); }
.diagnosis-rail { padding: 28px 20px; background: #0f0e0d; display: flex; flex-direction: column; }
.diagnosis-rail .brand-word { font-size: 16px; }
.diagnosis-rail .brand-mark { width: 30px; height: 30px; }
.rail-nav { margin-top: 60px; display: grid; gap: 4px; }
.rail-nav button { border: 0; padding: 11px 12px; border-radius: 9px; background: transparent; color: rgba(255,255,255,.38); text-align: left; font-size: 10px; cursor: default; }
.rail-nav button.active { background: rgba(255,255,255,.07); color: white; }
.diagnosis-rail small { margin-top: auto; color: rgba(255,255,255,.26); font-size: 8px; letter-spacing: .12em; }
.diagnosis-main { padding: 34px 42px 40px; display: flex; flex-direction: column; }
.diagnosis-top { display: flex; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid var(--light-line); color: rgba(255,255,255,.34); font-size: 9px; letter-spacing: .13em; }
.diagnosis-top b { color: #f0a2b5; }
.priority-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; padding: 55px 0 46px; }
.priority-no { color: #f0a2b5; font: 750 9px/1 var(--body); letter-spacing: .14em; }
.priority-copy h3 { margin: 18px 0 18px; max-width: 560px; font: 520 clamp(38px, 4vw, 62px)/.94 var(--display); letter-spacing: -.055em; }
.priority-copy p { max-width: 520px; color: rgba(255,255,255,.57); font-size: 13px; line-height: 1.72; }
.evidence-stack { border-top: 1px solid var(--light-line); }
.evidence-row { display: grid; grid-template-columns: 100px 1fr; gap: 22px; padding: 18px 0; border-bottom: 1px solid var(--light-line); }
.evidence-row span { color: rgba(255,255,255,.37); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }
.evidence-row strong { font: 520 16px/1.35 var(--display); }
.decision-tabs { display: flex; gap: 7px; flex-wrap: wrap; padding-top: 22px; border-top: 1px solid var(--light-line); }
.decision-tabs button { border: 1px solid var(--light-line); border-radius: 999px; padding: 9px 11px; background: transparent; color: rgba(255,255,255,.46); font: 700 8px/1 var(--body); letter-spacing: .1em; cursor: pointer; }
.decision-tabs button.active { background: #fff; color: #171411; }
.decision-output { margin-top: 16px; padding: 20px; border: 1px solid var(--light-line); border-radius: 18px; background: rgba(255,255,255,.035); display: flex; justify-content: space-between; align-items: center; gap: 24px; }
.decision-output div { display: grid; gap: 8px; }
.decision-output span { color: #f0a2b5; font-size: 8px; letter-spacing: .13em; font-weight: 800; }
.decision-output strong { max-width: 720px; font: 540 16px/1.45 var(--display); }
.decision-output a { flex: none; min-height: 44px; padding: 0 14px; border-radius: 11px; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; background: var(--accent); color: white; font-size: 10px; font-weight: 700; }

.principle { padding: 150px 0; background: var(--paper); }
.principle-inner { width: min(1260px, calc(100% - 48px)); margin: auto; }
.principle h2 { margin: 26px 0 72px; max-width: 1100px; font: 520 clamp(58px, 7vw, 108px)/.88 var(--display); letter-spacing: -.068em; }
.principle h2 span { color: #8b8178; }
.principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); }
.principle-grid p { margin: 0; padding: 28px 28px 0 0; border-right: 1px solid var(--line); font-size: 14px; line-height: 1.7; color: #625b55; }
.principle-grid p + p { padding-left: 28px; }
.principle-grid p:last-child { border-right: 0; font-weight: 600; color: #28231f; }

.evidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.evidence-grid article { min-height: 245px; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.evidence-grid article > span { font: 750 9px/1 var(--body); letter-spacing: .12em; color: var(--wine); }
.evidence-grid h3 { margin: 60px 0 12px; font: 520 32px/1 var(--display); letter-spacing: -.045em; }
.evidence-grid p { margin: 0; color: #716960; font-size: 12px; line-height: 1.65; max-width: 32ch; }

.offer-grid { display: grid; grid-template-columns: .92fr 1.16fr .92fr; gap: 18px; align-items: stretch; }
.offer-card { min-height: 480px; padding: 26px; border: 1px solid rgba(255,255,255,.10); border-radius: 22px; background: rgba(255,255,255,.025); display: flex; flex-direction: column; position: relative; overflow: hidden; }
.offer-card::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: rgba(255,255,255,.12); }
.offer-card--featured { min-height: 530px; background: radial-gradient(650px 300px at 50% 0%, rgba(200,68,104,.18), transparent 63%), #201719; border-color: rgba(238,162,181,.20); box-shadow: 0 28px 80px rgba(0,0,0,.22); transform: translateY(-12px); }
.offer-card--featured::before { height: 4px; background: var(--accent); }
.offer-top { display: flex; align-items: center; justify-content: space-between; color: rgba(255,255,255,.42); font-size: 9px; letter-spacing: .13em; }
.offer-top b { padding: 8px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.11); color: #f4c0cd; font-size: 8px; }
.offer-card h3 { margin: 54px 0 14px; font: 520 clamp(36px, 3.4vw, 52px)/.94 var(--display); letter-spacing: -.052em; }
.offer-card p { margin: 0; color: rgba(255,255,255,.58); font-size: 13px; line-height: 1.7; }
.offer-price { margin-top: auto; padding-top: 48px; font: 560 clamp(42px, 4.5vw, 66px)/.9 var(--display); letter-spacing: -.055em; color: #ff9db7; }
.offer-card a { margin-top: 24px; min-height: 48px; padding: 0 14px; border-radius: 11px; background: #fff; color: #171311; text-decoration: none; display: flex; align-items: center; justify-content: space-between; font-size: 10px; font-weight: 750; }
.offer-card--featured a { background: var(--accent); color: white; }
.special-paths { margin-top: 20px; text-align: center; color: rgba(255,255,255,.43); font-size: 10px; }
.special-paths span { color: #f0a2b5; }

.scan { padding: 145px 0; background: #f0ece6; }
.scan-shell { width: min(1260px, calc(100% - 48px)); margin: auto; display: grid; grid-template-columns: .95fr 1.05fr; gap: 80px; align-items: center; }
.scan-copy h2 { margin: 20px 0 20px; max-width: 630px; font: 520 clamp(50px, 5.5vw, 84px)/.91 var(--display); letter-spacing: -.06em; }
.scan-copy p { max-width: 570px; margin: 0; color: #6a635d; line-height: 1.72; font-size: 13px; }
.scan-steps { margin-top: 36px; display: flex; gap: 7px; flex-wrap: wrap; }
.scan-steps span { padding: 8px 10px; border: 1px solid var(--line); border-radius: 999px; color: #9a9188; font-size: 8px; letter-spacing: .1em; }
.scan-steps span.active { color: var(--wine); border-color: rgba(165,46,85,.25); background: rgba(200,68,104,.055); }
.scan-card { min-height: 470px; padding: 34px; border: 1px solid rgba(24,20,17,.10); border-radius: 26px; background: var(--paper-2); box-shadow: 0 30px 90px rgba(61,50,42,.12); display: flex; flex-direction: column; }
.form-kicker { color: var(--wine); font: 750 9px/1 var(--body); letter-spacing: .15em; }
.scan-card h3 { margin: 24px 0 42px; font: 520 clamp(34px, 3.4vw, 50px)/.96 var(--display); letter-spacing: -.052em; }
.scan-card label { margin: auto 0 8px; color: #81786f; font-size: 9px; letter-spacing: .11em; text-transform: uppercase; font-weight: 750; }
.scan-card input { width: 100%; height: 62px; border: 0; border-bottom: 1px solid #bcb3aa; outline: none; background: transparent; font: 520 26px/1 var(--display); letter-spacing: -.03em; color: #171411; }
.scan-card input:focus { border-bottom-color: var(--wine); }
.scan-card button[type="submit"], .form-success button { margin-top: 24px; min-height: 54px; border: 0; border-radius: 13px; padding: 0 17px; background: var(--ink); color: white; display: flex; align-items: center; justify-content: space-between; cursor: pointer; font-size: 11px; font-weight: 750; }
.scan-card small { margin-top: 13px; color: #9b938a; font-size: 9px; line-height: 1.5; }
.form-options { display: grid; gap: 8px; margin-top: auto; }
.form-options button { min-height: 54px; padding: 0 14px; border: 1px solid var(--line); border-radius: 11px; background: transparent; text-align: left; cursor: pointer; font-size: 12px; font-weight: 650; }
.form-options button:hover, .form-options button.active { border-color: rgba(165,46,85,.3); background: rgba(200,68,104,.06); color: var(--wine); }
.domain-confirm { margin: auto 0 14px; padding: 14px; border: 1px solid var(--line); border-radius: 12px; display: flex; justify-content: space-between; gap: 14px; }
.domain-confirm span { font-weight: 650; }
.domain-confirm b { color: var(--wine); font-size: 10px; }
.form-success { margin: auto 0; text-align: center; }
.form-success > span { display: grid; place-items: center; margin: auto; width: 52px; height: 52px; border-radius: 50%; background: var(--accent); color: white; font-size: 20px; }
.form-success h3 { margin-bottom: 14px; }
.form-success p { color: #6e665f; font-size: 13px; line-height: 1.7; }
.form-success button { width: 100%; justify-content: center; }

footer { min-height: 170px; padding: 42px max(24px, calc((100% - 1260px)/2)); display: grid; grid-template-columns: 1fr auto auto; align-items: end; gap: 32px; background: #0d0c0b; color: white; }
footer p { margin: 0; color: rgba(255,255,255,.48); font-size: 11px; }
footer > span { color: rgba(255,255,255,.27); font-size: 9px; }

@media (max-width: 1050px) {
  .header nav { display: none; }
  .header { grid-template-columns: 1fr auto; }
  .story-step { width: calc(100% - 36px); }
  .step-copy, .step-copy--hero { width: min(640px, 60vw); }
  .section-heading--split { grid-template-columns: 1fr; gap: 22px; }
  .diagnosis-ui { grid-template-columns: 160px 1fr; }
  .priority-layout { grid-template-columns: 1fr; gap: 34px; }
  .offer-grid { grid-template-columns: 1fr; }
  .offer-card--featured { transform: none; }
  .scan-shell { grid-template-columns: 1fr; gap: 48px; }
}

@media (max-width: 760px) {
  .header { top: 10px; width: calc(100% - 18px); height: 60px; border-radius: 15px; padding-left: 12px; }
  .header-cta { min-height: 40px; font-size: 10px; }
  .brand-word { font-size: 17px; }
  .brand-mark { width: 30px; height: 30px; }
  .story { min-height: 400vh; }
  .story-step { width: calc(100% - 24px); padding-top: 88px; align-items: flex-end; padding-bottom: 44px; }
  .step-copy, .step-copy--hero { width: 100%; }
  .step-copy--hero { padding: 22px; border: 1px solid rgba(24,20,17,.10); border-radius: 22px; background: rgba(250,248,244,.80); backdrop-filter: blur(16px); }
  .step-copy h1 { font-size: clamp(48px, 13.7vw, 67px); }
  .hero-lead { font-size: 13px; }
  .hero-actions { display: grid; }
  .button { width: 100%; }
  .step-copy--panel { padding: 22px; }
  .step-copy--panel h2 { font-size: 43px; }
  .living-map { background: radial-gradient(ellipse at 60% 35%, #fff 0, #eee8e0 42%, var(--paper) 72%); }
  .living-map canvas { opacity: .75; transform: translateY(-8%); }
  .map-ui-corner { display: none; }
  .map-ui-status { bottom: 16px; right: 16px; }
  .section { padding: 96px 0; }
  .section-shell, .principle-inner, .scan-shell { width: calc(100% - 28px); }
  .section-heading h2 { font-size: 49px; }
  .diagnosis-ui { grid-template-columns: 1fr; min-height: auto; border-radius: 20px; }
  .diagnosis-rail { display: none; }
  .diagnosis-main { padding: 24px 18px; }
  .priority-layout { padding: 36px 0 30px; }
  .priority-copy h3 { font-size: 39px; }
  .evidence-row { grid-template-columns: 78px 1fr; }
  .decision-output { align-items: stretch; flex-direction: column; }
  .decision-output a { justify-content: space-between; }
  .principle { padding: 96px 0; }
  .principle h2 { font-size: 56px; margin-bottom: 48px; }
  .principle-grid { grid-template-columns: 1fr; }
  .principle-grid p, .principle-grid p + p { padding: 20px 0; border-right: 0; border-bottom: 1px solid var(--line); }
  .evidence-grid { grid-template-columns: 1fr; }
  .evidence-grid article { min-height: 190px; }
  .evidence-grid h3 { margin-top: 40px; }
  .offer-card { min-height: 400px; }
  .scan { padding: 96px 0; }
  .scan-card { min-height: 430px; padding: 24px 20px; }
  .scan-card h3 { font-size: 39px; }
  footer { grid-template-columns: 1fr; align-items: start; gap: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

/* --- Trust layer: selected work + team --- */
.work { padding: 150px 0; background: #e9e4dd; border-top: 1px solid var(--line); }
.work-heading { margin-bottom: 72px; }
.work-heading p { max-width: 690px; }
.work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.work-card { border: 1px solid rgba(18,17,16,.12); border-radius: 26px; overflow: hidden; background: rgba(250,248,244,.78); box-shadow: 0 18px 55px rgba(50,42,35,.055); }
.work-card--featured { grid-column: 1 / -1; }
.work-preview { position: relative; min-height: 340px; padding: 28px; overflow: hidden; background: #1a1715; }
.work-card--featured .work-preview { min-height: 500px; }
.work-preview::after { content: ""; position: absolute; inset: auto -12% -42% 32%; height: 75%; background: radial-gradient(circle, rgba(200,68,104,.26), transparent 67%); pointer-events: none; }
.work-preview > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.work-status { position: absolute; z-index: 3; top: 18px; right: 18px; padding: 8px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.15); background: rgba(15,13,12,.54); backdrop-filter: blur(12px); color: rgba(255,255,255,.78); font: 750 8px/1 var(--body); letter-spacing: .12em; }
.browser-mock { position: relative; z-index: 2; width: min(820px, 92%); margin: 26px auto 0; border: 1px solid rgba(255,255,255,.16); border-radius: 17px 17px 6px 6px; overflow: hidden; background: #f7f4ef; box-shadow: 0 38px 90px rgba(0,0,0,.30); transform: rotate(-1.3deg); }
.work-card:nth-child(even) .browser-mock { transform: rotate(1.4deg); }
.browser-bar { height: 38px; padding: 0 12px; display: flex; align-items: center; gap: 6px; background: #e6e0d9; border-bottom: 1px solid rgba(18,17,16,.10); }
.browser-bar i { width: 6px; height: 6px; border-radius: 50%; background: #b4aba3; }
.browser-bar span { margin-left: 7px; color: #8d847c; font-size: 7px; letter-spacing: .07em; }
.browser-page { min-height: 310px; padding: 62px 9% 44px; color: #171411; background: radial-gradient(circle at 84% 16%, rgba(200,68,104,.13), transparent 30%), #f8f6f2; }
.work-card--featured .browser-page { min-height: 430px; padding-top: 88px; }
.browser-kicker { margin-bottom: 16px; color: var(--wine); font: 750 8px/1 var(--body); letter-spacing: .14em; text-transform: uppercase; }
.browser-page strong { display: block; max-width: 8ch; font: 520 clamp(42px, 6vw, 82px)/.88 var(--display); letter-spacing: -.06em; }
.browser-lines { margin-top: 30px; display: grid; gap: 7px; max-width: 290px; }
.browser-lines i { display: block; height: 4px; border-radius: 99px; background: #d6d0c9; }
.browser-lines i:nth-child(2) { width: 83%; }
.browser-lines i:nth-child(3) { width: 62%; }
.browser-cta { margin-top: 26px; width: 96px; height: 30px; border-radius: 8px; background: var(--ink); }
.work-meta { padding: 28px; display: grid; grid-template-columns: 42px 1fr auto; gap: 24px; align-items: start; }
.work-index { color: var(--wine); font: 750 9px/1 var(--body); letter-spacing: .13em; padding-top: 5px; }
.work-type { color: #7f766e; font: 750 8px/1 var(--body); letter-spacing: .13em; text-transform: uppercase; }
.work-copy h3 { margin: 12px 0 9px; font: 540 clamp(32px, 3vw, 46px)/.95 var(--display); letter-spacing: -.048em; }
.work-copy p { max-width: 640px; margin: 0; color: #6e665f; font-size: 12px; line-height: 1.7; }
.work-scope { margin-top: 17px; color: #8c827a; font-size: 9px; line-height: 1.5; }
.work-link { align-self: end; min-width: 112px; display: inline-flex; justify-content: space-between; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 9px; font-weight: 750; }
.work-link--muted { color: #aaa198; }

.team { padding: 150px 0; background: var(--paper-2); border-top: 1px solid var(--line); }
.team-heading { display: grid; grid-template-columns: .48fr 1.52fr; gap: 56px; align-items: start; margin-bottom: 72px; }
.team-heading h2 { margin: 0; max-width: 900px; font: 520 clamp(52px, 5.7vw, 86px)/.9 var(--display); letter-spacing: -.062em; }
.team-heading p { max-width: 720px; margin: 26px 0 0; color: #6d655e; font-size: 13px; line-height: 1.75; }
.team-members { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
.team-member { grid-column: span 3; min-width: 0; overflow: hidden; border-radius: 24px; border: 1px solid rgba(18,17,16,.11); background: rgba(250,248,244,.74); box-shadow: 0 18px 55px rgba(50,42,35,.045); }
.team-member--featured { grid-column: span 6; display: grid; grid-template-columns: .92fr 1.08fr; background: #171412; color: white; }
.team-member-portrait { position: relative; min-height: 320px; display: grid; place-items: center; overflow: hidden; background: radial-gradient(circle at 56% 34%, rgba(223,118,95,.26), transparent 28%), radial-gradient(circle at 66% 70%, rgba(165,46,85,.28), transparent 36%), #211b19; }
.team-member:not(.team-member--featured) .team-member-portrait { min-height: 250px; background: radial-gradient(circle at 55% 38%, rgba(190,148,119,.24), transparent 30%), #e4ddd4; }
.team-member-portrait::before { content: ""; position: absolute; width: 230px; height: 230px; border: 1px solid rgba(255,255,255,.11); border-radius: 50%; }
.team-member:not(.team-member--featured) .team-member-portrait::before { border-color: rgba(18,17,16,.08); }
.team-member-portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.team-member-portrait > span { position: relative; z-index: 1; font: 500 88px/.8 var(--display); letter-spacing: -.08em; color: rgba(255,255,255,.92); }
.team-member:not(.team-member--featured) .team-member-portrait > span { color: rgba(18,17,16,.78); }
.team-member-number { position: absolute; z-index: 2; top: 18px; left: 18px; font-size: 8px; font-weight: 800; letter-spacing: .14em; color: rgba(255,255,255,.52); }
.team-member:not(.team-member--featured) .team-member-number { color: var(--wine); }
.team-member-info { padding: 26px; }
.team-member--featured .team-member-info { display: flex; flex-direction: column; justify-content: flex-end; padding: 34px; border-left: 1px solid rgba(255,255,255,.08); }
.team-member-role { color: var(--wine); font-size: 8px; line-height: 1.2; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
.team-member--featured .team-member-role { color: #e69aaf; }
.team-member-info h3 { margin: 14px 0 10px; font: 540 34px/.96 var(--display); letter-spacing: -.045em; }
.team-member--featured .team-member-info h3 { font-size: clamp(44px, 4vw, 66px); }
.team-member-info p { margin: 0; color: #776e67; font-size: 10px; line-height: 1.65; }
.team-member--featured .team-member-info p { max-width: 470px; color: rgba(255,255,255,.55); font-size: 11px; }
.team-trustline { margin-top: 28px; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.team-trustline span { padding: 18px 22px; color: #756d66; font-size: 9px; line-height: 1.5; border-right: 1px solid var(--line); }
.team-trustline span:last-child { border-right: 0; }

@media (max-width: 1050px) {
  .work-grid { grid-template-columns: 1fr; }
  .work-card--featured { grid-column: auto; }
  .work-card--featured .work-preview, .work-preview { min-height: 390px; }
  .team-heading { grid-template-columns: 1fr; gap: 22px; }
  .team-member { grid-column: span 6; }
  .team-member--featured { grid-column: 1 / -1; }
  .team-trustline { grid-template-columns: 1fr; }
  .team-trustline span { border-right: 0; border-bottom: 1px solid var(--line); }
  .team-trustline span:last-child { border-bottom: 0; }
}

@media (max-width: 760px) {
  .work, .team { padding: 96px 0; }
  .work-heading { margin-bottom: 42px; }
  .work-preview, .work-card--featured .work-preview { min-height: 290px; padding: 16px; }
  .browser-mock { width: 96%; margin-top: 35px; }
  .browser-page, .work-card--featured .browser-page { min-height: 240px; padding: 48px 8% 34px; }
  .browser-page strong { font-size: 46px; }
  .work-meta { grid-template-columns: 28px 1fr; gap: 14px; padding: 22px; }
  .work-link { grid-column: 2; justify-self: stretch; }
  .team-heading h2 { font-size: 52px; }
  .team-members { grid-template-columns: 1fr; }
  .team-member, .team-member--featured { grid-column: auto; display: block; }
  .team-member-portrait, .team-member:not(.team-member--featured) .team-member-portrait { min-height: 300px; }
  .team-member--featured .team-member-info { border-left: 0; border-top: 1px solid rgba(255,255,255,.08); }
}

/* --- V5: process, method, extended offer, SEO/trust footer --- */
.process-section { padding: 150px 0; background: #0f0e0d; color: #fff; }
.process-layout { display: grid; grid-template-columns: .78fr 1.22fr; gap: 100px; align-items: start; }
.process-intro { position: sticky; top: 128px; }
.process-intro .eyebrow { color: rgba(255,255,255,.56); }
.process-intro h2 { margin: 22px 0 22px; max-width: 650px; font: 520 clamp(56px, 6vw, 92px)/.9 var(--display); letter-spacing: -.064em; }
.process-intro p { max-width: 540px; margin: 0; color: rgba(255,255,255,.58); font-size: 13px; line-height: 1.75; }
.process-timeline { position: relative; padding-left: 72px; }
.process-timeline::before { content: ""; position: absolute; left: 12px; top: 14px; bottom: 18px; width: 1px; background: linear-gradient(to bottom, rgba(223,118,95,.8), rgba(165,46,85,.25)); }
.process-step { position: relative; min-height: 190px; padding: 0 0 52px; border-bottom: 1px solid rgba(255,255,255,.08); }
.process-step + .process-step { padding-top: 46px; }
.process-step:last-child { border-bottom: 0; padding-bottom: 0; }
.process-dot { position: absolute; left: -66px; top: 7px; width: 10px; height: 10px; border-radius: 50%; background: #d46a83; box-shadow: 0 0 0 9px rgba(212,106,131,.10); }
.process-step + .process-step .process-dot { top: 53px; }
.process-no { display: block; margin-bottom: 15px; color: #e597aa; font: 750 9px/1 var(--body); letter-spacing: .14em; }
.process-step h3 { margin: 0; font: 520 clamp(38px, 4vw, 58px)/.96 var(--display); letter-spacing: -.055em; }
.process-step p { max-width: 600px; margin: 12px 0 0; color: rgba(255,255,255,.45); font-size: 12px; line-height: 1.65; }

.method { padding: 150px 0; background: #0f0e0d; color: #fff; border-top: 1px solid rgba(255,255,255,.06); }
.method-shell { display: grid; grid-template-columns: 1.2fr .8fr; gap: 28px; align-items: stretch; }
.method-main, .method-aside { border: 1px solid rgba(255,255,255,.11); border-radius: 28px; background: #151311; }
.method-main { padding: 46px; }
.method-main .eyebrow { color: rgba(255,255,255,.55); }
.method-main h2 { margin: 22px 0 26px; max-width: 920px; font: 520 clamp(56px, 5.6vw, 86px)/.9 var(--display); letter-spacing: -.063em; }
.method-script { display: inline; font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 400; color: #db7992; letter-spacing: -.045em; }
.method-lead { max-width: 820px; margin: 0 0 32px; color: rgba(255,255,255,.62); font-size: 13px; line-height: 1.8; }
.tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
.tool-card { padding: 16px 18px; border: 1px solid rgba(255,255,255,.09); border-radius: 14px; background: rgba(255,255,255,.025); }
.tool-card > div { display: grid; grid-template-columns: 46px 1fr; gap: 10px; align-items: center; }
.tool-card span { color: #e69aaf; font: 800 8px/1 var(--body); letter-spacing: .08em; }
.tool-card strong { font-size: 10px; }
.tool-card p { display: none; margin: 10px 0 0 56px; color: rgba(255,255,255,.42); font-size: 9px; line-height: 1.55; }
.tool-card:hover p { display: block; }
.method-flow { margin-top: 20px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.10); display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.method-flow span, .method-flow b { padding: 10px 13px; border: 1px solid rgba(255,255,255,.12); border-radius: 999px; font-size: 8px; font-weight: 700; }
.method-flow b { border-color: transparent; background: #8f2149; }
.method-flow i { color: rgba(255,255,255,.34); font-style: normal; }
.method-note { margin: 18px 0 0; color: rgba(255,255,255,.43); font-size: 10px; line-height: 1.65; }
.human-review { margin-top: 22px; padding: 18px; border: 1px solid rgba(255,255,255,.10); border-radius: 16px; background: rgba(255,255,255,.025); display: grid; grid-template-columns: 52px 1fr; gap: 16px; }
.human-mark { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 13px; background: rgba(223,118,95,.12); }
.human-mark i { width: 12px; height: 12px; border-radius: 50%; background: #e17892; box-shadow: 0 0 0 10px rgba(225,120,146,.10); }
.human-review span { display: block; margin-bottom: 5px; color: #df7992; font: 800 8px/1 var(--body); letter-spacing: .13em; }
.human-review strong { display: block; font-size: 12px; }
.human-review p { margin: 7px 0 0; color: rgba(255,255,255,.42); font-size: 9px; line-height: 1.55; }
.method-aside { padding: 38px 28px; overflow: hidden; background: radial-gradient(circle at 100% 0%, rgba(200,68,104,.10), transparent 38%), #151311; }
.aside-kicker { color: #e597aa; font: 800 9px/1 var(--body); letter-spacing: .14em; }
.method-aside h3 { margin: 18px 0 34px; font: 520 clamp(40px, 4vw, 62px)/.93 var(--display); letter-spacing: -.055em; }
.method-aside h3 span { color: #8d827a; }
.method-checks { display: grid; gap: 14px; }
.method-checks > div { min-height: 132px; padding: 18px; border: 1px solid rgba(255,255,255,.08); border-radius: 16px; background: rgba(255,255,255,.018); }
.method-checks b { display: inline-flex; min-width: 42px; padding: 7px 9px; border-radius: 9px; background: rgba(200,68,104,.10); color: #e393a7; font-size: 8px; }
.method-checks strong { display: block; margin-top: 18px; font: 520 25px/1 var(--display); letter-spacing: -.035em; }
.method-checks p { margin: 8px 0 0; color: rgba(255,255,255,.40); font-size: 9px; }

.offer-grid--five { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: stretch; }
.offer-grid--five .offer-card { grid-column: span 4; min-height: 430px; }
.offer-grid--five .offer-card--featured { grid-column: span 4; min-height: 470px; }
.offer-grid--five .offer-card:nth-child(4), .offer-grid--five .offer-card:nth-child(5) { grid-column: span 6; min-height: 390px; }
.offer-details { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.08); color: rgba(255,255,255,.40); font-size: 9px; line-height: 1.6; }

.site-footer { min-height: 0; padding: 86px max(24px, calc((100% - 1320px)/2)) 28px; display: block; background: #0a0908; color: #fff; }
.footer-grid { display: grid; grid-template-columns: minmax(290px, 1.65fr) repeat(4, minmax(140px, .72fr)); gap: 44px; align-items: start; }
.footer-brand .brand { margin-bottom: 26px; }
.footer-brand p { max-width: 430px; margin: 0; color: rgba(255,255,255,.48); font-size: 11px; line-height: 1.75; }
.footer-brand > span { display: block; margin-top: 26px; color: rgba(255,255,255,.25); font-size: 9px; }
.footer-column { display: grid; align-content: start; gap: 11px; }
.footer-column h3 { margin: 0 0 11px; color: rgba(255,255,255,.34); font: 800 8px/1 var(--body); letter-spacing: .14em; text-transform: uppercase; }
.footer-column a, .footer-column > span { width: fit-content; color: rgba(255,255,255,.70); text-decoration: none; font-size: 10px; line-height: 1.45; }
.footer-column a:hover { color: #fff; }
.footer-formal > span { color: rgba(255,255,255,.42); }
.footer-formal small { margin-top: 8px; max-width: 180px; color: rgba(255,255,255,.22); font-size: 8px; line-height: 1.5; }
.footer-bottom { margin-top: 68px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.08); display: flex; justify-content: space-between; gap: 24px; color: rgba(255,255,255,.28); font-size: 9px; }
.footer-bottom a { color: rgba(255,255,255,.58); text-decoration: none; }

@media (max-width: 1050px) {
  .process-layout { grid-template-columns: 1fr; gap: 64px; }
  .process-intro { position: static; }
  .method-shell { grid-template-columns: 1fr; }
  .offer-grid--five { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .offer-grid--five .offer-card, .offer-grid--five .offer-card--featured, .offer-grid--five .offer-card:nth-child(4), .offer-grid--five .offer-card:nth-child(5) { grid-column: auto; transform: none; }
  .offer-grid--five .offer-card:last-child { grid-column: 1 / -1; }
  .footer-grid { grid-template-columns: 1.5fr repeat(2, 1fr); }
  .footer-brand { grid-row: span 2; }
}

@media (max-width: 760px) {
  .process-section, .method { padding: 96px 0; }
  .process-layout { gap: 48px; }
  .process-intro h2, .method-main h2 { font-size: 52px; }
  .process-timeline { padding-left: 42px; }
  .process-timeline::before { left: 7px; }
  .process-dot { left: -39px; }
  .process-step { min-height: 0; padding-bottom: 36px; }
  .process-step + .process-step { padding-top: 34px; }
  .process-step + .process-step .process-dot { top: 41px; }
  .process-step h3 { font-size: 38px; }
  .method-main, .method-aside { padding: 24px 20px; border-radius: 20px; }
  .tool-grid { grid-template-columns: 1fr; }
  .tool-card p { display: block; margin-left: 0; }
  .method-flow { gap: 7px; }
  .human-review { grid-template-columns: 42px 1fr; padding: 14px; }
  .human-mark { width: 42px; height: 42px; }
  .offer-grid--five { grid-template-columns: 1fr; }
  .offer-grid--five .offer-card:last-child { grid-column: auto; }
  .site-footer { padding: 68px 18px 24px; }
  .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 24px; }
  .footer-brand { grid-column: 1 / -1; grid-row: auto; }
  .footer-bottom { margin-top: 46px; flex-direction: column; }
}

/* =========================================================
   V6 — premium rhythm, interactive diagnosis, modern method,
   audience fit, offer chooser and stronger lead form
   ========================================================= */

textarea { font: inherit; }

/* 01 — hero / story refinements */
.step-copy--panel h2 .accent-text { display: inline; }
.symptom-mini-list button { transition: color .2s ease, padding-left .2s ease; }
.symptom-mini-list button:hover { padding-left: 8px; }
.living-map { background: radial-gradient(ellipse at 70% 48%, rgba(255,255,255,.98) 0, rgba(239,234,226,.9) 36%, #ece7df 70%); }
.living-map-fallback { opacity: .09; filter: blur(12px); }
.map-label { background: rgba(246,242,236,.82); border-color: rgba(30,25,21,.12); box-shadow: 0 8px 30px rgba(41,34,29,.06); }

/* 03 — section rhythm */
.process-section { background: #100e0d; }
.sample-section { padding: 150px 0; background: #e9e2d9; color: var(--ink); }
.sample-heading .eyebrow { color: #766e67; }
.sample-heading p { color: #6d655e; }
.principle--dark { background: radial-gradient(circle at 82% 20%, rgba(165,46,85,.13), transparent 31%), #241c1b; color: #fff; }
.principle--dark .eyebrow { color: rgba(255,255,255,.48); }
.principle--dark h2 span { color: #d7899c; }
.principle--dark .principle-grid { border-color: rgba(255,255,255,.11); }
.principle--dark .principle-grid p { color: rgba(255,255,255,.56); border-color: rgba(255,255,255,.1); }
.principle--dark .principle-grid p:last-child { color: rgba(255,255,255,.86); }

/* 04 — interactive sample map */
.diagnosis-ui--interactive { min-height: 760px; background: #151311; border-color: rgba(18,17,16,.18); box-shadow: 0 40px 110px rgba(73,58,47,.18); }
.diagnosis-ui--interactive .diagnosis-rail { background: #0d0c0b; }
.diagnosis-ui--interactive .rail-nav button { cursor: pointer; min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 12px; transition: background .2s ease, color .2s ease, transform .2s ease; }
.diagnosis-ui--interactive .rail-nav button:hover { color: #fff; transform: translateX(3px); }
.diagnosis-ui--interactive .rail-nav button.active { background: linear-gradient(105deg, rgba(200,68,104,.2), rgba(223,118,95,.06)); color: #fff; }
.diagnosis-ui--interactive .rail-nav button > span { font: inherit; }
.diagnosis-ui--interactive .rail-nav button > span + span { font-size: 13px; opacity: .65; }
.diagnosis-ui--interactive .diagnosis-main { min-width: 0; }
.map-view { flex: 1; min-height: 465px; animation: mapViewIn .32s ease both; }
@keyframes mapViewIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.map-view--overview .priority-layout { padding-bottom: 24px; }
.evidence-stack { display: grid; gap: 9px; }
.evidence-row { width: 100%; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: rgba(255,255,255,.025); color: #fff; padding: 16px 16px; display: grid; grid-template-columns: 86px 1fr auto; gap: 14px; text-align: left; cursor: pointer; transition: border-color .22s ease, background .22s ease, transform .22s ease; }
.evidence-row:hover, .evidence-row.active { border-color: rgba(225,120,146,.42); background: rgba(200,68,104,.08); transform: translateX(3px); }
.evidence-row span { color: #e79aaf; font-size: 8px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
.evidence-row strong { font-size: 10px; line-height: 1.45; font-weight: 650; color: rgba(255,255,255,.82); }
.evidence-row i { font-style: normal; color: rgba(255,255,255,.35); }
.evidence-detail { padding: 18px 20px; border-radius: 14px; background: #201b19; border: 1px solid rgba(255,255,255,.08); display: grid; grid-template-columns: 90px 1fr; gap: 18px; }
.evidence-detail span { color: #df7992; font: 800 8px/1 var(--body); letter-spacing: .12em; text-transform: uppercase; }
.evidence-detail p { margin: 0; color: rgba(255,255,255,.56); font-size: 11px; line-height: 1.65; }
.view-intro { padding: 48px 0 28px; max-width: 820px; }
.view-intro > span { color: #e597aa; font: 800 8px/1 var(--body); letter-spacing: .13em; }
.view-intro h3 { margin: 13px 0 10px; font: 520 clamp(38px, 4vw, 58px)/.95 var(--display); letter-spacing: -.052em; }
.view-intro p { max-width: 650px; margin: 0; color: rgba(255,255,255,.5); font-size: 11px; line-height: 1.65; }
.journey-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.journey-stage { min-height: 250px; padding: 18px; border: 1px solid rgba(255,255,255,.09); border-radius: 16px; background: rgba(255,255,255,.025); color: #fff; text-align: left; cursor: pointer; display: flex; flex-direction: column; transition: transform .22s ease, border-color .22s ease, background .22s ease; }
.journey-stage:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.045); }
.journey-stage.critical { border-color: rgba(225,120,146,.42); background: radial-gradient(circle at 70% 0%, rgba(200,68,104,.16), transparent 45%), rgba(200,68,104,.05); }
.journey-stage > span { color: rgba(255,255,255,.3); font-size: 8px; font-weight: 800; letter-spacing: .12em; }
.journey-stage b { margin-top: 30px; font: 520 25px/1 var(--display); letter-spacing: -.04em; }
.journey-stage strong { margin-top: 12px; font: 520 43px/.9 var(--display); color: #f3a0b5; letter-spacing: -.06em; }
.journey-stage em { margin-top: 9px; color: rgba(255,255,255,.52); font-size: 8px; font-style: normal; text-transform: uppercase; letter-spacing: .1em; }
.journey-stage p { margin: auto 0 0; color: rgba(255,255,255,.44); font-size: 9px; line-height: 1.55; }
.evidence-browser { display: grid; grid-template-columns: .42fr 1.58fr; border: 1px solid rgba(255,255,255,.09); border-radius: 18px; overflow: hidden; }
.evidence-browser-nav { padding: 12px; background: #0f0e0d; display: grid; align-content: start; gap: 7px; }
.evidence-browser-nav button { border: 0; border-radius: 11px; padding: 14px; background: transparent; color: rgba(255,255,255,.42); text-align: left; cursor: pointer; display: flex; gap: 12px; font-size: 10px; }
.evidence-browser-nav button span { color: #d98399; font-size: 8px; }
.evidence-browser-nav button:hover, .evidence-browser-nav button.active { color: #fff; background: rgba(255,255,255,.07); }
.evidence-browser-main { padding: 36px; min-height: 250px; display: flex; flex-direction: column; justify-content: center; }
.evidence-browser-main > span { color: #e597aa; font-size: 8px; font-weight: 800; letter-spacing: .12em; }
.evidence-browser-main h4 { margin: 15px 0; max-width: 700px; font: 520 clamp(32px, 3.4vw, 50px)/.95 var(--display); letter-spacing: -.05em; }
.evidence-browser-main p { max-width: 690px; margin: 0; color: rgba(255,255,255,.54); font-size: 11px; line-height: 1.7; }
.plan-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.plan-grid article { min-height: 250px; padding: 18px; border: 1px solid rgba(255,255,255,.09); border-radius: 16px; background: rgba(255,255,255,.025); }
.plan-grid span { color: #e597aa; font-size: 8px; font-weight: 800; }
.plan-grid h4 { margin: 48px 0 10px; font: 520 24px/1 var(--display); letter-spacing: -.04em; }
.plan-grid p { margin: 0; color: rgba(255,255,255,.46); font-size: 9px; line-height: 1.6; }
.diagnosis-ui--interactive .decision-tabs { margin-top: 24px; }

/* 05 — method: no duplicate right column, one modern command center */
.method-v6 { padding: 150px 0; background: #f7f3ed; color: var(--ink); }
.method-v6-head { display: grid; grid-template-columns: .34fr 1.66fr; gap: 58px; margin-bottom: 66px; }
.method-v6-head h2 { margin: 0; max-width: 1020px; font: 520 clamp(54px, 6vw, 92px)/.9 var(--display); letter-spacing: -.064em; }
.method-v6-head p { max-width: 720px; margin: 24px 0 0; color: #6d655e; font-size: 13px; line-height: 1.75; }
.method-command { display: grid; grid-template-columns: .72fr 1.5fr .78fr; gap: 14px; align-items: stretch; }
.method-group-nav { display: grid; align-content: start; gap: 8px; }
.method-group-nav button { min-height: 92px; padding: 17px; border: 1px solid rgba(18,17,16,.11); border-radius: 16px; background: rgba(255,255,255,.34); color: var(--ink); cursor: pointer; display: grid; grid-template-columns: 28px 1fr auto; align-items: center; gap: 12px; text-align: left; transition: transform .22s ease, border-color .22s ease, background .22s ease, box-shadow .22s ease; }
.method-group-nav button:hover { transform: translateX(4px); border-color: rgba(165,46,85,.3); }
.method-group-nav button.active { background: #171412; color: white; border-color: #171412; box-shadow: 0 18px 45px rgba(39,30,25,.12); }
.method-group-nav button > span { color: var(--wine); font-size: 8px; font-weight: 800; }
.method-group-nav button.active > span { color: #e98da6; }
.method-group-nav button strong { font-size: 11px; }
.method-group-nav button i { font-style: normal; opacity: .45; }
.method-stage { min-height: 470px; padding: 30px; border: 1px solid rgba(18,17,16,.11); border-radius: 24px; background: #fffdfa; box-shadow: 0 24px 70px rgba(52,42,34,.06); display: flex; flex-direction: column; }
.method-stage-head > span { color: var(--wine); font: 800 8px/1 var(--body); letter-spacing: .13em; text-transform: uppercase; }
.method-stage-head h3 { margin: 17px 0 30px; max-width: 760px; font: 520 clamp(34px, 3.5vw, 52px)/.96 var(--display); letter-spacing: -.05em; }
.method-tools-live { display: grid; gap: 9px; }
.method-tools-live article { padding: 15px 16px; border: 1px solid rgba(18,17,16,.09); border-radius: 13px; background: #f7f3ed; display: grid; grid-template-columns: 52px 1fr; gap: 13px; align-items: start; transition: transform .2s ease, background .2s ease, border-color .2s ease; }
.method-tools-live article:hover { transform: translateY(-2px); background: #fff; border-color: rgba(165,46,85,.24); }
.method-tools-live article > span { color: var(--wine); font-size: 8px; font-weight: 850; letter-spacing: .08em; }
.method-tools-live strong { display: block; font-size: 10px; }
.method-tools-live p { margin: 5px 0 0; color: #756d66; font-size: 9px; line-height: 1.55; }
.method-pipeline { margin-top: auto; padding-top: 22px; border-top: 1px solid var(--line); display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.method-pipeline span, .method-pipeline b { padding: 9px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 8px; }
.method-pipeline b { border-color: transparent; background: #8f2149; color: #fff; }
.method-pipeline i { color: #9b928a; font-style: normal; }
.human-decision-card { min-height: 470px; padding: 27px; border-radius: 24px; background: radial-gradient(circle at 50% 12%, rgba(225,120,146,.18), transparent 28%), #171412; color: #fff; display: flex; flex-direction: column; overflow: hidden; }
.human-orbit { position: relative; width: 150px; height: 150px; margin: 4px auto 35px; border: 1px solid rgba(255,255,255,.09); border-radius: 50%; }
.human-orbit::before, .human-orbit::after { content: ""; position: absolute; inset: 20px; border: 1px solid rgba(255,255,255,.07); border-radius: 50%; }
.human-orbit::after { inset: 44px; }
.human-orbit i { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: #8a8179; }
.human-orbit i:nth-child(1) { left: 8px; top: 70px; }
.human-orbit i:nth-child(2) { right: 23px; top: 23px; background: #df765f; }
.human-orbit i:nth-child(3) { bottom: 16px; left: 51px; background: #c84468; }
.human-orbit b { position: absolute; inset: 60px; border-radius: 50%; background: #f1a0b4; box-shadow: 0 0 0 10px rgba(225,120,146,.08), 0 0 45px rgba(225,120,146,.3); }
.human-decision-card > span { color: #e898ad; font-size: 8px; font-weight: 800; letter-spacing: .13em; }
.human-decision-card h3 { margin: 13px 0 12px; font: 520 30px/.96 var(--display); letter-spacing: -.045em; }
.human-decision-card p { margin: 0; color: rgba(255,255,255,.5); font-size: 10px; line-height: 1.68; }
.human-decision-foot { margin-top: auto; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.09); display: flex; flex-wrap: wrap; gap: 6px; }
.human-decision-foot span, .human-decision-foot strong { padding: 7px 9px; border-radius: 999px; border: 1px solid rgba(255,255,255,.1); font-size: 7px; }
.human-decision-foot strong { background: #8f2149; border-color: transparent; }

/* 06 — scope cards with real hover response */
.evidence-section { background: #151210; color: #fff; }
.evidence-section .eyebrow { color: rgba(255,255,255,.48); }
.evidence-section .section-heading p { color: rgba(255,255,255,.52); }
.evidence-grid--hover article { position: relative; overflow: hidden; border-color: rgba(255,255,255,.09); background: rgba(255,255,255,.025); transition: transform .28s cubic-bezier(.2,.8,.2,1), border-color .28s ease, background .28s ease, box-shadow .28s ease; }
.evidence-grid--hover article::before { content: ""; position: absolute; width: 220px; height: 220px; right: -90px; top: -110px; border-radius: 50%; background: radial-gradient(circle, rgba(200,68,104,.22), transparent 68%); opacity: 0; transition: opacity .28s ease; }
.evidence-grid--hover article:hover { transform: translateY(-8px); border-color: rgba(225,120,146,.34); background: rgba(255,255,255,.05); box-shadow: 0 28px 60px rgba(0,0,0,.18); }
.evidence-grid--hover article:hover::before { opacity: 1; }
.evidence-grid--hover article > span { color: #e79aaf; }
.evidence-grid--hover article h3 { color: #fff; }
.evidence-grid--hover article p { color: rgba(255,255,255,.48); }
.evidence-arrow { position: absolute; top: 22px; right: 22px; color: rgba(255,255,255,.25); transform: translate(-4px, 4px); transition: transform .28s ease, color .28s ease; }
.evidence-grid--hover article:hover .evidence-arrow { transform: none; color: #ef9aaf; }

/* 08 — industries */
.industries { padding: 150px 0; background: #eee7de; }
.industries-layout { display: grid; grid-template-columns: .76fr 1.24fr; gap: 72px; align-items: start; }
.industries-copy { position: sticky; top: 125px; }
.industries-copy h2 { margin: 22px 0 22px; font: 520 clamp(52px, 5.4vw, 82px)/.91 var(--display); letter-spacing: -.06em; }
.industries-copy p { max-width: 560px; margin: 0; color: #6d655e; font-size: 13px; line-height: 1.75; }
.industry-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.industry-grid article { min-height: 150px; padding: 18px; border: 1px solid rgba(18,17,16,.1); border-radius: 18px; background: rgba(250,248,244,.62); display: flex; flex-direction: column; transition: transform .22s ease, background .22s ease, border-color .22s ease; }
.industry-grid article:hover { transform: translateY(-4px); background: #fffaf5; border-color: rgba(165,46,85,.25); }
.industry-grid span { color: var(--wine); font-size: 8px; font-weight: 800; letter-spacing: .12em; }
.industry-grid h3 { margin: auto 0 8px; font: 520 27px/1 var(--display); letter-spacing: -.04em; }
.industry-grid p { margin: 0; color: #877d74; font-size: 8px; text-transform: uppercase; letter-spacing: .08em; }

/* work now contrasts with industries */
.work { background: #171412; color: #fff; border-top: 0; }
.work .eyebrow { color: rgba(255,255,255,.48); }
.work-heading p { color: rgba(255,255,255,.5); }
.work-card { color: var(--ink); }
.work-card { transition: transform .28s ease, box-shadow .28s ease; }
.work-card:hover { transform: translateY(-6px); box-shadow: 0 28px 80px rgba(0,0,0,.22); }

/* 07 — offer becomes a selector, not a wall of cards */
.offer-v6 { padding: 150px 0; background: radial-gradient(circle at 82% 0%, rgba(165,46,85,.14), transparent 28%), #1a1515; color: #fff; }
.offer-v6-head { display: grid; grid-template-columns: .34fr 1.66fr; gap: 58px; margin-bottom: 66px; }
.offer-v6-head .eyebrow { color: rgba(255,255,255,.45); }
.offer-v6-head h2 { margin: 0; max-width: 980px; font: 520 clamp(54px, 6vw, 92px)/.9 var(--display); letter-spacing: -.064em; }
.offer-v6-head p { max-width: 720px; margin: 24px 0 0; color: rgba(255,255,255,.5); font-size: 13px; line-height: 1.75; }
.offer-chooser { display: grid; grid-template-columns: .68fr 1.32fr; gap: 14px; }
.offer-selector { display: grid; align-content: start; gap: 8px; }
.offer-selector button { min-height: 94px; padding: 15px 16px; border: 1px solid rgba(255,255,255,.09); border-radius: 16px; background: rgba(255,255,255,.025); color: #fff; cursor: pointer; display: grid; grid-template-columns: 30px 1fr auto 18px; align-items: center; gap: 12px; text-align: left; transition: transform .22s ease, border-color .22s ease, background .22s ease; }
.offer-selector button:hover { transform: translateX(4px); border-color: rgba(225,120,146,.32); }
.offer-selector button.active { background: linear-gradient(100deg, rgba(200,68,104,.18), rgba(255,255,255,.04)); border-color: rgba(225,120,146,.34); }
.offer-selector button > span { color: #e392a7; font-size: 8px; font-weight: 850; }
.offer-selector button strong { display: block; font: 520 20px/1 var(--display); letter-spacing: -.035em; }
.offer-selector button small { display: block; margin-top: 5px; color: rgba(255,255,255,.38); font-size: 8px; }
.offer-selector button b { color: rgba(255,255,255,.73); font-size: 10px; }
.offer-selector button i { font-style: normal; color: rgba(255,255,255,.28); }
.offer-focus-card { min-height: 560px; padding: 34px; border: 1px solid rgba(255,255,255,.11); border-radius: 24px; background: #f7f2eb; color: var(--ink); box-shadow: 0 35px 90px rgba(0,0,0,.18); display: flex; flex-direction: column; }
.offer-focus-top { display: flex; justify-content: space-between; gap: 18px; color: var(--wine); font-size: 8px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
.offer-focus-top b { padding: 7px 9px; border-radius: 999px; background: rgba(200,68,104,.09); }
.offer-focus-title { margin: 45px 0 30px; display: grid; grid-template-columns: 1fr auto; gap: 35px; align-items: end; }
.offer-focus-title h3 { margin: 0 0 13px; font: 520 clamp(48px, 5.2vw, 78px)/.9 var(--display); letter-spacing: -.062em; }
.offer-focus-title p { max-width: 620px; margin: 0; color: #6d655e; font-size: 12px; line-height: 1.7; }
.offer-focus-title > strong { color: var(--wine); font: 560 clamp(40px, 4vw, 62px)/.9 var(--display); letter-spacing: -.055em; white-space: nowrap; }
.offer-fit-grid { display: grid; grid-template-columns: 1fr 1.35fr 1.35fr; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.offer-fit-grid > div { padding: 18px 18px 18px 0; border-right: 1px solid var(--line); }
.offer-fit-grid > div + div { padding-left: 18px; }
.offer-fit-grid > div:last-child { border-right: 0; }
.offer-fit-grid span, .offer-includes > span { display: block; margin-bottom: 9px; color: #948b82; font-size: 7px; font-weight: 800; letter-spacing: .12em; }
.offer-fit-grid strong { display: block; font-size: 10px; line-height: 1.55; }
.offer-includes { padding-top: 22px; }
.offer-includes > div { display: flex; flex-wrap: wrap; gap: 7px; }
.offer-includes b { padding: 8px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 8px; font-weight: 650; }
.offer-main-cta { margin-top: auto; min-height: 56px; padding: 0 18px; border-radius: 13px; background: var(--ink); color: #fff; text-decoration: none; display: flex; align-items: center; justify-content: space-between; font-size: 10px; font-weight: 800; }
.offer-help { margin-top: 14px; padding: 18px 20px; border: 1px solid rgba(255,255,255,.09); border-radius: 16px; display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center; }
.offer-help > span { color: #ef9cb1; font-size: 9px; font-weight: 800; }
.offer-help p { margin: 0; color: rgba(255,255,255,.48); font-size: 9px; line-height: 1.55; }
.offer-help a { color: #fff; font-size: 9px; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.25); padding-bottom: 3px; }

/* 09 — form / CTA */
.scan { background: #eee7de; }
.scan-copy h2 .accent-text { display: inline; }
.scan-selected { margin-top: 30px; max-width: 520px; padding: 15px 17px; border: 1px solid var(--line); border-radius: 14px; background: rgba(250,248,244,.55); display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 13px; }
.scan-selected span { color: var(--wine); font-size: 7px; font-weight: 850; letter-spacing: .12em; }
.scan-selected strong { font-size: 10px; }
.scan-selected small { color: #827971; font-size: 9px; }
.scan-card--v6 { min-height: 555px; }
.scan-card--v6 label { margin-top: auto; }
.scan-card--v6 textarea { width: 100%; min-height: 92px; resize: vertical; padding: 13px 0; border: 0; border-bottom: 1px solid #bcb3aa; outline: none; background: transparent; color: var(--ink); font-size: 12px; line-height: 1.55; }
.scan-card--v6 textarea:focus { border-bottom-color: var(--wine); }
.field-help { margin: 12px 0 0; color: #948b82; font-size: 9px; line-height: 1.55; }
.optional-label { margin-top: 18px !important; display: flex; align-items: center; justify-content: space-between; }
.optional-label span { color: #aaa198; text-transform: none; letter-spacing: 0; font-weight: 500; }
.form-options--v6 { display: grid; gap: 8px; }
.form-options--v6 button { min-height: 55px; display: flex; align-items: center; justify-content: space-between; padding: 0 15px; border-radius: 12px; border: 1px solid var(--line); background: transparent; cursor: pointer; text-align: left; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
.form-options--v6 button:hover { transform: translateX(3px); border-color: rgba(165,46,85,.3); background: rgba(200,68,104,.035); }
.form-options--v6 button.active { border-color: rgba(165,46,85,.34); background: rgba(200,68,104,.06); }
.form-options--v6 button span { font-size: 10px; font-weight: 700; }
.form-options--v6 button i { font-style: normal; color: var(--wine); }
.form-back { width: fit-content; margin-top: 16px; padding: 0; border: 0; background: none; color: #81786f; cursor: pointer; font-size: 8px; font-weight: 750; }
.scan-card--v6 button[type="submit"] { width: 100%; min-height: 58px; margin-top: 26px; padding: 0 18px; border-radius: 12px; line-height: 1; }
.domain-confirm { margin: 4px 0 18px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; display: flex; justify-content: space-between; gap: 16px; }
.domain-confirm span { font-size: 10px; font-weight: 700; }
.domain-confirm b { color: var(--wine); font-size: 8px; }

/* responsive V6 */
@media (max-width: 1120px) {
  .journey-grid, .plan-grid { grid-template-columns: repeat(2, 1fr); }
  .method-command { grid-template-columns: .7fr 1.3fr; }
  .human-decision-card { grid-column: 1 / -1; min-height: 380px; }
  .human-orbit { margin-left: 0; }
  .offer-chooser { grid-template-columns: 1fr; }
  .offer-selector { grid-template-columns: repeat(2, 1fr); }
  .offer-selector button { min-height: 86px; }
  .offer-focus-card { min-height: 0; }
  .industries-layout { grid-template-columns: 1fr; }
  .industries-copy { position: static; }
}

@media (max-width: 760px) {
  .sample-section, .method-v6, .industries, .offer-v6 { padding: 96px 0; }
  .method-v6-head, .offer-v6-head { grid-template-columns: 1fr; gap: 22px; margin-bottom: 42px; }
  .method-v6-head h2, .offer-v6-head h2, .industries-copy h2 { font-size: 50px; }
  .diagnosis-ui--interactive { grid-template-columns: 1fr; min-height: 0; }
  .diagnosis-rail { padding: 18px; }
  .diagnosis-rail .brand { display: none; }
  .diagnosis-rail small { display: none; }
  .rail-nav { margin: 0; grid-template-columns: repeat(2, 1fr); }
  .diagnosis-ui--interactive .rail-nav button { min-height: 42px; }
  .diagnosis-main { padding: 22px 18px 24px; }
  .priority-layout { grid-template-columns: 1fr; gap: 28px; padding: 34px 0 24px; }
  .evidence-detail { grid-template-columns: 1fr; gap: 8px; }
  .journey-grid, .plan-grid { grid-template-columns: 1fr; }
  .journey-stage, .plan-grid article { min-height: 190px; }
  .evidence-browser { grid-template-columns: 1fr; }
  .evidence-browser-nav { grid-template-columns: repeat(3, 1fr); }
  .evidence-browser-nav button { padding: 10px; }
  .evidence-browser-main { padding: 24px 18px; }
  .method-command { grid-template-columns: 1fr; }
  .method-group-nav { grid-template-columns: 1fr 1fr; }
  .method-group-nav button { min-height: 78px; }
  .method-stage, .human-decision-card { min-height: 0; padding: 22px 18px; }
  .human-orbit { width: 120px; height: 120px; margin-bottom: 26px; }
  .human-orbit b { inset: 48px; }
  .industry-grid { grid-template-columns: 1fr; }
  .industry-grid article { min-height: 125px; }
  .offer-selector { grid-template-columns: 1fr; }
  .offer-selector button { grid-template-columns: 28px 1fr auto 16px; }
  .offer-focus-card { padding: 24px 18px; }
  .offer-focus-title { grid-template-columns: 1fr; gap: 24px; margin-top: 35px; }
  .offer-focus-title h3 { font-size: 50px; }
  .offer-fit-grid { grid-template-columns: 1fr; }
  .offer-fit-grid > div, .offer-fit-grid > div + div { padding: 15px 0; border-right: 0; border-bottom: 1px solid var(--line); }
  .offer-fit-grid > div:last-child { border-bottom: 0; }
  .offer-help { grid-template-columns: 1fr; gap: 9px; }
  .scan-selected { grid-template-columns: 1fr auto; }
  .scan-selected span { grid-column: 1 / -1; }
}

/* =========================================================
   V7 — clearer rhythm, readable demo, earlier offer
   06 dark / 07 light / 08 dark / 09 light / 10 dark / 11 light
   ========================================================= */

/* Editorial anti-agency statement: return to light, premium layout */
.principle--v7 {
  padding: 132px 0 142px;
  background:
    radial-gradient(circle at 88% 12%, rgba(200,68,104,.075), transparent 26%),
    #fbf8f3;
  color: var(--ink);
  border-top: 1px solid rgba(18,17,16,.08);
  border-bottom: 1px solid rgba(18,17,16,.09);
}
.principle--v7 .principle-kicker-row {
  display: flex;
  justify-content: space-between;
  gap: 32px;
  align-items: center;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
}
.principle--v7 .principle-kicker-row > span {
  color: #9a9087;
  font: 750 8px/1 var(--body);
  letter-spacing: .13em;
}
.principle--v7 h2 {
  margin: 54px 0 64px;
  max-width: 1190px;
  font: 520 clamp(62px, 7vw, 112px)/.86 var(--display);
  letter-spacing: -.07em;
}
.principle--v7 h2 .accent-text { color: transparent; }
.principle-grid--cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  border: 0;
}
.principle-grid--cards article {
  min-height: 300px;
  padding: 24px;
  border: 1px solid rgba(18,17,16,.105);
  border-radius: 20px;
  background: rgba(255,255,255,.6);
  display: flex;
  flex-direction: column;
  transition: transform .24s ease, box-shadow .24s ease, border-color .24s ease;
}
.principle-grid--cards article:hover {
  transform: translateY(-5px);
  border-color: rgba(165,46,85,.24);
  box-shadow: 0 22px 58px rgba(54,43,35,.08);
}
.principle-grid--cards article > div { display: flex; justify-content: space-between; }
.principle-grid--cards article > div span { color: var(--wine); font: 800 9px/1 var(--body); letter-spacing: .12em; }
.principle-grid--cards article > div i { color: #aaa098; font-style: normal; }
.principle-grid--cards h3 { margin: auto 0 15px; font: 520 clamp(30px,3vw,44px)/.95 var(--display); letter-spacing: -.05em; }
.principle-grid--cards p,
.principle--v7 .principle-grid p,
.principle--v7 .principle-grid p:last-child {
  margin: 0;
  padding: 0;
  border: 0;
  color: #6c645d;
  font-size: 11px;
  line-height: 1.72;
  font-weight: 500;
}

/* 05 — sample Map: dark navigation + bright working canvas */
.diagnosis-ui--interactive {
  min-height: 790px;
  background: #f8f4ee;
  border-color: rgba(18,17,16,.14);
  box-shadow: 0 44px 110px rgba(59,47,39,.16);
}
.diagnosis-ui--interactive .diagnosis-main {
  background:
    linear-gradient(rgba(18,17,16,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(18,17,16,.025) 1px, transparent 1px),
    #f9f6f1;
  background-size: 32px 32px;
  color: var(--ink);
}
.diagnosis-ui--interactive .diagnosis-top {
  border-bottom-color: rgba(18,17,16,.12);
  color: #81786f;
  font-weight: 700;
}
.diagnosis-ui--interactive .diagnosis-top b { color: var(--wine); }
.diagnosis-ui--interactive .priority-no,
.diagnosis-ui--interactive .view-intro > span { color: var(--wine); }
.diagnosis-ui--interactive .priority-copy h3 { color: var(--ink); }
.diagnosis-ui--interactive .priority-copy p,
.diagnosis-ui--interactive .view-intro p { color: #655d56; font-size: 12px; }
.diagnosis-ui--interactive .evidence-stack { border-top: 0; }
.diagnosis-ui--interactive .evidence-row {
  border-color: rgba(18,17,16,.11);
  background: rgba(255,255,255,.7);
  color: var(--ink);
  box-shadow: 0 8px 22px rgba(45,35,29,.035);
}
.diagnosis-ui--interactive .evidence-row:hover,
.diagnosis-ui--interactive .evidence-row.active {
  border-color: rgba(165,46,85,.32);
  background: #fffaf7;
  box-shadow: 0 14px 34px rgba(69,49,39,.08);
}
.diagnosis-ui--interactive .evidence-row span { color: var(--wine); }
.diagnosis-ui--interactive .evidence-row strong { color: #2b2724; font-size: 11px; }
.diagnosis-ui--interactive .evidence-row i { color: #9b9189; }
.diagnosis-ui--interactive .evidence-detail {
  margin-top: 12px;
  background: #181412;
  border-color: #181412;
  box-shadow: 0 18px 40px rgba(29,22,19,.13);
}
.diagnosis-ui--interactive .evidence-detail p { color: rgba(255,255,255,.72); font-size: 11px; }
.diagnosis-ui--interactive .view-intro h3 { color: var(--ink); }
.diagnosis-ui--interactive .journey-stage,
.diagnosis-ui--interactive .plan-grid article {
  border-color: rgba(18,17,16,.11);
  background: rgba(255,255,255,.72);
  color: var(--ink);
  box-shadow: 0 10px 28px rgba(50,39,32,.035);
}
.diagnosis-ui--interactive .journey-stage:hover {
  border-color: rgba(165,46,85,.28);
  background: #fff;
  box-shadow: 0 16px 34px rgba(50,39,32,.08);
}
.diagnosis-ui--interactive .journey-stage.critical {
  border-color: rgba(165,46,85,.34);
  background: radial-gradient(circle at 80% 0%, rgba(200,68,104,.12), transparent 44%), #fff8f6;
}
.diagnosis-ui--interactive .journey-stage > span { color: #968b82; }
.diagnosis-ui--interactive .journey-stage strong { color: var(--wine); }
.diagnosis-ui--interactive .journey-stage em { color: #776d65; }
.diagnosis-ui--interactive .journey-stage p,
.diagnosis-ui--interactive .plan-grid p { color: #716861; font-size: 9px; }
.diagnosis-ui--interactive .evidence-browser {
  border-color: rgba(18,17,16,.12);
  background: white;
  box-shadow: 0 16px 40px rgba(50,39,32,.055);
}
.diagnosis-ui--interactive .evidence-browser-main { background: #fffaf5; color: var(--ink); }
.diagnosis-ui--interactive .evidence-browser-main > span { color: var(--wine); }
.diagnosis-ui--interactive .evidence-browser-main p { color: #665e57; font-size: 11px; }
.diagnosis-ui--interactive .decision-tabs { border-top-color: rgba(18,17,16,.12); }
.diagnosis-ui--interactive .decision-tabs button {
  border-color: rgba(18,17,16,.13);
  color: #7b7169;
  background: rgba(255,255,255,.55);
}
.diagnosis-ui--interactive .decision-tabs button:hover { border-color: rgba(165,46,85,.3); color: var(--wine); }
.diagnosis-ui--interactive .decision-tabs button.active { background: var(--ink); color: #fff; border-color: var(--ink); }
.diagnosis-ui--interactive .decision-output {
  border-color: rgba(18,17,16,.12);
  background: #fff;
  box-shadow: 0 14px 38px rgba(49,37,30,.055);
}
.diagnosis-ui--interactive .decision-output span { color: var(--wine); }
.diagnosis-ui--interactive .decision-output strong { color: var(--ink); font-size: 17px; }

/* 06 — method becomes the dark contrast section */
.method-v6 {
  background: radial-gradient(circle at 86% 12%, rgba(165,46,85,.13), transparent 28%), #151210;
  color: #fff;
}
.method-v6-head .eyebrow { color: rgba(255,255,255,.47); }
.method-v6-head p { color: rgba(255,255,255,.56); }
.method-group-nav button {
  border-color: rgba(255,255,255,.09);
  background: rgba(255,255,255,.025);
  color: #fff;
}
.method-group-nav button:hover { border-color: rgba(225,120,146,.35); background: rgba(255,255,255,.045); }
.method-group-nav button.active {
  background: #f6f1ea;
  color: var(--ink);
  border-color: #f6f1ea;
  box-shadow: 0 18px 45px rgba(0,0,0,.2);
}
.method-group-nav button.active > span { color: var(--wine); }
.method-stage { box-shadow: 0 28px 80px rgba(0,0,0,.19); }
.human-decision-card { border: 1px solid rgba(255,255,255,.1); background: radial-gradient(circle at 50% 12%, rgba(225,120,146,.20), transparent 28%), #21191a; }

/* 07 — explicitly LIGHT */
.evidence-section {
  background: #f6f1ea;
  color: var(--ink);
}
.evidence-section .eyebrow { color: #766d65; }
.evidence-section .section-heading p { color: #6d645d; }
.evidence-grid--hover article {
  border-color: rgba(18,17,16,.1);
  background: rgba(255,255,255,.58);
  color: var(--ink);
}
.evidence-grid--hover article:hover {
  border-color: rgba(165,46,85,.28);
  background: #fffaf6;
  box-shadow: 0 26px 58px rgba(57,44,36,.08);
}
.evidence-grid--hover article::before { background: radial-gradient(circle, rgba(200,68,104,.12), transparent 68%); }
.evidence-grid--hover article > span { color: var(--wine); }
.evidence-grid--hover article h3 { color: var(--ink); }
.evidence-grid--hover article p { color: #70675f; }
.evidence-arrow { color: #a79d95; }
.evidence-grid--hover article:hover .evidence-arrow { color: var(--wine); }

/* 08 — explicitly DARK */
.industries {
  background: radial-gradient(circle at 12% 14%, rgba(223,118,95,.08), transparent 26%), #171412;
  color: #fff;
}
.industries .eyebrow { color: rgba(255,255,255,.46); }
.industries-copy p { color: rgba(255,255,255,.55); }
.industries .text-link { color: #fff; }
.industry-grid article {
  border-color: rgba(255,255,255,.09);
  background: rgba(255,255,255,.025);
  color: #fff;
}
.industry-grid article:hover {
  transform: translateY(-5px);
  background: rgba(255,255,255,.055);
  border-color: rgba(225,120,146,.33);
  box-shadow: 0 20px 48px rgba(0,0,0,.18);
}
.industry-grid span { color: #e892a7; }
.industry-grid p { color: rgba(255,255,255,.42); }

/* 09 — offer moves earlier and becomes LIGHT */
.offer-v6 {
  background: radial-gradient(circle at 88% 4%, rgba(165,46,85,.08), transparent 24%), #eee7de;
  color: var(--ink);
  border-top: 1px solid rgba(18,17,16,.08);
}
.offer-v6-head .eyebrow { color: #766d65; }
.offer-v6-head p { color: #6b635c; }
.offer-selector button {
  border-color: rgba(18,17,16,.105);
  background: rgba(255,255,255,.52);
  color: var(--ink);
  box-shadow: 0 7px 20px rgba(54,42,34,.025);
}
.offer-selector button:hover { border-color: rgba(165,46,85,.28); background: #fffaf6; }
.offer-selector button.active {
  background: #171412;
  color: #fff;
  border-color: #171412;
  box-shadow: 0 20px 48px rgba(44,33,28,.13);
}
.offer-selector button > span { color: var(--wine); }
.offer-selector button.active > span { color: #ed96ac; }
.offer-selector button small { color: #81776f; }
.offer-selector button.active small { color: rgba(255,255,255,.45); }
.offer-selector button b { color: #5e5650; }
.offer-selector button.active b { color: rgba(255,255,255,.77); }
.offer-selector button i { color: #9e948b; }
.offer-selector button.active i { color: rgba(255,255,255,.4); }
.offer-focus-card {
  border-color: rgba(18,17,16,.11);
  background: #fffaf5;
  box-shadow: 0 32px 82px rgba(65,50,40,.10);
}
.offer-help {
  border-color: rgba(18,17,16,.1);
  background: rgba(255,255,255,.42);
}
.offer-help > span { color: var(--wine); }
.offer-help p { color: #70675f; }
.offer-help a { color: var(--ink); border-bottom-color: rgba(18,17,16,.22); }

/* 10 work remains dark; 11 team remains light */
.work { background: #171412; color: #fff; }
.team { background: #f7f3ed; }

/* 12 form is a deliberate dark CTA after the light team */
.scan {
  background: radial-gradient(circle at 8% 0%, rgba(200,68,104,.11), transparent 30%), #1a1614;
  color: #fff;
}
.scan .eyebrow { color: rgba(255,255,255,.48); }
.scan-copy p { color: rgba(255,255,255,.56); }
.scan-selected {
  border-color: rgba(255,255,255,.1);
  background: rgba(255,255,255,.03);
}
.scan-selected span { color: #ec96ab; }
.scan-selected small { color: rgba(255,255,255,.44); }
.scan-steps span { border-color: rgba(255,255,255,.11); color: rgba(255,255,255,.34); }
.scan-steps span.active { color: #f0a0b4; border-color: rgba(225,120,146,.28); background: rgba(200,68,104,.08); }
.scan-card--v6 { color: var(--ink); background: #faf7f2; box-shadow: 0 32px 88px rgba(0,0,0,.24); }

@media (max-width: 760px) {
  .principle--v7 { padding: 92px 0; }
  .principle--v7 .principle-kicker-row { align-items: flex-start; flex-direction: column; gap: 12px; }
  .principle--v7 h2 { margin: 38px 0 42px; font-size: 54px; }
  .principle-grid--cards { grid-template-columns: 1fr; }
  .principle-grid--cards article { min-height: 230px; }
}

/* ===== V8 / IMMERSIVE OFFICE JOURNEY ===== */
.story--office-journey { min-height: 600vh; background: #ece7df; }
.story--office-journey .story-step { min-height: 100vh; }
.story--office-journey .story-canvas-wrap { background: #ece7df; }
.living-map--office { background: #ece7df; }
.living-map--office canvas { opacity: 1; transform: none; }
.living-map--office::after {
  content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none;
  background: linear-gradient(90deg, rgba(236,231,223,.92) 0%, rgba(236,231,223,.50) 21%, transparent 43%, transparent 100%),
              linear-gradient(0deg, rgba(20,17,15,.08), transparent 26%);
}
.journey-intro-copy { position: relative; z-index: 4; }
.journey-intro-copy h1 { max-width: 790px; }
.journey-world-step { justify-content: flex-start; }
.journey-world-step--right { justify-content: flex-end; }
.journey-world-card {
  position: relative; z-index: 4; pointer-events: auto;
  width: min(500px, 39vw); padding: 28px 30px 26px;
  border: 1px solid rgba(255,255,255,.18); border-radius: 22px;
  background: rgba(18,16,15,.78); color: white; backdrop-filter: blur(20px) saturate(115%);
  box-shadow: 0 28px 80px rgba(27,22,18,.22);
}
.journey-world-card .eyebrow { color: #f1a0b4; }
.journey-world-card h2 { margin: 18px 0 16px; font: 520 clamp(42px,4.3vw,68px)/.93 var(--display); letter-spacing: -.055em; }
.journey-world-card p { margin: 0; color: rgba(255,255,255,.66); font-size: 13px; line-height: 1.72; }
.journey-world-proof { margin-top: 22px; padding-top: 17px; border-top: 1px solid rgba(255,255,255,.12); display: flex; align-items: center; gap: 10px; color: rgba(255,255,255,.82); font-size: 10px; font-weight: 700; letter-spacing: .04em; }
.journey-world-proof i { width: 8px; height: 8px; border-radius: 50%; background: #df765f; box-shadow: 0 0 0 7px rgba(223,118,95,.12); }
.journey-world-cta { margin-top: 22px; min-height: 48px; padding: 0 14px; display: flex; align-items: center; justify-content: space-between; border-radius: 11px; background: linear-gradient(120deg,#df8c69,#c84468 58%,#932448); color: white; text-decoration: none; font-size: 10px; font-weight: 750; }
.office-station-label { min-width: 138px; padding: 10px 11px; display: flex; gap: 9px; align-items: center; border-radius: 12px; color: white; background: rgba(20,18,17,.82); border: 1px solid rgba(255,255,255,.16); backdrop-filter: blur(12px); box-shadow: 0 10px 36px rgba(0,0,0,.18); }
.office-station-label > span { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: #f5e9e0; color: #9d365b; font: 800 8px/1 var(--body); }
.office-station-label b { display: block; font: 750 8px/1 var(--body); letter-spacing: .10em; }
.office-station-label small { display: block; margin-top: 4px; color: rgba(255,255,255,.58); font: 600 7px/1 var(--body); }
.office-screen-copy { padding: 5px 8px; border-radius: 6px; color: rgba(255,255,255,.9); background: rgba(17,15,14,.72); font: 750 6px/1 var(--body); letter-spacing: .11em; white-space: nowrap; }
.journey-hud { position: absolute; z-index: 4; left: 50%; bottom: 28px; transform: translateX(-50%); min-width: 390px; padding: 10px 14px; border: 1px solid rgba(255,255,255,.16); border-radius: 999px; background: rgba(17,15,14,.68); color: rgba(255,255,255,.76); backdrop-filter: blur(16px); display: flex; align-items: center; justify-content: space-between; gap: 20px; font: 700 8px/1 var(--body); letter-spacing: .12em; }
.journey-hud div { display: flex; gap: 14px; align-items: center; }
.journey-hud i { width: 7px; height: 7px; border-radius: 50%; background: #d96f62; box-shadow: 0 0 0 4px rgba(217,111,98,.12); }

@media (max-width: 760px) {
  .story--office-journey { min-height: 600vh; }
  .living-map--office::after { background: linear-gradient(0deg, rgba(236,231,223,.92) 0%, rgba(236,231,223,.30) 45%, transparent 72%); }
  .journey-world-step, .journey-world-step--right { justify-content: center; align-items: flex-end; }
  .journey-world-card { width: 100%; padding: 21px; }
  .journey-world-card h2 { font-size: 42px; }
  .journey-hud { display: none; }
}

/* =========================================================
   V9 — INTERACTIVE STRATEGY TERRAIN / HERO ONLY
   Rest of V8 stays unchanged.
   ========================================================= */
.story--strategy-map { min-height: 600vh; background: #eee8df; }
.story--strategy-map .story-step { min-height: 100vh; }
.story--strategy-map .story-canvas-wrap { background: #eee8df; }
.living-map--strategy { background: radial-gradient(circle at 60% 40%, #faf7f1 0%, #eee8df 48%, #e6dfd6 100%); }
.living-map--strategy canvas { opacity: 1; transform: none; }
.living-map--strategy::after {
  content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 2;
  background:
    linear-gradient(90deg, rgba(238,232,223,.98) 0%, rgba(238,232,223,.72) 24%, rgba(238,232,223,.08) 45%, transparent 68%),
    linear-gradient(0deg, rgba(238,232,223,.42) 0%, transparent 24%);
}
.strategy-intro-copy { position: relative; z-index: 5; max-width: 720px; }
.strategy-intro-copy h1 { max-width: 760px; }
.strategy-intro-copy h1 span {
  background: linear-gradient(115deg,#dd8b6e 0%,#cf5c69 48%,#9d365b 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.strategy-zone-step { justify-content: flex-start; padding-left: clamp(26px,6vw,110px); }
.strategy-zone-step--right { justify-content: flex-end; padding-left: 0; padding-right: clamp(26px,6vw,110px); }
.strategy-zone-copy {
  position: relative; z-index: 5; width: min(500px, 36vw); padding: 24px 0 24px 22px;
  border-left: 1px solid rgba(24,21,19,.22); color: #181513;
  text-shadow: 0 1px 0 rgba(255,255,255,.35);
}
.strategy-zone-copy::before { content:''; position:absolute; left:-4px; top:27px; width:7px; height:7px; border-radius:50%; background:#c84468; box-shadow:0 0 0 8px rgba(200,68,104,.10); }
.strategy-zone-copy .eyebrow { color: #9d365b; }
.strategy-zone-copy h2 { margin: 18px 0 16px; font: 520 clamp(38px,4vw,66px)/.95 var(--display); letter-spacing: -.055em; color:#161311; }
.strategy-zone-copy p { margin:0; max-width: 470px; color:#635c56; font-size:13px; line-height:1.75; }
.strategy-zone-proof { margin-top:22px; padding-top:16px; border-top:1px solid rgba(24,21,19,.12); display:flex; align-items:center; gap:10px; color:#413b36; font-size:10px; font-weight:760; letter-spacing:.03em; }
.strategy-zone-proof i { width:8px; height:8px; border-radius:50%; background:#df765f; box-shadow:0 0 0 7px rgba(223,118,95,.12); }
.strategy-zone-cta { margin-top:20px; min-height:48px; padding:0 14px; display:flex; align-items:center; justify-content:space-between; border-radius:11px; background:linear-gradient(120deg,#df8c69,#c84468 58%,#932448); color:#fff; text-decoration:none; font-size:10px; font-weight:760; box-shadow:0 12px 30px rgba(147,36,72,.18); }

.map-zone-label {
  position: relative; min-width: 168px; max-width: 210px; padding: 11px 34px 11px 12px;
  border: 1px solid rgba(28,23,20,.12); border-radius: 12px; background: rgba(250,248,244,.88);
  box-shadow: 0 12px 30px rgba(42,32,27,.10); backdrop-filter: blur(14px); color:#181513;
  display:grid; grid-template-columns:auto 1fr; column-gap:8px; row-gap:2px; text-align:left; cursor:pointer;
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease, background .22s ease;
}
.map-zone-label:hover,.map-zone-label.is-hovered { transform: translateY(-5px); border-color: rgba(168,52,89,.30); background: rgba(255,252,248,.96); box-shadow:0 18px 46px rgba(73,48,38,.16); }
.map-zone-label span { grid-row:1 / span 2; align-self:center; color:#a83459; font:800 8px/1 var(--body); letter-spacing:.08em; }
.map-zone-label strong { font:700 10px/1.05 var(--body); letter-spacing:.02em; }
.map-zone-label small { color:#746b64; font:600 7px/1.25 var(--body); }
.map-zone-label i { position:absolute; right:10px; top:50%; transform:translateY(-50%); font-style:normal; color:#a83459; }
.strategy-map-topline { position:absolute; z-index:6; top:90px; right:38px; display:flex; align-items:center; gap:9px; color:#514943; font:800 8px/1 var(--body); letter-spacing:.13em; text-transform:uppercase; }
.strategy-map-topline i { width:7px; height:7px; border-radius:50%; background:#c84468; box-shadow:0 0 0 6px rgba(200,68,104,.10); }
.strategy-map-topline span { color:#948981; font-weight:600; letter-spacing:.03em; text-transform:none; }
.strategy-map-nav { position:absolute; z-index:6; left:50%; bottom:26px; transform:translateX(-50%); display:flex; gap:4px; padding:6px; border:1px solid rgba(31,26,23,.12); border-radius:999px; background:rgba(250,248,244,.82); backdrop-filter:blur(16px); box-shadow:0 14px 38px rgba(55,43,36,.10); }
.strategy-map-nav button { min-height:34px; padding:0 11px; border:0; border-radius:999px; background:transparent; color:#6d645e; font:720 7px/1 var(--body); letter-spacing:.04em; cursor:pointer; transition:background .18s ease,color .18s ease,transform .18s ease; }
.strategy-map-nav button span { margin-right:5px; color:#ac6b62; }
.strategy-map-nav button:hover { color:#181513; transform:translateY(-1px); }
.strategy-map-nav button.active { background:#181513; color:#fff; }
.strategy-map-nav button.active span { color:#f09b84; }

@media (max-width: 900px) {
  .story--strategy-map { min-height: 600vh; }
  .living-map--strategy::after { background:linear-gradient(0deg,rgba(238,232,223,.96) 0%,rgba(238,232,223,.62) 36%,transparent 65%); }
  .strategy-zone-step,.strategy-zone-step--right { justify-content:center; align-items:flex-end; padding:0 16px 90px; }
  .strategy-zone-copy { width:100%; max-width:640px; padding:18px 18px 18px 22px; border:1px solid rgba(24,21,19,.10); border-radius:18px; background:rgba(250,248,244,.85); backdrop-filter:blur(16px); box-shadow:0 16px 45px rgba(57,43,34,.08); }
  .strategy-zone-copy::before { left:18px; top:-4px; }
  .strategy-zone-copy h2 { font-size:42px; }
  .strategy-map-topline { display:none; }
  .strategy-map-nav { bottom:12px; max-width:calc(100vw - 24px); overflow-x:auto; justify-content:flex-start; }
  .strategy-map-nav button { white-space:nowrap; }
  .map-zone-label { min-width:138px; transform:scale(.86); }
}

@media (prefers-reduced-motion: reduce) {
  .map-zone-label,.strategy-map-nav button { transition:none; }
}

/* V10 — EXECUTIVE BUSINESS MAP */
.story--strategy-map { background:#0b0b0c; }
.story--strategy-map .story-canvas-wrap { background:#0b0b0c; }
.living-map--executive { background:#0b0b0c; }
.living-map--executive canvas { opacity:1; transform:none; }
.living-map--executive::before {
  content:''; position:absolute; inset:0; z-index:2; pointer-events:none;
  background:
    linear-gradient(90deg,rgba(9,9,10,.88) 0%,rgba(9,9,10,.48) 28%,transparent 52%,rgba(9,9,10,.14) 100%),
    linear-gradient(0deg,rgba(9,9,10,.78) 0%,transparent 26%,rgba(9,9,10,.16) 100%);
}
.living-map--executive::after {
  content:''; position:absolute; inset:0; z-index:2; pointer-events:none;
  background:radial-gradient(circle at 65% 46%,transparent 0 32%,rgba(0,0,0,.11) 57%,rgba(0,0,0,.42) 100%);
}
.strategy-intro-copy { color:#f5f1eb; text-shadow:0 1px 0 rgba(0,0,0,.18); }
.strategy-intro-copy .eyebrow { color:#c9a477; }
.strategy-intro-copy h1 { color:#f7f3ed; }
.strategy-intro-copy h1 span { background:linear-gradient(110deg,#e58a72 0%,#cb5c6b 55%,#9c3458 100%); -webkit-background-clip:text; background-clip:text; color:transparent; }
.strategy-intro-copy .hero-lead { color:#bdb6ae; }
.strategy-intro-copy .button--ghost { color:#f2eee8; border-color:rgba(244,239,231,.23); background:rgba(15,15,16,.34); }
.strategy-intro-copy .micro-proof { color:#9d958d; }

.strategy-zone-step,.strategy-zone-step--right { position:relative; z-index:5; }
.strategy-zone-copy {
  max-width:520px; padding:24px 26px 24px 30px; border:1px solid rgba(201,164,119,.17);
  background:linear-gradient(145deg,rgba(18,18,20,.90),rgba(10,10,11,.76));
  backdrop-filter:blur(22px) saturate(120%); border-radius:4px;
  box-shadow:0 24px 80px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.035); color:#f4efe7;
}
.strategy-zone-copy::before { left:-1px; top:24px; width:2px; height:44px; border-radius:0; background:linear-gradient(#c9a477,#de755f,#8f2f50); box-shadow:none; }
.strategy-zone-copy .eyebrow { color:#c9a477; }
.strategy-zone-copy h2 { color:#f6f2ec; font-weight:490; }
.strategy-zone-copy p { color:#aaa39c; }
.strategy-zone-proof { border-top-color:rgba(201,164,119,.14); color:#d6cec5; }
.strategy-zone-proof i { background:#c9a477; box-shadow:0 0 0 5px rgba(201,164,119,.10); }
.strategy-zone-cta { background:linear-gradient(115deg,#9d365b,#c95868 56%,#dc7962); box-shadow:0 12px 32px rgba(143,47,80,.24); }

.executive-map-kicker { position:absolute; z-index:6; top:88px; right:34px; display:flex; align-items:center; gap:9px; color:#c8c0b7; font:800 8px/1 var(--body); letter-spacing:.16em; text-transform:uppercase; }
.executive-map-kicker i { width:18px; height:1px; background:#c9a477; }
.executive-map-kicker span { color:#68635f; letter-spacing:.04em; text-transform:none; font-weight:600; }

.map-inspector { position:absolute; z-index:6; right:34px; top:132px; width:min(330px,26vw); padding:18px 18px 17px; border:1px solid rgba(201,164,119,.16); border-radius:3px; background:rgba(10,10,11,.72); backdrop-filter:blur(18px); box-shadow:0 18px 50px rgba(0,0,0,.22); opacity:.56; transform:translateY(-3px); transition:opacity .2s ease,transform .2s ease,border-color .2s ease; }
.map-inspector.is-active { opacity:1; transform:none; border-color:rgba(201,164,119,.28); }
.map-inspector__top { display:flex; align-items:center; justify-content:space-between; padding-bottom:11px; margin-bottom:13px; border-bottom:1px solid rgba(255,255,255,.07); }
.map-inspector__top span { color:#df765f; font:800 10px/1 var(--body); letter-spacing:.12em; }
.map-inspector__top small { color:#6f6964; font:750 7px/1 var(--body); letter-spacing:.15em; }
.map-inspector strong { display:block; color:#f4efe7; font:620 19px/1 var(--display); letter-spacing:-.025em; }
.map-inspector p { margin:10px 0 12px; color:#b5aea7; font:500 10px/1.55 var(--body); }
.map-inspector > div:last-child { color:#c9a477; font:720 7px/1.35 var(--body); letter-spacing:.05em; }

.executive-map-nav { position:absolute; z-index:6; left:50%; bottom:24px; transform:translateX(-50%); display:flex; align-items:stretch; gap:0; border:1px solid rgba(201,164,119,.15); background:rgba(9,9,10,.78); backdrop-filter:blur(20px); box-shadow:0 18px 60px rgba(0,0,0,.28); }
.executive-map-nav button { min-width:124px; padding:10px 14px 9px; border:0; border-right:1px solid rgba(255,255,255,.055); background:transparent; color:#706a65; text-align:left; cursor:pointer; transition:background .2s ease,color .2s ease,transform .2s ease; }
.executive-map-nav button:last-child { border-right:0; }
.executive-map-nav button span { display:block; margin-bottom:4px; color:#8d6c55; font:800 7px/1 var(--body); letter-spacing:.12em; }
.executive-map-nav button b { display:block; font:740 7px/1.2 var(--body); letter-spacing:.04em; white-space:nowrap; }
.executive-map-nav button:hover { color:#eee8df; background:rgba(201,164,119,.07); }
.executive-map-nav button.active { color:#fff8f0; background:linear-gradient(180deg,rgba(201,164,119,.13),rgba(143,47,80,.12)); }
.executive-map-nav button.active span { color:#df765f; }
.executive-map-scale { position:absolute; z-index:6; right:34px; bottom:30px; display:flex; align-items:center; gap:7px; color:#66615d; font:700 7px/1 var(--body); }
.executive-map-scale i { width:46px; height:1px; background:linear-gradient(90deg,#5f5146,#c9a477); }

@media (max-width: 980px) {
  .living-map--executive::before { background:linear-gradient(0deg,rgba(9,9,10,.92) 0%,rgba(9,9,10,.44) 42%,transparent 68%); }
  .executive-map-kicker,.map-inspector,.executive-map-scale { display:none; }
  .executive-map-nav { bottom:12px; max-width:calc(100vw - 24px); overflow-x:auto; left:12px; right:12px; transform:none; }
  .executive-map-nav button { min-width:118px; flex:0 0 auto; }
  .strategy-zone-copy { width:100%; max-width:640px; padding:18px 18px 18px 22px; border-radius:4px; background:rgba(12,12,13,.90); }
  .strategy-zone-copy h2 { color:#f6f2ec; }
}

@media (prefers-reduced-motion: reduce) {
  .executive-map-nav button,.map-inspector { transition:none; }
}


/* V11 — hero readability + brighter executive map */
.story--strategy-map { background:#191613; }
.living-map--executive {
  background:
    radial-gradient(circle at 70% 42%, rgba(177,132,93,.22) 0%, rgba(63,49,39,.10) 26%, transparent 52%),
    radial-gradient(circle at 56% 72%, rgba(143,47,80,.10), transparent 35%),
    #191613;
}
.living-map--executive::before {
  content:''; position:absolute; inset:0; z-index:2; pointer-events:none;
  background:linear-gradient(90deg, rgba(25,22,19,.78) 0%, rgba(25,22,19,.30) 32%, rgba(25,22,19,.02) 55%, rgba(25,22,19,.06) 100%);
}
.living-map--executive::after {
  content:''; position:absolute; inset:0; z-index:2; pointer-events:none;
  background:linear-gradient(0deg, rgba(25,22,19,.44) 0%, transparent 24%, transparent 83%, rgba(25,22,19,.16) 100%);
}

/* Hero: deliberate 4-line editorial lockup */
.strategy-intro-copy.step-copy--hero { width:min(850px,50vw); }
.hero-title-clean { max-width:850px !important; font-size:clamp(58px,5.25vw,88px) !important; line-height:.92 !important; }
.hero-title-line { display:block; white-space:nowrap; }
.hero-title-line--plain { color:#f7f3ed; background:none !important; -webkit-text-fill-color:initial; }
.hero-title-line--accent { background:var(--accent); -webkit-background-clip:text; background-clip:text; color:transparent; }
.story--strategy-map .strategy-intro-copy .eyebrow { color:#d1a77e; }
.story--strategy-map .hero-lead { color:rgba(247,243,237,.70); max-width:650px; }
.story--strategy-map .hero-lead b { color:#fff; }
.story--strategy-map .button--ghost { color:#f7f3ed; border-color:rgba(255,255,255,.18); background:rgba(255,255,255,.055); }
.story--strategy-map .micro-proof { color:rgba(255,255,255,.50); }
.story--strategy-map .micro-proof span { border-color:rgba(255,255,255,.12); }

/* Remove redundant technical corner UI */
.executive-map-kicker, .executive-map-scale { display:none !important; }

/* Inspector appears only during interaction/scroll and stays clear of header */
.map-inspector {
  top:116px; right:34px; width:min(315px,23vw);
  background:rgba(31,27,24,.90); border:1px solid rgba(213,174,133,.32);
  box-shadow:0 22px 60px rgba(0,0,0,.24); opacity:1;
}
.map-inspector strong { color:#fff8ef; font-size:20px; }
.map-inspector p { color:#d1c8bf; font-size:10.5px; }
.map-inspector > div:last-child { color:#e0b382; }

/* Navigator: intentionally visible rather than disappearing into black */
.executive-map-nav {
  left:auto; right:34px; bottom:46px; transform:none;
  display:grid; grid-template-columns:repeat(5,minmax(104px,1fr));
  border:1px solid rgba(73,58,47,.20);
  border-radius:14px;
  overflow:hidden;
  background:rgba(247,241,232,.94);
  box-shadow:0 22px 70px rgba(0,0,0,.25);
  backdrop-filter:blur(18px);
}
.executive-map-nav button {
  min-width:104px; padding:11px 12px 10px;
  color:#75685e; border-right:1px solid rgba(40,31,25,.09);
}
.executive-map-nav button span { color:#a75558; }
.executive-map-nav button:hover { color:#1c1815; background:#fffaf4; }
.executive-map-nav button.active { color:#fff; background:linear-gradient(125deg,#24201d,#3b2e29 55%,#6e3048); }
.executive-map-nav button.active span { color:#f2a082; }

@media (max-width:1200px) {
  .strategy-intro-copy.step-copy--hero { width:min(720px,57vw); }
  .hero-title-clean { font-size:clamp(54px,5.7vw,76px) !important; }
  .executive-map-nav { right:18px; bottom:28px; grid-template-columns:repeat(5,100px); }
  .executive-map-nav button { min-width:100px; }
  .map-inspector { right:18px; width:280px; }
}
@media (max-width:820px) {
  .hero-title-line { white-space:normal; }
  .hero-title-clean { font-size:clamp(46px,12vw,66px) !important; }
  .strategy-intro-copy.step-copy--hero { width:100%; }
  .executive-map-nav { left:12px; right:12px; bottom:12px; display:flex; overflow-x:auto; border-radius:12px; }
  .executive-map-nav button { min-width:118px; flex:0 0 auto; }
  .map-inspector { display:none; }
}

/* =========================================================
   V12 HERO — LIGHT STRATEGY MAP / FIXED NARRATIVE
   ========================================================= */
.story--strategy-map.story--fixed-narrative {
  min-height: 600vh;
  background: #eee8df !important;
}
.story--fixed-narrative .story-canvas-wrap {
  background: #eee8df !important;
}
.story--fixed-narrative .living-map--executive {
  background:
    radial-gradient(circle at 72% 42%, rgba(255,255,255,.96) 0%, rgba(249,245,239,.76) 30%, transparent 58%),
    radial-gradient(circle at 55% 74%, rgba(190,148,119,.12), transparent 34%),
    #eee8df !important;
}
.story--fixed-narrative .living-map--executive::before {
  background: linear-gradient(90deg,
    rgba(238,232,223,.98) 0%,
    rgba(238,232,223,.91) 24%,
    rgba(238,232,223,.42) 40%,
    rgba(238,232,223,.02) 62%,
    rgba(238,232,223,.08) 100%) !important;
}
.story--fixed-narrative .living-map--executive::after {
  background: linear-gradient(0deg,
    rgba(238,232,223,.30) 0%,
    transparent 20%,
    transparent 82%,
    rgba(238,232,223,.20) 100%) !important;
}

.story--fixed-narrative .story-steps {
  margin-top: -100vh;
  pointer-events: none;
}
.story--fixed-narrative .story-scroll-spacer {
  min-height: 100vh;
  padding: 0;
  opacity: 0;
  pointer-events: none;
}

.strategy-story-ui {
  position: absolute;
  inset: 0;
  z-index: 7;
  pointer-events: none;
  width: min(1440px, calc(100% - 48px));
  margin: 0 auto;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding-top: 72px;
}

.strategy-story-card {
  pointer-events: auto;
  width: min(590px, 42vw);
  margin-left: 0;
  animation: strategyCardIn .34s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes strategyCardIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.strategy-story-card--hero {
  padding: 0;
  color: #171412;
  text-shadow: none;
}
.strategy-story-card--hero .eyebrow {
  color: #9f7456 !important;
}
.strategy-story-card--hero .hero-title-clean {
  margin: 18px 0 0;
  max-width: 650px !important;
  font-size: clamp(54px, 4.8vw, 82px) !important;
  line-height: .91 !important;
  letter-spacing: -.065em;
}
.strategy-story-card--hero .hero-title-line {
  display: block;
  white-space: nowrap;
  color: #171412;
  background: none;
  -webkit-text-fill-color: initial;
}
.strategy-story-card--hero .hero-title-line--accent {
  background: var(--accent);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}
.strategy-story-card--hero .hero-lead {
  max-width: 590px;
  margin-top: 24px;
  color: #5c554f !important;
  font-size: 15px;
  line-height: 1.68;
}
.strategy-story-card--hero .button--ghost {
  color: #211d1a !important;
  border-color: rgba(32,26,22,.16) !important;
  background: rgba(255,255,255,.44) !important;
}
.strategy-story-card--hero .micro-proof {
  color: #756c64 !important;
}
.strategy-story-card--hero .micro-proof span {
  border-color: rgba(34,28,24,.12) !important;
}

.strategy-story-card--zone {
  position: relative;
  padding: 26px 28px 25px 30px;
  border: 1px solid rgba(44,35,29,.12);
  border-radius: 18px;
  background: rgba(250,248,244,.91);
  box-shadow: 0 26px 80px rgba(79,61,48,.13);
  backdrop-filter: blur(20px);
  color: #171412;
}
.strategy-story-card--zone::before {
  content: '';
  position: absolute;
  left: 0;
  top: 25px;
  width: 3px;
  height: 48px;
  background: linear-gradient(180deg,#c9a477,#df765f 55%,#9d365b);
}
.strategy-story-card--zone .eyebrow {
  color: #9b694e !important;
}
.strategy-story-card--zone h2 {
  margin: 16px 0 15px;
  color: #171412 !important;
  font: 540 clamp(39px,3.8vw,62px)/.94 var(--display);
  letter-spacing: -.055em;
}
.strategy-story-card--zone p {
  margin: 0;
  max-width: 500px;
  color: #625a53 !important;
  font-size: 13px;
  line-height: 1.72;
}
.strategy-story-card--zone .strategy-zone-proof {
  margin-top: 20px;
  padding-top: 15px;
  border-top-color: rgba(39,31,26,.11) !important;
  color: #4d453f !important;
}
.strategy-story-card--zone .strategy-zone-proof i {
  background: #bd8f6d;
  box-shadow: 0 0 0 5px rgba(189,143,109,.13);
}
.strategy-story-card--zone .strategy-zone-cta {
  color: #fff;
}

/* Light, quiet inspector: secondary to the fixed narrative card */
.story--fixed-narrative .map-inspector {
  top: 122px;
  right: 30px;
  width: min(285px, 21vw);
  padding: 16px 17px 15px;
  border: 1px solid rgba(51,40,32,.12);
  border-radius: 14px;
  background: rgba(250,248,244,.90);
  box-shadow: 0 20px 54px rgba(75,58,46,.11);
  backdrop-filter: blur(18px);
}
.story--fixed-narrative .map-inspector__top {
  border-bottom-color: rgba(43,34,28,.09);
}
.story--fixed-narrative .map-inspector__top span { color: #b55255; }
.story--fixed-narrative .map-inspector__top small { color: #91877e; }
.story--fixed-narrative .map-inspector strong {
  color: #1b1714;
  font-size: 18px;
}
.story--fixed-narrative .map-inspector p {
  color: #615951;
  font-size: 10px;
}
.story--fixed-narrative .map-inspector > div:last-child { color: #9b7154; }

/* Visible, centered journey navigator */
.story--fixed-narrative .executive-map-nav {
  left: 50%;
  right: auto;
  bottom: 24px;
  transform: translateX(-50%);
  width: min(720px, calc(100vw - 80px));
  grid-template-columns: repeat(5, 1fr);
  border: 1px solid rgba(53,42,34,.12);
  border-radius: 15px;
  background: rgba(250,248,244,.94);
  box-shadow: 0 18px 60px rgba(70,53,41,.13);
}
.story--fixed-narrative .executive-map-nav button {
  min-width: 0;
  padding: 10px 12px 9px;
  color: #6c625a;
}
.story--fixed-narrative .executive-map-nav button span { color: #ae6761; }
.story--fixed-narrative .executive-map-nav button:hover {
  color: #1a1714;
  background: #fffaf5;
}
.story--fixed-narrative .executive-map-nav button.active {
  color: #fff;
  background: linear-gradient(125deg,#27211d,#67413c 58%,#9a3657);
}
.story--fixed-narrative .executive-map-nav button.active span { color: #f5b08f; }

@media (max-width: 1180px) {
  .strategy-story-card { width: min(540px, 48vw); }
  .strategy-story-card--hero .hero-title-clean { font-size: clamp(48px,5.4vw,72px) !important; }
  .story--fixed-narrative .map-inspector { right: 18px; width: 250px; }
  .story--fixed-narrative .executive-map-nav { width: min(650px, calc(100vw - 40px)); }
}

@media (max-width: 820px) {
  .strategy-story-ui {
    width: calc(100% - 24px);
    align-items: flex-end;
    padding: 0 0 84px;
  }
  .strategy-story-card {
    width: 100%;
    max-width: 100%;
  }
  .strategy-story-card--hero,
  .strategy-story-card--zone {
    padding: 18px 18px 18px 20px;
    border: 1px solid rgba(44,35,29,.10);
    border-radius: 16px;
    background: rgba(250,248,244,.91);
    box-shadow: 0 16px 48px rgba(79,61,48,.10);
    backdrop-filter: blur(18px);
  }
  .strategy-story-card--hero .hero-title-line { white-space: normal; }
  .strategy-story-card--hero .hero-title-clean { font-size: clamp(42px,11vw,60px) !important; }
  .strategy-story-card--hero .hero-lead { font-size: 13px; }
  .strategy-story-card--zone h2 { font-size: clamp(34px,9.5vw,48px); }
  .story--fixed-narrative .map-inspector { display: none !important; }
  .story--fixed-narrative .executive-map-nav {
    left: 12px;
    right: 12px;
    width: auto;
    bottom: 10px;
    transform: none;
    display: flex;
    overflow-x: auto;
  }
  .story--fixed-narrative .executive-map-nav button { min-width: 116px; flex: 0 0 auto; }
  .story--fixed-narrative .living-map--executive::before {
    background: linear-gradient(0deg, rgba(238,232,223,.88) 0%, rgba(238,232,223,.34) 42%, transparent 70%) !important;
  }
}

/* =========================================================
   V13 — fixed hero narrative, lower-right diagnosis inspector,
   readable method tools, text-only team cards
   ========================================================= */

/* Hero/story: one stable narrative anchor, no horizontal jumping */
.story--fixed-narrative .strategy-story-ui {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 88px clamp(34px, 6vw, 112px) 112px;
  box-sizing: border-box;
  left: 0;
  right: 0;
  justify-content: flex-start;
  align-items: center;
}
.story--fixed-narrative .strategy-story-card {
  margin: 0;
  transform-origin: left center;
  animation: none;
}
.story--fixed-narrative .strategy-story-card--hero {
  width: min(660px, 43vw);
}
.story--fixed-narrative .strategy-story-card--zone {
  width: min(515px, 36vw);
  max-height: calc(100vh - 190px);
  overflow: auto;
  scrollbar-width: none;
}
.story--fixed-narrative .strategy-story-card--zone::-webkit-scrollbar { display: none; }
.story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
  max-width: 650px !important;
  font-size: clamp(50px, 4.25vw, 74px) !important;
  line-height: .92 !important;
  letter-spacing: -.058em;
}
.story--fixed-narrative .strategy-story-card--hero .hero-title-line {
  white-space: normal !important;
}
.story--fixed-narrative .strategy-story-card--zone h2 {
  font-size: clamp(34px, 3.2vw, 52px);
  line-height: .96;
}

/* Bigger diagnosis inspector — anchored lower-right, away from headline/header */
.story--fixed-narrative .map-inspector {
  top: auto !important;
  bottom: 104px !important;
  right: clamp(24px, 3vw, 52px) !important;
  width: min(390px, 29vw) !important;
  padding: 22px 24px 21px !important;
  border-radius: 18px !important;
  background: rgba(251,248,243,.94) !important;
  border: 1px solid rgba(53,42,34,.14) !important;
  box-shadow: 0 24px 70px rgba(75,58,46,.14) !important;
}
.story--fixed-narrative .map-inspector__top { padding-bottom: 13px; margin-bottom: 15px; }
.story--fixed-narrative .map-inspector strong { font-size: 24px !important; line-height: 1.05; }
.story--fixed-narrative .map-inspector p { margin: 12px 0 14px; font-size: 12px !important; line-height: 1.55; }
.story--fixed-narrative .map-inspector > div:last-child { font-size: 9px; line-height: 1.45; }

/* Keep navigator clearly separated from inspector */
.story--fixed-narrative .executive-map-nav { bottom: 24px; z-index: 8; }

/* 05 — diagnosis UI labels and legibility */
.diagnosis-rail > small {
  max-width: 210px;
  color: rgba(255,255,255,.58) !important;
  font-size: 8px !important;
  line-height: 1.55 !important;
  letter-spacing: .09em !important;
}
.diagnosis-top > span { letter-spacing: .10em; }

/* 06 — fix tool visibility on the light stage inside dark method section */
.method-v6 .method-stage {
  color: #171412 !important;
  background: #fffaf5 !important;
  border-color: rgba(18,17,16,.12) !important;
}
.method-v6 .method-stage-head > span { color: #9d365b !important; }
.method-v6 .method-stage-head h3 { color: #171412 !important; }
.method-v6 .method-tools-live article {
  background: #f4eee7 !important;
  border-color: rgba(18,17,16,.10) !important;
}
.method-v6 .method-tools-live article:hover { background: #fff !important; }
.method-v6 .method-tools-live article > span { color: #9d365b !important; }
.method-v6 .method-tools-live strong { color: #1c1815 !important; }
.method-v6 .method-tools-live p { color: #6f665f !important; }
.method-v6 .method-pipeline { border-top-color: rgba(18,17,16,.10) !important; }
.method-v6 .method-pipeline span {
  color: #504943 !important;
  border-color: rgba(18,17,16,.12) !important;
  background: #fff !important;
}
.method-v6 .method-pipeline i { color: #93887e !important; }
.method-v6 .method-pipeline b { color: #fff !important; background: #8f2149 !important; }

/* 11 — temporary text-only team. No placeholder portraits. */
.team-members.team-members--text-only {
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14px;
}
.team-members--text-only .team-member,
.team-members--text-only .team-member--featured {
  grid-column: auto;
  display: flex;
  flex-direction: column;
  min-height: 300px;
  padding: 26px 24px 24px;
  border-radius: 20px;
  background: rgba(255,255,255,.48);
  color: var(--ink);
  border: 1px solid rgba(18,17,16,.10);
  box-shadow: none;
  transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
}
.team-members--text-only .team-member:hover {
  transform: translateY(-4px);
  border-color: rgba(165,46,85,.25);
  background: #fffaf5;
  box-shadow: 0 20px 48px rgba(52,40,32,.07);
}
.team-members--text-only .team-member--featured {
  background: #1b1715;
  color: #fff;
  border-color: #1b1715;
}
.team-member-card-top {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: flex-start;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(18,17,16,.09);
}
.team-member--featured .team-member-card-top { border-bottom-color: rgba(255,255,255,.10); }
.team-member-card-top > span { color: #9d365b; font: 800 8px/1 var(--body); letter-spacing: .12em; }
.team-member--featured .team-member-card-top > span { color: #ef9db1; }
.team-members--text-only .team-member-role {
  max-width: 150px;
  text-align: right;
  color: #9d365b;
  font-size: 8px;
}
.team-members--text-only .team-member--featured .team-member-role { color: #ef9db1; }
.team-members--text-only .team-member h3 {
  margin: 34px 0 28px;
  font: 540 clamp(30px,2.2vw,40px)/.95 var(--display);
  letter-spacing: -.045em;
}
.team-member-scope-label {
  margin-top: auto;
  padding-top: 18px;
  border-top: 1px solid rgba(18,17,16,.09);
  color: #9b928a;
  font: 800 7px/1 var(--body);
  letter-spacing: .13em;
  text-transform: uppercase;
}
.team-member--featured .team-member-scope-label { border-top-color: rgba(255,255,255,.09); color: rgba(255,255,255,.43); }
.team-members--text-only .team-member p {
  margin: 10px 0 0;
  color: #70675f;
  font-size: 10px;
  line-height: 1.65;
}
.team-members--text-only .team-member--featured p { color: rgba(255,255,255,.58); }

@media (max-width: 1280px) {
  .story--fixed-narrative .strategy-story-ui { padding-left: 44px; padding-right: 44px; }
  .story--fixed-narrative .strategy-story-card--hero { width: min(590px, 46vw); }
  .story--fixed-narrative .strategy-story-card--zone { width: min(470px, 39vw); }
  .story--fixed-narrative .map-inspector { width: 330px !important; }
  .team-members.team-members--text-only { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 900px) {
  .story--fixed-narrative .strategy-story-ui { padding: 0 16px 90px; align-items: flex-end; }
  .story--fixed-narrative .strategy-story-card--hero,
  .story--fixed-narrative .strategy-story-card--zone { width: 100%; max-height: 62vh; }
  .story--fixed-narrative .map-inspector { display: none !important; }
  .team-members.team-members--text-only { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 620px) {
  .team-members.team-members--text-only { grid-template-columns: 1fr; }
}

/* =========================================================
   V14 — FINAL COPY / SALES / POSITIONING PASS
   Copy-first refinements only. Existing visual system stays.
   ========================================================= */

.sample-map-badge {
  width: fit-content;
  margin-top: auto;
  padding: 7px 9px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 999px;
  color: rgba(255,255,255,.72);
  font: 800 7px/1 var(--body);
  letter-spacing: .13em;
}

.diagnosis-rail .sample-map-badge + small { margin-top: 10px; }

.confidence-pill {
  display: inline-flex;
  width: fit-content;
  margin: 8px 0 0;
  padding: 6px 8px;
  border-radius: 999px;
  background: rgba(165,46,85,.09);
  color: var(--wine);
  font: 850 7px/1 var(--body);
  letter-spacing: .11em;
}

.evidence-browser-main .confidence-pill {
  margin: 10px 0 4px;
}

.principle-signature {
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1px solid rgba(18,17,16,.12);
  color: var(--ink);
  font: 520 clamp(24px, 2.8vw, 40px)/1 var(--display);
  letter-spacing: -.045em;
}

.work-case-copy {
  margin-top: 24px;
  display: grid;
  gap: 10px;
}

.work-case-copy > div {
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,.09);
}

.work-case-copy span {
  display: block;
  margin-bottom: 5px;
  color: #e692a7;
  font: 800 7px/1 var(--body);
  letter-spacing: .12em;
}

.work-case-copy p {
  margin: 0;
  color: rgba(255,255,255,.64);
  font-size: 9px;
  line-height: 1.55;
}

.offer-value-anchor {
  margin-top: 18px;
  padding: 14px 16px;
  border-left: 2px solid var(--wine);
  background: rgba(165,46,85,.055);
  color: #443b35;
  font-size: 10px;
  line-height: 1.5;
  font-weight: 700;
}

.offer-help--secondary {
  margin-top: 10px;
}

.offer-help--secondary strong {
  display: block;
  color: rgba(255,255,255,.72);
  font-size: 9px;
  line-height: 1.55;
  font-weight: 700;
}

.offer-cost-note {
  max-width: 940px;
  margin: 18px auto 0;
  color: rgba(255,255,255,.42);
  font-size: 9px;
  line-height: 1.7;
  text-align: center;
}

.faq-section {
  padding: 150px 0;
  background: #f1ece5;
  color: var(--ink);
}

.faq-heading { margin-bottom: 58px; }
.faq-heading p { max-width: 640px; color: #716861; }

.faq-list-v14 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-top: 1px solid rgba(18,17,16,.12);
}

.faq-list-v14 details {
  border-bottom: 1px solid rgba(18,17,16,.12);
  min-height: 76px;
}

.faq-list-v14 details:nth-child(odd) {
  border-right: 1px solid rgba(18,17,16,.12);
}

.faq-list-v14 summary {
  min-height: 76px;
  padding: 20px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  list-style: none;
  cursor: pointer;
  font-size: 11px;
  font-weight: 750;
}

.faq-list-v14 summary::-webkit-details-marker { display: none; }
.faq-list-v14 summary i { color: var(--wine); font-style: normal; font-size: 18px; font-weight: 400; }
.faq-list-v14 details[open] summary i { transform: rotate(45deg); }

.faq-list-v14 details > p {
  max-width: 700px;
  margin: -4px 22px 24px;
  color: #6e655e;
  font-size: 10px;
  line-height: 1.7;
}

.final-cta-v14 {
  margin-top: 64px;
  padding: 34px;
  border-radius: 24px;
  background: #171412;
  color: #fff;
  display: grid;
  grid-template-columns: 1.45fr .55fr;
  gap: 36px;
  align-items: end;
}

.final-cta-v14 > div:first-child > span {
  color: #e692a7;
  font: 850 8px/1 var(--body);
  letter-spacing: .13em;
}

.final-cta-v14 h3 {
  max-width: 860px;
  margin: 16px 0 14px;
  font: 520 clamp(34px, 4vw, 58px)/.96 var(--display);
  letter-spacing: -.055em;
}

.final-cta-v14 p {
  max-width: 720px;
  margin: 0;
  color: rgba(255,255,255,.54);
  font-size: 10px;
  line-height: 1.7;
}

.final-cta-actions {
  display: grid;
  gap: 9px;
}

.final-cta-actions .button {
  width: 100%;
  justify-content: center;
}

.final-cta-v14 .button--ghost {
  border-color: rgba(255,255,255,.16);
  color: #fff;
}

.footer-brand > strong {
  display: block;
  margin-top: 22px;
  color: rgba(255,255,255,.8);
  font: 520 20px/1.15 var(--display);
  letter-spacing: -.035em;
}

@media (max-width: 900px) {
  .faq-section { padding: 100px 0; }
  .faq-list-v14 { grid-template-columns: 1fr; }
  .faq-list-v14 details:nth-child(odd) { border-right: 0; }
  .final-cta-v14 { grid-template-columns: 1fr; padding: 26px; }
  .work-case-copy { margin-top: 18px; }
}


/* ============================================================
   V15 — larger hero narrative, larger diagnosis inspector,
   readable journey navigator, no redundant numbering
   ============================================================ */

/* Make the narrative cards feel intentional and easier to scan */
.story--fixed-narrative .strategy-story-ui {
  padding-left: clamp(42px, 6.5vw, 124px);
  padding-right: clamp(42px, 6.5vw, 124px);
}
.story--fixed-narrative .strategy-story-card--hero {
  width: min(760px, 47vw);
  padding: 36px 38px 34px;
}
.story--fixed-narrative .strategy-story-card--zone {
  width: min(610px, 41vw);
  padding: 34px 36px 32px;
  max-height: calc(100vh - 170px);
}
.story--fixed-narrative .strategy-story-card--zone .eyebrow {
  font-size: 11px;
  letter-spacing: .13em;
  margin-bottom: 18px;
}
.story--fixed-narrative .strategy-story-card--zone h2 {
  font-size: clamp(43px, 3.8vw, 64px);
  line-height: .95;
  letter-spacing: -.055em;
}
.story--fixed-narrative .strategy-story-card--zone p {
  max-width: 535px;
  font-size: 14px;
  line-height: 1.65;
  margin-top: 22px;
}
.story--fixed-narrative .strategy-story-card--zone .strategy-zone-proof {
  margin-top: 24px;
  padding-top: 18px;
  font-size: 11px;
  line-height: 1.45;
}

/* Bigger, lower-right diagnosis card. The label is the hierarchy — no number needed. */
.story--fixed-narrative .map-inspector {
  top: auto !important;
  bottom: 126px !important;
  right: clamp(28px, 3.7vw, 68px) !important;
  width: min(470px, 32vw) !important;
  min-height: 190px;
  padding: 30px 32px 28px !important;
  border-radius: 24px !important;
  background: rgba(255,252,247,.96) !important;
  border: 1px solid rgba(67,49,38,.16) !important;
  box-shadow: 0 30px 90px rgba(78,58,44,.16) !important;
}
.story--fixed-narrative .map-inspector__top {
  justify-content: flex-start;
  padding-bottom: 15px;
  margin-bottom: 18px;
  border-bottom-color: rgba(65,48,37,.12);
}
.story--fixed-narrative .map-inspector__top span { display: none !important; }
.story--fixed-narrative .map-inspector__top small {
  color: #9d365b !important;
  font-size: 10px !important;
  font-weight: 800;
  letter-spacing: .16em !important;
}
.story--fixed-narrative .map-inspector strong {
  color: #171412 !important;
  font-size: clamp(28px, 2.1vw, 36px) !important;
  line-height: 1 !important;
  letter-spacing: -.04em;
}
.story--fixed-narrative .map-inspector p {
  max-width: 390px;
  margin: 16px 0 17px;
  color: #5f554d !important;
  font-size: 14px !important;
  line-height: 1.55 !important;
}
.story--fixed-narrative .map-inspector > div:last-child {
  color: #8a6049 !important;
  font-size: 10px !important;
  line-height: 1.5 !important;
  font-weight: 700;
}

/* Larger journey selector — it should read like a real control, not tiny metadata. */
.story--fixed-narrative .executive-map-nav {
  left: 50% !important;
  right: auto !important;
  bottom: 24px !important;
  transform: translateX(-50%) !important;
  width: min(1040px, calc(100vw - 112px)) !important;
  min-height: 72px;
  grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  border-radius: 22px !important;
  overflow: hidden;
  background: rgba(255,252,247,.97) !important;
  border-color: rgba(58,43,34,.14) !important;
  box-shadow: 0 24px 72px rgba(70,52,39,.15) !important;
}
.story--fixed-narrative .executive-map-nav button {
  min-width: 0 !important;
  min-height: 72px;
  padding: 17px 20px 16px !important;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #655b53 !important;
  text-align: center !important;
  border-right: 1px solid rgba(58,43,34,.10) !important;
}
.story--fixed-narrative .executive-map-nav button:last-child { border-right: 0 !important; }
.story--fixed-narrative .executive-map-nav button span { display: none !important; }
.story--fixed-narrative .executive-map-nav button b {
  font-size: 10px !important;
  line-height: 1.25 !important;
  letter-spacing: .06em !important;
  white-space: normal !important;
  text-transform: uppercase;
}
.story--fixed-narrative .executive-map-nav button:hover {
  color: #171412 !important;
  background: #fffaf4 !important;
}
.story--fixed-narrative .executive-map-nav button.active {
  color: #fff !important;
  background: linear-gradient(120deg,#2a211d 0%,#654039 55%,#963754 100%) !important;
}

@media (max-width: 1180px) {
  .story--fixed-narrative .strategy-story-card--hero { width: min(650px, 51vw); }
  .story--fixed-narrative .strategy-story-card--zone { width: min(540px, 45vw); }
  .story--fixed-narrative .map-inspector {
    width: min(390px, 34vw) !important;
    right: 20px !important;
    bottom: 118px !important;
    padding: 24px 25px !important;
  }
  .story--fixed-narrative .executive-map-nav {
    width: min(860px, calc(100vw - 48px)) !important;
  }
  .story--fixed-narrative .executive-map-nav button { padding-inline: 12px !important; }
  .story--fixed-narrative .executive-map-nav button b { font-size: 9px !important; }
}

@media (max-width: 820px) {
  .story--fixed-narrative .strategy-story-card--hero,
  .story--fixed-narrative .strategy-story-card--zone {
    width: 100%;
    padding: 24px 22px;
  }
  .story--fixed-narrative .strategy-story-card--zone h2 {
    font-size: clamp(34px, 9.5vw, 48px);
  }
  .story--fixed-narrative .map-inspector { display: none !important; }
  .story--fixed-narrative .executive-map-nav {
    left: 12px !important;
    right: 12px !important;
    width: auto !important;
    transform: none !important;
    min-height: 58px;
    display: flex !important;
    overflow-x: auto;
    border-radius: 15px !important;
  }
  .story--fixed-narrative .executive-map-nav button {
    min-width: 138px !important;
    min-height: 58px;
    flex: 0 0 auto;
    padding: 12px 14px !important;
  }
  .story--fixed-narrative .executive-map-nav button b { font-size: 9px !important; }
}

/* =========================================================
   V16 — READABILITY PASS
   Larger supporting/body text across the whole experience.
   Display headlines stay unchanged; normal copy is easier to read.
   ========================================================= */

body { font-size: 16px; }

/* Core body copy */
p {
  font-size: clamp(15px, .95vw, 17px) !important;
  line-height: 1.68 !important;
}

/* Navigation + primary actions */
.header nav a { font-size: 14px !important; }
.header-cta,
.button,
.offer-main-cta,
.strategy-zone-cta,
.journey-world-cta,
.scan-card button[type="submit"],
.form-success button {
  font-size: 13px !important;
}

/* Eyebrows, labels and metadata should remain secondary, but readable */
.eyebrow,
.form-kicker,
.browser-kicker,
.work-type,
.work-index,
.priority-no,
.method-stage-head > span,
.offer-focus-top,
.final-cta-v14 > div:first-child > span,
.team-member-card-top > span,
.team-member-scope-label,
.work-case-copy span,
.sample-map-badge,
.confidence-pill {
  font-size: 10.5px !important;
  line-height: 1.25 !important;
}

.micro-proof,
.signal-line,
.text-link,
.special-paths,
.offer-cost-note,
.offer-value-anchor,
.field-help,
.scan-card small,
.scan-selected small,
.domain-confirm,
footer p,
footer > span {
  font-size: 12.5px !important;
  line-height: 1.6 !important;
}

/* Hero / Living Map narrative */
.story--fixed-narrative .strategy-story-card--zone p,
.story--fixed-narrative .strategy-story-card--hero p,
.strategy-zone-copy p,
.journey-world-card p {
  font-size: 16px !important;
  line-height: 1.68 !important;
}
.story--fixed-narrative .strategy-zone-proof,
.strategy-zone-proof,
.journey-world-proof {
  font-size: 12px !important;
}
.story--fixed-narrative .map-inspector p {
  font-size: 15px !important;
  line-height: 1.6 !important;
}
.story--fixed-narrative .map-inspector > div:last-child {
  font-size: 11.5px !important;
}
.story--fixed-narrative .map-inspector__top small {
  font-size: 11px !important;
}
.story--fixed-narrative .executive-map-nav button b {
  font-size: 12px !important;
  line-height: 1.3 !important;
}

/* Sample diagnosis */
.rail-nav button { font-size: 12px !important; }
.diagnosis-rail > small,
.diagnosis-rail small { font-size: 10.5px !important; line-height: 1.55 !important; }
.diagnosis-top { font-size: 11px !important; }
.priority-copy p { font-size: 15px !important; }
.evidence-row span { font-size: 10.5px !important; }
.evidence-row strong { font-size: 18px !important; }
.decision-tabs button { font-size: 10.5px !important; }
.decision-output span { font-size: 10.5px !important; }
.decision-output strong { font-size: 18px !important; }
.diagnosis-ui--interactive .view-intro p,
.diagnosis-ui--interactive .evidence-row strong,
.diagnosis-ui--interactive .evidence-detail p,
.diagnosis-ui--interactive .evidence-browser-main p {
  font-size: 14px !important;
}
.diagnosis-ui--interactive .plan-grid p { font-size: 13px !important; }

/* Process + explanatory sections */
.section-heading p,
.process-intro,
.principle-grid p,
.industries-copy p,
.method-v6-head p,
.offer-v6-head p,
.scan-copy p {
  font-size: 16px !important;
  line-height: 1.72 !important;
}

/* Method / tools */
.method-group-nav button > span { font-size: 10px !important; }
.method-group-nav button strong { font-size: 13px !important; }
.method-tools-live article > span { font-size: 10.5px !important; }
.method-tools-live strong { font-size: 13px !important; }
.method-tools-live p { font-size: 13px !important; line-height: 1.55 !important; }
.method-pipeline span,
.method-pipeline b { font-size: 11px !important; }

/* Scope / industries */
.evidence-grid article > span { font-size: 10.5px !important; }
.evidence-grid p { font-size: 14px !important; line-height: 1.65 !important; }
.industry-grid span { font-size: 10px !important; }
.industry-grid p { font-size: 11px !important; line-height: 1.4 !important; }

/* Offer */
.offer-selector button > span { font-size: 10px !important; }
.offer-selector button small { font-size: 11px !important; line-height: 1.35 !important; }
.offer-selector button b { font-size: 12px !important; }
.offer-focus-title p { font-size: 15px !important; }
.offer-fit-grid span,
.offer-includes > span { font-size: 10px !important; }
.offer-fit-grid strong { font-size: 13px !important; line-height: 1.55 !important; }
.offer-includes b { font-size: 11px !important; }
.offer-help > span,
.offer-help p,
.offer-help a,
.offer-help--secondary strong { font-size: 12.5px !important; line-height: 1.55 !important; }

/* Work / proof */
.work-copy p { font-size: 15px !important; }
.work-scope { font-size: 11.5px !important; line-height: 1.55 !important; }
.work-link { font-size: 11.5px !important; }
.work-case-copy p { font-size: 13px !important; line-height: 1.6 !important; }

/* Team */
.team-members--text-only .team-member-role { font-size: 11px !important; line-height: 1.35 !important; }
.team-members--text-only .team-member p { font-size: 14px !important; line-height: 1.65 !important; }

/* Form */
.scan-card label { font-size: 11px !important; }
.form-options button,
.form-options--v6 button span { font-size: 13px !important; }
.scan-card--v6 textarea { font-size: 15px !important; }
.form-back { font-size: 11px !important; }
.scan-selected span,
.scan-selected strong,
.scan-selected small { font-size: 11.5px !important; }

/* FAQ + final CTA */
.faq-list-v14 summary { font-size: 14px !important; }
.faq-list-v14 details > p { font-size: 14px !important; line-height: 1.7 !important; }
.final-cta-v14 p { font-size: 15px !important; line-height: 1.7 !important; }

/* Footer */
.site-footer,
.footer-column,
.footer-formal { font-size: 13px; }
.site-footer a { font-size: 13px; line-height: 1.5; }
footer p { font-size: 13.5px !important; }
footer > span { font-size: 11px !important; }

@media (max-width: 820px) {
  body { font-size: 15px; }
  p { font-size: 15px !important; }
  .header nav a { font-size: 13px !important; }
  .hero-lead { font-size: 15px !important; }
  .story--fixed-narrative .executive-map-nav button b { font-size: 11px !important; }
  .story--fixed-narrative .strategy-story-card--zone p,
  .story--fixed-narrative .strategy-story-card--hero p { font-size: 15px !important; }
}

/* =========================================================
   V17 — premium hero polish: stronger contrast, richer background,
   subtle map-line texture, clearer typography and elevated narrative.
   ========================================================= */

.story--strategy-map.story--fixed-narrative,
.story--fixed-narrative .story-canvas-wrap {
  background:
    radial-gradient(circle at 18% 18%, rgba(255,255,255,.95) 0%, rgba(255,255,255,0) 28%),
    radial-gradient(circle at 82% 16%, rgba(223,118,95,.08) 0%, rgba(223,118,95,0) 22%),
    linear-gradient(135deg, #f7f2eb 0%, #efe6dc 46%, #f7f2eb 100%) !important;
}

.story--fixed-narrative .story-canvas-wrap {
  overflow: hidden;
  isolation: isolate;
}

.story--fixed-narrative .story-canvas-wrap::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: .72;
  background:
    radial-gradient(circle at 82% 12%, transparent 0 38px, rgba(198,146,115,.24) 38px 41px, transparent 41px 64px, rgba(198,146,115,.13) 64px 66px, transparent 66px),
    radial-gradient(circle at 87% 17%, transparent 0 66px, rgba(198,146,115,.10) 66px 68px, transparent 68px 96px, rgba(198,146,115,.08) 96px 98px, transparent 98px),
    radial-gradient(circle at 13% 82%, transparent 0 56px, rgba(157,54,91,.10) 56px 58px, transparent 58px 86px, rgba(223,118,95,.09) 86px 88px, transparent 88px),
    linear-gradient(90deg, rgba(248,244,238,.95) 0%, rgba(248,244,238,.84) 22%, rgba(248,244,238,.42) 39%, rgba(248,244,238,.10) 52%, rgba(248,244,238,0) 64%),
    repeating-linear-gradient(120deg, rgba(177,155,137,.065) 0 1px, transparent 1px 26px),
    repeating-linear-gradient(0deg, rgba(255,255,255,.18) 0 1px, transparent 1px 120px);
}

.story--fixed-narrative .living-map--executive {
  background:
    radial-gradient(circle at 70% 38%, rgba(255,255,255,.93) 0%, rgba(250,246,240,.74) 29%, rgba(239,231,220,.15) 57%, transparent 72%),
    radial-gradient(circle at 54% 74%, rgba(190,148,119,.16), transparent 34%),
    linear-gradient(135deg, #f6f0e8 0%, #ebe1d4 44%, #f7f3ed 100%) !important;
}

.story--fixed-narrative .living-map--executive::before {
  background: linear-gradient(90deg,
    rgba(247,242,234,.96) 0%,
    rgba(247,242,234,.90) 18%,
    rgba(247,242,234,.68) 30%,
    rgba(247,242,234,.24) 41%,
    rgba(247,242,234,.04) 55%,
    rgba(247,242,234,.10) 100%) !important;
}

.story--fixed-narrative .living-map--executive::after {
  background:
    linear-gradient(0deg, rgba(248,244,238,.14) 0%, transparent 15%, transparent 86%, rgba(255,255,255,.14) 100%),
    repeating-linear-gradient(135deg, rgba(170,144,125,.05) 0 1px, transparent 1px 28px),
    repeating-linear-gradient(90deg, rgba(255,255,255,.06) 0 1px, transparent 1px 160px) !important;
  opacity: .75;
}

.strategy-story-ui {
  width: min(1480px, calc(100% - 56px));
  padding-top: 84px;
}

.strategy-story-card {
  width: min(640px, 44vw);
}

.strategy-story-card--hero {
  padding: 34px 36px 30px;
  border: 1px solid rgba(43,34,28,.10);
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(255,252,247,.88) 0%, rgba(248,243,237,.80) 100%);
  box-shadow: 0 30px 90px rgba(93,72,58,.12), inset 0 1px 0 rgba(255,255,255,.75);
  backdrop-filter: blur(16px);
}

.strategy-story-card--hero .eyebrow {
  color: #9f7456 !important;
  font-size: 11px !important;
  letter-spacing: .18em;
}

.strategy-story-card--hero .hero-title-clean {
  margin: 18px 0 0;
  max-width: 560px !important;
  font-size: clamp(62px, 4.9vw, 86px) !important;
  line-height: .92 !important;
  letter-spacing: -.068em;
  font-weight: 680 !important;
  text-wrap: balance;
}

.strategy-story-card--hero .hero-title-line {
  color: #14110f;
  text-shadow: 0 1px 0 rgba(255,255,255,.35);
}

.strategy-story-card--hero .hero-title-line--accent {
  background: linear-gradient(135deg, #e38b68 0%, #cb5a72 58%, #92274a 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.strategy-story-card--hero .hero-lead {
  max-width: 560px;
  margin-top: 22px;
  color: #544c46 !important;
  font-size: 17px !important;
  line-height: 1.68;
}

.strategy-story-card--hero .hero-actions {
  margin-top: 24px;
}

.strategy-story-card--hero .button--dark {
  box-shadow: 0 12px 28px rgba(21,17,15,.14);
}

.strategy-story-card--hero .button--ghost {
  background: rgba(255,255,255,.58) !important;
}

.strategy-story-card--hero .micro-proof {
  margin-top: 18px;
  color: #6c635c !important;
}

.strategy-story-card--hero .micro-proof span {
  background: rgba(255,255,255,.44);
}

.strategy-story-card--zone {
  padding: 30px 32px 28px 34px;
  border: 1px solid rgba(44,35,29,.11);
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(255,252,247,.90) 0%, rgba(248,243,237,.86) 100%);
  box-shadow: 0 28px 85px rgba(89,67,53,.14);
}

.strategy-story-card--zone h2 {
  margin: 16px 0 16px;
  max-width: 560px;
  font: 650 clamp(42px, 3.9vw, 64px)/.95 var(--display);
  letter-spacing: -.058em;
  text-wrap: balance;
}

.strategy-story-card--zone p {
  max-width: 520px;
  font-size: 15px !important;
  line-height: 1.68 !important;
}

.story--fixed-narrative .map-inspector {
  right: 34px;
  bottom: 126px;
  top: auto;
  width: min(360px, 25vw);
  min-height: 190px;
  padding: 22px 22px 20px;
  border-radius: 20px;
  background: linear-gradient(180deg, rgba(255,252,247,.92) 0%, rgba(247,241,233,.88) 100%);
  box-shadow: 0 26px 78px rgba(89,66,54,.14);
}

.story--fixed-narrative .map-inspector__top {
  margin-bottom: 16px;
  padding-bottom: 13px;
}

.story--fixed-narrative .map-inspector__top small {
  font-size: 12px !important;
  letter-spacing: .16em;
}

.story--fixed-narrative .map-inspector strong {
  font-size: 28px !important;
  line-height: .98;
  letter-spacing: -.04em;
}

.story--fixed-narrative .map-inspector p {
  margin: 12px 0 14px;
  color: #5d554f;
  font-size: 16px !important;
  line-height: 1.6 !important;
}

.story--fixed-narrative .map-inspector > div:last-child {
  font-size: 13px !important;
  line-height: 1.55;
}

.executive-map-nav {
  bottom: 26px;
  padding: 8px;
  border-radius: 24px;
  background: rgba(255,252,247,.86);
  border: 1px solid rgba(43,35,29,.10);
  box-shadow: 0 20px 54px rgba(88,67,54,.10);
}

.executive-map-nav button {
  min-width: 150px;
  padding: 16px 20px 15px;
  border-radius: 18px;
  color: #655d57;
}

.executive-map-nav button b {
  font-size: 12.5px !important;
  line-height: 1.25 !important;
  letter-spacing: .015em;
}

.executive-map-nav button:hover {
  color: #1a1512;
  background: rgba(255,255,255,.72);
}

.executive-map-nav button.active {
  background: linear-gradient(135deg,#241f1c 0%, #40312d 52%, #7b3651 100%);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 12px 24px rgba(123,54,81,.14);
}

.living-map--executive canvas {
  filter: saturate(1.08) contrast(1.03) brightness(1.01);
}

@media (max-width: 1180px) {
  .strategy-story-card,
  .strategy-story-card--hero,
  .strategy-story-card--zone {
    width: min(620px, 48vw);
  }

  .strategy-story-card--hero .hero-title-clean {
    max-width: 520px !important;
    font-size: clamp(56px, 5.2vw, 74px) !important;
  }

  .story--fixed-narrative .map-inspector {
    width: 320px;
    bottom: 112px;
  }
}

@media (max-width: 820px) {
  .story--fixed-narrative .story-canvas-wrap::before { opacity: .56; }

  .strategy-story-ui {
    width: calc(100% - 28px);
    align-items: flex-start;
    padding-top: 92px;
  }

  .strategy-story-card {
    width: min(100%, 96vw);
  }

  .strategy-story-card--hero,
  .strategy-story-card--zone {
    padding: 22px 20px 20px;
    border-radius: 20px;
  }

  .strategy-story-card--hero .hero-title-clean {
    max-width: 100% !important;
    font-size: clamp(48px, 12vw, 64px) !important;
  }

  .strategy-story-card--hero .hero-title-line {
    white-space: normal;
  }

  .strategy-story-card--hero .hero-lead,
  .strategy-story-card--zone p {
    font-size: 15px !important;
  }

  .story--fixed-narrative .map-inspector {
    display: none;
  }

  .executive-map-nav {
    left: 12px;
    right: 12px;
    bottom: 12px;
    max-width: calc(100vw - 24px);
    overflow-x: auto;
    justify-content: flex-start;
    border-radius: 16px;
  }

  .executive-map-nav button {
    min-width: 132px;
    padding: 14px 16px;
  }

  .executive-map-nav button b {
    font-size: 11.5px !important;
  }
}

/* =========================================================
   V18 — final polish based on review notes
   ========================================================= */

/* HERO: stronger copy, trust image, cleaner premium composition */
.strategy-story-card--hero {
  display: grid;
  gap: 0;
}

.strategy-story-card--hero .hero-title-clean {
  font-family: var(--display);
  font-weight: 620 !important;
}

.hero-trust-photo {
  display: grid;
  grid-template-columns: 164px 1fr;
  gap: 14px;
  align-items: center;
  margin-top: 20px;
  padding: 12px;
  border-radius: 20px;
  border: 1px solid rgba(43,34,28,.10);
  background: rgba(255,255,255,.58);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.68);
}

.hero-trust-photo img {
  width: 100%;
  height: 122px;
  border-radius: 14px;
  object-fit: cover;
  display: block;
}

.hero-trust-photo-copy {
  display: grid;
  gap: 8px;
}

.hero-trust-photo-copy span {
  color: #9f7456;
  font: 800 10px/1 var(--body);
  letter-spacing: .16em;
}

.hero-trust-photo-copy strong {
  color: #191512;
  font: 560 18px/1.4 var(--display);
  letter-spacing: -.02em;
}

/* sample map / diagnosis readability */
.evidence-detail {
  grid-template-columns: 1fr auto !important;
  align-items: start;
}

.evidence-detail span {
  grid-column: 1;
  grid-row: 1;
}

.evidence-detail .confidence-pill,
.evidence-detail b {
  grid-column: 2;
  grid-row: 1;
  justify-self: end;
  margin: 0;
}

.evidence-detail p {
  grid-column: 1 / -1 !important;
  grid-row: 2;
  max-width: 100%;
  font-size: 16px !important;
  line-height: 1.72 !important;
}

.diagnosis-ui--interactive .evidence-row strong,
.diagnosis-ui--interactive .evidence-browser-main p,
.diagnosis-ui--interactive .journey-stage p,
.diagnosis-ui--interactive .plan-grid p,
.diagnosis-ui--interactive .decision-output strong {
  font-size: 15px !important;
  line-height: 1.62 !important;
}

.diagnosis-ui--interactive .priority-copy p,
.diagnosis-ui--interactive .view-intro p,
.diagnosis-ui--interactive .evidence-browser-main h4 {
  font-size: 16px;
  line-height: 1.68;
}

.diagnosis-ui--interactive .priority-copy h3,
.diagnosis-ui--interactive .view-intro h3 {
  text-wrap: balance;
}

.diagnosis-ui--interactive .evidence-browser-main {
  padding: 28px 26px;
}

/* why digitalmap cards */
.principle-grid--cards {
  gap: 18px;
}

.principle-grid--cards article {
  min-height: 320px;
  padding: 26px 24px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.principle-grid--cards article > div span {
  font-size: 11px;
}

.principle-grid--cards h3 {
  max-width: 14ch;
  margin-top: 28px;
  margin-bottom: 18px;
  font-size: clamp(32px, 3vw, 48px);
}

.principle-grid--cards p {
  font-size: 17px !important;
  line-height: 1.72 !important;
  color: #5f5852 !important;
}

/* industries cards centered, no numbering */
.industry-grid {
  gap: 14px;
}

.industry-grid article {
  min-height: 168px;
  padding: 24px;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.industry-grid h3 {
  margin: 0 0 10px;
  font-size: clamp(32px, 2.6vw, 42px);
}

.industry-grid p {
  margin: 0;
  font-size: 13px;
  letter-spacing: .14em;
}

/* offer — less AI-slop, clearer product layout */
.offer-selector button {
  min-height: 104px;
}

.offer-selector button strong {
  font-size: 24px;
}

.offer-selector button small,
.offer-cost-note,
.offer-help p,
.offer-help--secondary strong {
  font-size: 14px !important;
  line-height: 1.7 !important;
}

.offer-focus-card {
  min-height: 0;
  padding: 34px;
}

.offer-focus-title {
  gap: 20px;
  align-items: end;
}

.offer-focus-title h3 {
  font-size: clamp(56px, 5vw, 84px);
  line-height: .92;
  letter-spacing: -.065em;
  text-wrap: balance;
}

.offer-focus-title p {
  max-width: 840px;
  font-size: 17px;
  line-height: 1.7;
}

.offer-focus-title > strong {
  font-size: clamp(42px, 4vw, 64px);
  white-space: nowrap;
}

.offer-fit-grid {
  margin-top: 28px;
  gap: 0;
  border: 1px solid rgba(18,17,16,.10);
  border-radius: 20px;
  overflow: hidden;
}

.offer-fit-grid > div {
  padding: 20px 18px;
  background: rgba(255,255,255,.62);
}

.offer-fit-grid > div strong {
  font-size: 17px;
  line-height: 1.62;
}

.offer-deliverables {
  margin-top: 28px;
}

.offer-deliverables > span {
  display: block;
  margin-bottom: 14px;
  color: var(--wine);
  font: 800 12px/1 var(--body);
  letter-spacing: .16em;
}

.offer-deliverables-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.offer-deliverable {
  min-height: 76px;
  padding: 16px 16px 15px;
  border: 1px solid rgba(18,17,16,.10);
  border-radius: 16px;
  background: rgba(255,255,255,.72);
  display: flex;
  align-items: center;
  gap: 12px;
}

.offer-deliverable i {
  flex: none;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(165,46,85,.10);
  color: var(--wine);
  font-style: normal;
  font-weight: 900;
}

.offer-deliverable strong {
  color: #231d1a;
  font-size: 16px;
  line-height: 1.5;
  font-weight: 650;
}

.offer-value-anchor {
  margin-top: 18px;
  padding: 18px 20px;
  font-size: 16px;
  line-height: 1.62;
}

.offer-cta-row {
  margin-top: 22px;
  display: grid;
  gap: 10px;
}

.offer-cta-row small {
  color: #776e67;
  font-size: 14px;
  line-height: 1.6;
}

.offer-main-cta {
  min-height: 62px;
  font-size: 16px;
}

/* work / realizacje readability */
.browser-page {
  color: #13100e;
  background: linear-gradient(180deg, #f7f4ef 0%, #f3ede5 100%);
}

.browser-kicker {
  color: #9c3158;
  font-size: 11px;
}

.browser-page strong {
  max-width: 10ch;
  color: #13100e;
}

.browser-lines i {
  background: #c7bdb4;
}

.work-copy p,
.work-case-copy p,
.work-scope,
.work-link--muted {
  font-size: 15px !important;
  line-height: 1.7 !important;
}

.work-copy p {
  color: rgba(255,255,255,.76);
}

.work-case-copy p {
  color: rgba(255,255,255,.84);
}

.work-link {
  font-size: 14px;
}

.work-link--muted {
  color: rgba(255,255,255,.72);
}

/* FAQ clarity */
.faq-heading h2 {
  text-wrap: balance;
}

.faq-heading p {
  font-size: 18px;
  line-height: 1.68;
}

.faq-list-v14 {
  gap: 0;
  border-top: 0;
}

.faq-list-v14 details {
  min-height: 0;
  background: rgba(255,255,255,.58);
}

.faq-list-v14 summary {
  min-height: 88px;
  padding: 24px 24px;
  font-size: 18px;
  line-height: 1.45;
}

.faq-list-v14 summary i {
  font-size: 24px;
}

.faq-list-v14 details > p {
  margin: -4px 24px 26px;
  font-size: 16px;
  line-height: 1.75;
}

/* final CTA button polish */
.final-cta-v14 {
  gap: 44px;
}

.final-cta-v14 p {
  font-size: 16px;
  line-height: 1.72;
}

.final-cta-actions {
  gap: 12px;
  align-self: stretch;
}

.final-cta-actions .button {
  min-height: 60px;
  font-size: 16px;
  border-radius: 14px;
}

.final-cta-v14 .button--ghost.final-cta-alt {
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.18);
  color: #fff;
}

.final-cta-v14 .button--ghost.final-cta-alt:hover {
  background: rgba(255,255,255,.12);
}

/* form copy + CTA */
.scan-copy p,
.field-help,
.scan-card--v6 small {
  font-size: 16px !important;
  line-height: 1.7 !important;
}

.scan-card--v6 h3 {
  max-width: 13ch;
  text-wrap: balance;
}

.scan-card--v6 label {
  font-size: 13px;
}

.scan-card--v6 input,
.scan-card--v6 textarea {
  font-size: 18px !important;
}

.scan-card--v6 button[type="submit"] {
  min-height: 62px;
  font-size: 16px;
  border-radius: 14px;
}

@media (max-width: 1020px) {
  .offer-deliverables-grid {
    grid-template-columns: 1fr;
  }

  .hero-trust-photo {
    grid-template-columns: 1fr;
  }

  .hero-trust-photo img {
    height: 170px;
  }
}

@media (max-width: 760px) {
  .hero-trust-photo-copy strong {
    font-size: 16px;
  }

  .offer-focus-card {
    padding: 24px 18px;
  }

  .offer-focus-title h3 {
    font-size: clamp(42px, 10vw, 56px);
  }

  .faq-list-v14 summary {
    font-size: 16px;
    min-height: 74px;
  }

  .faq-list-v14 details > p,
  .work-copy p,
  .work-case-copy p,
  .scan-copy p,
  .field-help {
    font-size: 15px !important;
  }
}

/* work cards switched to consistent premium dark surfaces */
.work-card {
  background: linear-gradient(180deg, rgba(25,20,18,.98) 0%, rgba(19,16,14,.98) 100%) !important;
  border-color: rgba(255,255,255,.08) !important;
  box-shadow: 0 24px 70px rgba(0,0,0,.22) !important;
}

.work-copy h3,
.work-link,
.work-card .work-type,
.work-card .work-index,
.work-card .work-scope {
  color: #fff;
}

.work-card .work-type {
  color: rgba(255,255,255,.52);
}

.work-card .work-scope {
  color: rgba(255,255,255,.48);
}

/* =========================================================
   V19 — hero photo background rework
   ========================================================= */

.strategy-story-ui {
  width: min(1520px, calc(100% - 56px));
}

.strategy-story-card {
  width: min(760px, 52vw);
}

.strategy-story-card--hero {
  position: relative;
  width: min(820px, 56vw);
  min-height: 650px;
  padding: 42px 40px 34px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
  border-radius: 34px;
  overflow: hidden;
  isolation: isolate;
  border: 1px solid rgba(255,255,255,.18);
  background:
    linear-gradient(115deg, rgba(16,12,10,.72) 0%, rgba(16,12,10,.50) 36%, rgba(16,12,10,.22) 66%, rgba(16,12,10,.10) 100%),
    linear-gradient(180deg, rgba(16,12,10,.18) 0%, rgba(16,12,10,.58) 100%),
    url('https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=1600') center center / cover no-repeat;
  box-shadow: 0 34px 90px rgba(49,32,23,.18);
}

.strategy-story-card--hero::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 78% 20%, rgba(255,255,255,.22), transparent 24%),
    linear-gradient(90deg, rgba(8,7,7,.42) 0%, rgba(8,7,7,.16) 44%, rgba(8,7,7,0) 74%);
}

.strategy-story-card--hero::after {
  content: '';
  position: absolute;
  left: 28px;
  right: 28px;
  bottom: 26px;
  height: 1px;
  background: linear-gradient(90deg, rgba(255,255,255,.26), rgba(255,255,255,0));
