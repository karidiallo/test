    padding-left: 22px !important;
  }

  .story--fixed-narrative .strategy-story-card--hero .micro-proof {
    margin-left: 0 !important;
    margin-top: 20px !important;
  }
}


/* v35 hero proof + CTA polish */
.story--fixed-narrative .strategy-story-card--hero .hero-actions {
  gap: 14px !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions .button--hero-secondary {
  color: #fffaf6 !important;
  border: 1px solid rgba(238, 112, 133, 0.28) !important;
  background: linear-gradient(135deg, rgba(238, 133, 108, 0.96), rgba(213, 62, 122, 0.96)) !important;
  box-shadow: 0 16px 30px rgba(217, 90, 120, 0.22) !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions .button--hero-secondary:hover {
  transform: translateY(-1px);
  box-shadow: 0 18px 34px rgba(217, 90, 120, 0.28) !important;
}

