}

.story--fixed-narrative .strategy-story-ui--zone .strategy-story-card--zone h2 {
  max-width: 12ch !important;
  margin: 14px 0 15px !important;
  font-size: clamp(40px, 3vw, 54px) !important;
}

.story--fixed-narrative .strategy-story-ui--zone .strategy-story-card--zone p {
  max-width: 44ch !important;
  font-size: 16px !important;
  line-height: 1.65 !important;
}

.story--fixed-narrative .strategy-story-ui--zone .strategy-zone-proof {
  margin-top: 18px !important;
  font-size: 12px !important;
}

/* Keep bottom stage navigator below the content rather than visually merging with it. */
.story--fixed-narrative .executive-map-nav {
