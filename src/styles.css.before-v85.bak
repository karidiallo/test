  background: linear-gradient(90deg,
    rgba(248,244,238,.98) 0%,
    rgba(248,244,238,.94) 54%,
    rgba(248,244,238,.62) 76%,
    rgba(248,244,238,0) 100%);
}

/* Hero should fit in a laptop viewport without swallowing the map. */
.story--fixed-narrative .strategy-story-ui {
