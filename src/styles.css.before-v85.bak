}

.story--fixed-narrative .strategy-zone-cta {
  min-height: 52px !important;
  padding: 0 18px !important;
  border-radius: 12px !important;
  background: #191512 !important;
  color: #fff !important;
  box-shadow: 0 14px 30px rgba(21,16,14,.12) !important;
  font-size: 13px !important;
  white-space: nowrap;
}

.story--fixed-narrative .strategy-zone-cta:hover {
  transform: translateY(-2px) !important;
  background: #a8204f !important;
  box-shadow: 0 18px 38px rgba(168,32,79,.18) !important;
}

/* PRODUCT PURCHASE — modern dark footer/action, no white outdated bar */
.offer-cta-row {
  margin-top: 26px !important;
  padding: 24px 0 0 !important;
  border-top: 1px solid rgba(255,255,255,.11) !important;
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 26px;
  align-items: center;
}

.offer-cta-context {
  min-width: 0;
  display: grid;
  gap: 6px;
}

.offer-cta-context > span {
  color: #ed8fa7;
  font-size: 9px;
  line-height: 1;
  font-weight: 850;
  letter-spacing: .16em;
}

.offer-cta-context > strong {
  color: #fffaf6;
  font: 600 22px/1.1 var(--display);
  letter-spacing: -.035em;
}

.offer-cta-context > small {
  color: rgba(255,255,255,.53) !important;
  font-size: 13px !important;
  line-height: 1.5 !important;
}

.offer-main-cta {
  min-width: 230px;
  min-height: 62px !important;
  padding: 0 12px 0 20px !important;
  border-radius: 14px !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: linear-gradient(118deg, #b52353 0%, #db5368 54%, #ec7b67 100%) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  box-shadow: 0 18px 42px rgba(166,30,76,.18) !important;
  text-decoration: none;
  transition: transform .22s ease, box-shadow .22s ease, filter .22s ease !important;
}

.offer-main-cta > span {
  color: #fff !important;
  font-size: 14px !important;
  line-height: 1.15 !important;
  font-weight: 800 !important;
}

