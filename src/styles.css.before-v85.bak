    font-size: 16px !important;
  }
}

/* =========================================================
   V22 — stable full-width hero: photo + premium overlay + transparent map blend
   fixes initial page jump caused by autofocus in the form
   ========================================================= */

/* One continuous hero canvas — photo is the actual hero background */
.story--strategy-map.story--fixed-narrative,
.story--fixed-narrative .story-canvas-wrap {
  background: #eae2d8 !important;
}

.story--fixed-narrative .story-canvas-wrap {
  overflow: hidden !important;
  isolation: isolate;
  background:
    url('https://images.pexels.com/photos/3184465/pexels-photo-3184465.jpeg?auto=compress&cs=tinysrgb&w=1920') center center / cover no-repeat !important;
}

/* premium cinematic overlay: readable copy left, warm transition to map right */
.story--fixed-narrative .story-canvas-wrap::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 1 !important;
  background:
    linear-gradient(90deg,
      rgba(18,14,12,.72) 0%,
      rgba(18,14,12,.58) 18%,
      rgba(18,14,12,.34) 32%,
      rgba(18,14,12,.10) 43%,
      rgba(244,238,230,.12) 51%,
      rgba(244,238,230,.72) 65%,
      rgba(244,238,230,.94) 82%,
      rgba(244,238,230,.98) 100%),
    linear-gradient(180deg,
      rgba(16,12,10,.14) 0%,
      rgba(16,12,10,.02) 42%,
      rgba(16,12,10,.14) 100%),
    radial-gradient(circle at 88% 16%, transparent 0 46px, rgba(193,150,118,.15) 47px 50px, transparent 51px 82px, rgba(193,150,118,.08) 83px 85px, transparent 86px),
    repeating-linear-gradient(125deg, rgba(178,151,130,.035) 0 1px, transparent 1px 34px);
}

/* remove previous photo pseudo layer — there must be only one photo layer */
.story--fixed-narrative .story-canvas-wrap::after {
  display: none !important;
}

/* LivingMap itself is transparent. Only WebGL objects are visible. */
.story--fixed-narrative .living-map--executive {
  position: absolute !important;
  inset: 0 !important;
  z-index: 2 !important;
  background: transparent !important;
  pointer-events: auto;
}

.story--fixed-narrative .living-map--executive::before,
.story--fixed-narrative .living-map--executive::after {
  display: none !important;
}

/* Fade the 3D scene in from the centre instead of letting it cover the photo. */
.story--fixed-narrative .living-map--executive canvas {
  opacity: 1 !important;
  transform: translateX(4%) scale(.98) !important;
  transform-origin: center center;
  filter: saturate(1.04) contrast(1.03) brightness(1.02) !important;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 27%, rgba(0,0,0,.15) 36%, rgba(0,0,0,.72) 46%, #000 57%, #000 100%);
  mask-image: linear-gradient(90deg, transparent 0%, transparent 27%, rgba(0,0,0,.15) 36%, rgba(0,0,0,.72) 46%, #000 57%, #000 100%);
}

/* Narrative stays on the same full-width scene, never boxed. */
.story--fixed-narrative .strategy-story-ui {
  z-index: 6 !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  left: 0 !important;
  right: 0 !important;
  padding: 108px clamp(38px, 5vw, 92px) 116px !important;
  justify-content: flex-start !important;
  align-items: center !important;
}

.story--fixed-narrative .strategy-story-card--hero {
  width: min(760px, 45vw) !important;
  min-height: calc(100vh - 190px);
  padding: 0 !important;
  display: flex !important;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  overflow: visible !important;
}

.story--fixed-narrative .strategy-story-card--hero::before,
.story--fixed-narrative .strategy-story-card--hero::after {
  display: none !important;
}

.story--fixed-narrative .strategy-story-card--hero .eyebrow {
  margin-bottom: 18px;
  color: rgba(255,231,214,.94) !important;
  font-size: 11px !important;
  letter-spacing: .18em;
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
  max-width: 10.2ch !important;
  margin: 0 !important;
  font-size: clamp(68px, 5.6vw, 102px) !important;
  line-height: .90 !important;
  letter-spacing: -.078em;
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-line {
  color: #fffaf5 !important;
  text-shadow: 0 5px 30px rgba(0,0,0,.18);
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-line--accent {
  background: linear-gradient(135deg, #f0a080 0%, #e46b76 54%, #be315a 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent !important;
  -webkit-text-fill-color: transparent;
}

.story--fixed-narrative .strategy-story-card--hero .hero-lead {
  max-width: 34ch !important;
  margin-top: 24px !important;
  color: rgba(255,248,242,.95) !important;
  font-size: 18px !important;
  line-height: 1.70 !important;
  text-shadow: 0 2px 18px rgba(0,0,0,.14);
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions {
  margin-top: 26px !important;
}

.story--fixed-narrative .strategy-story-card--hero .button--dark {
  background: #fffaf5 !important;
  color: #17120f !important;
  box-shadow: 0 15px 36px rgba(0,0,0,.18) !important;
}

.story--fixed-narrative .strategy-story-card--hero .button--ghost {
  background: rgba(255,255,255,.10) !important;
  border-color: rgba(255,255,255,.28) !important;
  color: #fffaf5 !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof {
  margin-top: 24px !important;
  gap: 9px;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span {
  padding: 8px 11px !important;
  border: 1px solid rgba(255,255,255,.13) !important;
  border-right: 1px solid rgba(255,255,255,.13) !important;
  border-radius: 999px;
  background: rgba(255,255,255,.09) !important;
  color: rgba(255,248,242,.92) !important;
  backdrop-filter: blur(8px);
}

/* Header belongs to the hero, not a detached white box. */
.header {
  top: 18px !important;
  background: rgba(248,245,240,.66) !important;
  border-color: rgba(255,255,255,.42) !important;
  box-shadow: 0 16px 44px rgba(29,21,17,.10) !important;
  backdrop-filter: blur(20px) saturate(1.05) !important;
}

/* Keep the journey navigator readable without obscuring the scene. */
.story--fixed-narrative .executive-map-nav {
  z-index: 8 !important;
  bottom: 24px !important;
  background: rgba(251,247,242,.90) !important;
  border: 1px solid rgba(48,37,30,.10) !important;
  box-shadow: 0 18px 52px rgba(57,41,32,.10) !important;
}

/* Inspector stays in the map half. */
.story--fixed-narrative .map-inspector {
  z-index: 8 !important;
  right: clamp(22px, 3vw, 48px) !important;
  bottom: 126px !important;
  top: auto !important;
}

@media (max-width: 1180px) {
  .story--fixed-narrative .living-map--executive canvas {
    transform: translateX(8%) scale(.97) !important;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 24%, rgba(0,0,0,.22) 35%, rgba(0,0,0,.78) 47%, #000 58%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 24%, rgba(0,0,0,.22) 35%, rgba(0,0,0,.78) 47%, #000 58%, #000 100%);
  }

  .story--fixed-narrative .strategy-story-card--hero {
    width: min(680px, 48vw) !important;
  }

  .story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
    font-size: clamp(58px, 5.4vw, 84px) !important;
  }
}

@media (max-width: 820px) {
  .story--fixed-narrative .story-canvas-wrap {
    background-position: center top !important;
  }

  .story--fixed-narrative .story-canvas-wrap::before {
    background:
      linear-gradient(180deg,
        rgba(18,14,12,.66) 0%,
        rgba(18,14,12,.48) 22%,
        rgba(18,14,12,.16) 42%,
        rgba(244,238,230,.12) 56%,
        rgba(244,238,230,.82) 72%,
        rgba(244,238,230,.98) 100%),
      repeating-linear-gradient(125deg, rgba(178,151,130,.03) 0 1px, transparent 1px 34px);
  }

  .story--fixed-narrative .living-map--executive canvas {
    transform: translateY(20%) scale(.92) !important;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 30%, rgba(0,0,0,.28) 42%, rgba(0,0,0,.82) 54%, #000 66%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, transparent 30%, rgba(0,0,0,.28) 42%, rgba(0,0,0,.82) 54%, #000 66%, #000 100%);
  }

  .story--fixed-narrative .strategy-story-ui {
    padding: 92px 18px 110px !important;
    align-items: flex-start !important;
  }

  .story--fixed-narrative .strategy-story-card--hero {
    width: 100% !important;
    min-height: auto;
    padding-top: 12px !important;
  }

  .story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
    max-width: 100% !important;
    font-size: clamp(48px, 12vw, 66px) !important;
  }

  .story--fixed-narrative .strategy-story-card--hero .hero-lead {
    max-width: 100% !important;
    font-size: 16px !important;
  }
}

/* =========================================================
   V27 — actual layout + 3D map rework
   ========================================================= */

/* remove stock-photo hero and let the interactive map be the visual */
.story--strategy-map.story--fixed-narrative,
.story--fixed-narrative .story-canvas-wrap {
  background:
    radial-gradient(circle at 16% 22%, rgba(255,255,255,.84), transparent 28%),
    radial-gradient(circle at 82% 18%, rgba(217,174,140,.16), transparent 20%),
    linear-gradient(135deg, #f7f2eb 0%, #eee5dc 48%, #f8f4ef 100%) !important;
}

.story--fixed-narrative .story-canvas-wrap {
  overflow: hidden !important;
  isolation: isolate;
}

.story--fixed-narrative .story-canvas-wrap::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 1 !important;
  background:
    radial-gradient(circle at 82% 12%, transparent 0 44px, rgba(191,145,111,.18) 45px 48px, transparent 49px 80px, rgba(191,145,111,.08) 81px 83px, transparent 84px),
    linear-gradient(90deg, rgba(255,255,255,.48) 0%, rgba(255,255,255,.18) 36%, rgba(255,255,255,0) 54%),
    repeating-linear-gradient(120deg, rgba(168,145,125,.055) 0 1px, transparent 1px 30px),
    repeating-linear-gradient(0deg, rgba(255,255,255,.16) 0 1px, transparent 1px 116px);
}

.story--fixed-narrative .story-canvas-wrap::after { display: none !important; }

.story--fixed-narrative .living-map--executive {
  position: absolute !important;
  inset: 0 !important;
  z-index: 2 !important;
  background: transparent !important;
  pointer-events: auto;
}

.story--fixed-narrative .living-map--executive::before,
.story--fixed-narrative .living-map--executive::after { display: none !important; }

.story--fixed-narrative .living-map--executive canvas {
  opacity: 1 !important;
  transform: translateX(9%) scale(.96) !important;
  transform-origin: center center;
  filter: saturate(1.04) contrast(1.025) brightness(1.02) !important;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 22%, rgba(0,0,0,.24) 31%, rgba(0,0,0,.78) 40%, #000 49%, #000 100%);
  mask-image: linear-gradient(90deg, transparent 0%, transparent 22%, rgba(0,0,0,.24) 31%, rgba(0,0,0,.78) 40%, #000 49%, #000 100%);
}

.story--fixed-narrative .strategy-story-ui {
  z-index: 7 !important;
  width: 100% !important;
  max-width: none !important;
  padding: 112px clamp(34px, 4.2vw, 76px) 116px !important;
  align-items: center !important;
  justify-content: flex-start !important;
}

/* architectural hero card */
.story--fixed-narrative .strategy-story-card--hero {
  position: relative;
  width: min(590px, 37vw) !important;
  min-height: 610px !important;
  padding: 34px 36px 30px !important;
  display: flex !important;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  overflow: visible !important;
  color: #fff;
  border: 1px solid rgba(255,255,255,.12) !important;
  border-left: 3px solid rgba(226,109,119,.90) !important;
  border-radius: 10px 30px 30px 10px !important;
  background:
    linear-gradient(90deg, rgba(255,255,255,.034) 0 1px, transparent 1px 76px),
    linear-gradient(180deg, rgba(255,255,255,.025) 0 1px, transparent 1px 76px),
    linear-gradient(145deg, rgba(34,28,25,.96) 0%, rgba(21,18,16,.98) 62%, rgba(31,23,22,.98) 100%) !important;
  background-size: 76px 76px, 76px 76px, auto !important;
  box-shadow: 0 34px 84px rgba(46,33,26,.16), inset 0 1px 0 rgba(255,255,255,.06) !important;
  backdrop-filter: blur(18px) !important;
}

.story--fixed-narrative .strategy-story-card--hero::before {
  content: '' !important;
  display: block !important;
  position: absolute;
  left: 18px;
  right: 8px;
  bottom: -17px;
  height: 20px;
  z-index: -1;
  border-radius: 0 0 24px 6px;
  background: linear-gradient(90deg, #b8a99c 0%, #e9ded4 56%, #bda99a 100%);
  transform: skewX(-18deg);
  box-shadow: 0 17px 28px rgba(52,38,29,.10);
}

.story--fixed-narrative .strategy-story-card--hero::after {
  content: '' !important;
  display: block !important;
  position: absolute;
  top: 10px;
  right: -11px;
  width: 11px;
  height: calc(100% - 18px);
  background: linear-gradient(180deg, rgba(188,150,125,.46), rgba(73,52,44,.54));
  clip-path: polygon(0 0,100% 4%,100% 96%,0 100%);
  opacity: .86 !important;
}

.story--fixed-narrative .strategy-story-card--hero .eyebrow {
  color: rgba(255,226,208,.78) !important;
  font-size: 10px !important;
  letter-spacing: .19em !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
  max-width: 10.4ch !important;
  margin: 18px 0 0 !important;
  font-size: clamp(52px, 4.2vw, 74px) !important;
  line-height: .91 !important;
  letter-spacing: -.073em !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-line {
  color: #fffaf6 !important;
  text-shadow: 0 2px 18px rgba(0,0,0,.15);
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-line--accent {
  background: linear-gradient(135deg, #f2a482 0%, #e96f76 54%, #c8345f 100%) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-lead {
  max-width: 36ch !important;
  margin-top: 21px !important;
  color: rgba(255,248,243,.84) !important;
  font-size: 17px !important;
  line-height: 1.7 !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions { margin-top: 23px !important; }
.story--fixed-narrative .strategy-story-card--hero .button { min-height: 49px !important; border-radius: 11px !important; }
.story--fixed-narrative .strategy-story-card--hero .button--dark { background: #fffaf5 !important; color: #17120f !important; }
.story--fixed-narrative .strategy-story-card--hero .button--ghost { color: #fffaf5 !important; background: rgba(255,255,255,.07) !important; border-color: rgba(255,255,255,.19) !important; }

.story--fixed-narrative .strategy-story-card--hero .micro-proof {
  margin-top: 17px !important;
  gap: 7px !important;
}
.story--fixed-narrative .strategy-story-card--hero .micro-proof span {
  padding: 7px 10px !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  border-radius: 999px !important;
  background: rgba(255,255,255,.045) !important;
  color: rgba(255,247,240,.76) !important;
  font-size: 9px !important;
}

/* interactive building-facade rail */
.hero-building-nav {
  position: absolute;
  top: 72px;
  right: -128px;
  width: 122px;
  padding: 8px;
  display: grid;
  gap: 5px;
  border: 1px solid rgba(36,29,25,.10);
  border-left: 0;
  border-radius: 0 18px 18px 0;
  background: rgba(250,247,242,.90);
  box-shadow: 18px 22px 46px rgba(50,35,28,.08);
  backdrop-filter: blur(14px);
}

.hero-building-label {
  padding: 8px 9px 7px;
  color: #8d7f75;
  font: 800 7px/1.2 var(--body);
  letter-spacing: .13em;
}

.hero-building-nav button {
  min-height: 54px;
  padding: 8px 9px;
  border: 0;
  border-top: 1px solid rgba(30,24,21,.08);
  background: transparent;
  display: grid;
  grid-template-columns: 20px 1fr 12px;
  align-items: center;
  gap: 7px;
  text-align: left;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}

.hero-building-nav button:hover {
  background: #fff;
  transform: translateX(2px);
}

.hero-building-nav button i {
  color: #b04a68;
  font: 800 8px/1 var(--body);
  font-style: normal;
}
.hero-building-nav button b {
  color: #2a231f;
  font: 750 8px/1.25 var(--body);
  letter-spacing: .02em;
}
.hero-building-nav button em { color: #a99c92; font-style: normal; font-size: 10px; }

/* scroll-stage card keeps same architectural language */
.story--fixed-narrative .strategy-story-card--zone {
  width: min(500px, 31vw) !important;
  padding: 27px 28px 25px 30px !important;
  border-radius: 6px 22px 22px 6px !important;
  border: 1px solid rgba(35,29,25,.10) !important;
  border-left: 3px solid #c84468 !important;
  background: rgba(252,249,245,.92) !important;
  box-shadow: 0 22px 56px rgba(57,43,35,.09) !important;
  backdrop-filter: blur(15px) !important;
}
.story--fixed-narrative .strategy-story-card--zone h2 { font-size: clamp(36px, 3vw, 52px) !important; line-height: .98 !important; }
.story--fixed-narrative .strategy-story-card--zone p { font-size: 16px !important; line-height: 1.67 !important; }

.stage-mini-nav {
  margin-top: 18px;
  padding-top: 14px;
  display: flex;
  gap: 8px;
  border-top: 1px solid rgba(18,17,16,.09);
}
.stage-mini-nav button {
  width: 28px;
  height: 5px;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: #ddd3ca;
  cursor: pointer;
  transition: width .22s ease, background .22s ease;
}
.stage-mini-nav button:hover { background: #c68975; }
.stage-mini-nav button.active { width: 48px; background: linear-gradient(90deg, #df765f, #a52e55); }

/* active/hover label coming from the actual 3D scene */
.map-zone-label {
  width: 168px;
  padding: 10px 11px;
  border: 1px solid rgba(42,33,28,.10);
  border-radius: 10px;
  background: rgba(251,248,244,.92);
  box-shadow: 0 12px 30px rgba(45,32,25,.10);
  backdrop-filter: blur(10px);
  transform: translateY(-4px);
}
.map-zone-label span {
  display: block;
  margin-bottom: 4px;
  color: #a43a5d;
  font: 850 7px/1 var(--body);
  letter-spacing: .12em;
}
.map-zone-label strong {
  display: block;
  color: #29221e;
  font: 650 11px/1.28 var(--body);
}
.map-zone-label.is-active { border-color: rgba(165,46,85,.20); }

/* stronger header */
.header {
  background: rgba(251,248,244,.88) !important;
  border: 1px solid rgba(255,255,255,.60) !important;
  box-shadow: 0 18px 54px rgba(31,23,18,.10), inset 0 1px 0 rgba(255,255,255,.72) !important;
  backdrop-filter: blur(20px) saturate(1.08) !important;
}
.header nav a { color: #302823 !important; font-weight: 620 !important; }
.header-cta { min-height: 46px !important; border-radius: 13px !important; box-shadow: 0 12px 28px rgba(0,0,0,.11) !important; }

/* map UI */
.story--fixed-narrative .executive-map-nav {
  bottom: 24px !important;
  padding: 5px !important;
  border-radius: 15px !important;
  background: rgba(251,248,244,.94) !important;
  border: 1px solid rgba(30,24,21,.08) !important;
  box-shadow: 0 18px 48px rgba(45,31,24,.09) !important;
}
.story--fixed-narrative .executive-map-nav button { border-radius: 10px !important; }
.story--fixed-narrative .executive-map-nav button.active {
  background: linear-gradient(135deg,#231e1b 0%,#49342d 60%,#7d3150 100%) !important;
  color: #fff !important;
}
.story--fixed-narrative .map-inspector {
  right: clamp(24px, 3vw, 46px) !important;
  bottom: 116px !important;
  width: min(350px, 23vw) !important;
  border-radius: 16px !important;
  background: rgba(252,249,245,.93) !important;
  box-shadow: 0 22px 58px rgba(45,33,27,.10) !important;
}

/* actual editorial layout replacing generic 3-card block */
.principle-editorial {
  border-top: 1px solid rgba(18,17,16,.12);
  border-bottom: 1px solid rgba(18,17,16,.12);
}
.principle-editorial article {
  min-height: 178px;
  padding: 24px 4px;
  display: grid;
  grid-template-columns: 62px minmax(0, 1fr) 42px;
  gap: 24px;
  align-items: center;
  border-bottom: 1px solid rgba(18,17,16,.10);
  transition: padding .22s ease, background .22s ease;
}
.principle-editorial article:last-child { border-bottom: 0; }
.principle-editorial article:hover { padding-left: 18px; padding-right: 18px; background: rgba(255,255,255,.52); }
.principle-editorial-no { color: #a52e55; font: 850 10px/1 var(--body); letter-spacing: .14em; }
.principle-editorial-copy { display: grid; grid-template-columns: minmax(240px,.7fr) minmax(280px,1.3fr); gap: 42px; align-items: center; }
.principle-editorial h3 { margin: 0; font: 560 clamp(31px,3vw,46px)/.98 var(--display); letter-spacing: -.05em; }
.principle-editorial p { margin: 0; max-width: 720px; color: #655d56; font-size: 16px; line-height: 1.72; }
.principle-editorial article > i { justify-self: end; color: #a89d95; font-style: normal; font-size: 18px; }

/* product selector is a clean index, not a stack of AI cards */
.offer-selector {
  gap: 0 !important;
  border-top: 1px solid rgba(18,17,16,.10);
  border-bottom: 1px solid rgba(18,17,16,.10);
}
.offer-selector button {
  min-height: 92px !important;
  padding: 16px 8px !important;
  border: 0 !important;
  border-bottom: 1px solid rgba(18,17,16,.09) !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  display: grid !important;
  grid-template-columns: minmax(0,1fr) auto !important;
  gap: 18px !important;
}
.offer-selector button:last-child { border-bottom: 0 !important; }
.offer-selector button:hover { transform: none !important; background: rgba(255,255,255,.48) !important; padding-left: 14px !important; }
.offer-selector button.active { background: #191512 !important; color: #fff !important; padding-left: 16px !important; }
.offer-selector-main { min-width: 0; }
.offer-selector-main strong { display: block; font: 560 23px/1 var(--display); letter-spacing: -.035em; }
.offer-selector-main small { display: block; margin-top: 7px; color: #81776f; font-size: 11px; line-height: 1.35; }
.offer-selector button.active .offer-selector-main small { color: rgba(255,255,255,.46); }
.offer-selector-meta { display: flex; align-items: center; gap: 15px; }
.offer-selector-meta b { color: #5d544e; font-size: 12px; }
.offer-selector button.active .offer-selector-meta b { color: rgba(255,255,255,.82); }
.offer-selector-meta i { color: #a59a92; font-style: normal; }

.offer-focus-card {
  border-radius: 22px !important;
  border: 1px solid rgba(18,17,16,.08) !important;
  background: linear-gradient(180deg, #fbf8f4 0%, #f4ede5 100%) !important;
  box-shadow: 0 24px 66px rgba(35,26,20,.08) !important;
}
.offer-deliverable { border-radius: 14px !important; box-shadow: none !important; }

/* industries and work calmer */
.industry-grid { gap: 1px !important; background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.09); border-radius: 18px; overflow: hidden; }
.industry-grid article { min-height: 150px !important; border: 0 !important; border-radius: 0 !important; background: #1a1715 !important; box-shadow: none !important; }
.industry-grid article:hover { transform: none !important; background: #211c19 !important; }

.work-card { border-radius: 20px !important; box-shadow: 0 22px 62px rgba(0,0,0,.16) !important; }
.work-card:hover { transform: translateY(-3px) !important; box-shadow: 0 28px 72px rgba(0,0,0,.20) !important; }

@media (max-width: 1180px) {
  .story--fixed-narrative .strategy-story-ui { padding: 102px 30px 108px !important; }
  .story--fixed-narrative .strategy-story-card--hero { width: min(550px, 43vw) !important; min-height: 580px !important; }
  .story--fixed-narrative .strategy-story-card--hero .hero-title-clean { font-size: clamp(48px,4.5vw,66px) !important; }
  .hero-building-nav { right: -108px; width: 103px; }
  .hero-building-nav button b { font-size: 7px; }
  .principle-editorial-copy { grid-template-columns: 1fr; gap: 12px; }
}

@media (max-width: 820px) {
  .story--fixed-narrative .living-map--executive canvas {
    transform: translateY(20%) scale(.91) !important;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 30%, rgba(0,0,0,.26) 42%, rgba(0,0,0,.82) 55%, #000 68%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, transparent 30%, rgba(0,0,0,.26) 42%, rgba(0,0,0,.82) 55%, #000 68%, #000 100%);
  }
  .story--fixed-narrative .strategy-story-ui { padding: 90px 16px 100px !important; align-items: flex-start !important; }
  .story--fixed-narrative .strategy-story-card--hero,
  .story--fixed-narrative .strategy-story-card--zone { width: 100% !important; min-height: auto !important; border-radius: 20px !important; border-left-width: 1px !important; }
  .story--fixed-narrative .strategy-story-card--hero::before,
  .story--fixed-narrative .strategy-story-card--hero::after { display: none !important; }
  .story--fixed-narrative .strategy-story-card--hero .hero-title-clean { max-width: 100% !important; font-size: clamp(44px,11vw,60px) !important; }
  .hero-building-nav { position: static; width: 100%; margin-top: 18px; border: 1px solid rgba(255,255,255,.10); border-radius: 14px; background: rgba(255,255,255,.05); box-shadow: none; grid-template-columns: repeat(5,1fr); }
  .hero-building-label { grid-column: 1 / -1; color: rgba(255,255,255,.55); }
  .hero-building-nav button { min-height: 48px; grid-template-columns: 1fr; text-align: center; border-top: 1px solid rgba(255,255,255,.08); }
  .hero-building-nav button b { color: #fff; font-size: 6.5px; }
  .hero-building-nav button em { display: none; }
  .principle-editorial article { grid-template-columns: 40px 1fr 24px; gap: 14px; }
  .principle-editorial-copy { grid-template-columns: 1fr; gap: 10px; }
  .principle-editorial h3 { font-size: 30px; }
}

/* =========================================================
   V28 — CLEAN OPEN HERO
   Keep V27 3D campus. Remove boxed hero + side rail.
   ========================================================= */

/* create a quiet editorial reading zone without a visible container */
.story--fixed-narrative .story-canvas-wrap::after {
  content: '' !important;
  display: block !important;
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
  background:
    linear-gradient(90deg,
      rgba(248,244,238,.98) 0%,
      rgba(248,244,238,.96) 15%,
      rgba(248,244,238,.84) 27%,
      rgba(248,244,238,.45) 37%,
      rgba(248,244,238,.12) 46%,
      rgba(248,244,238,0) 56%);
}

/* let the map stay the hero visual, just push it right enough for clean copy */
.story--fixed-narrative .living-map--executive canvas {
  transform: translateX(13%) scale(.98) !important;
  transform-origin: center center !important;
  -webkit-mask-image: linear-gradient(90deg,
    transparent 0%,
    transparent 24%,
    rgba(0,0,0,.16) 31%,
    rgba(0,0,0,.64) 39%,
    #000 47%,
    #000 100%) !important;
  mask-image: linear-gradient(90deg,
    transparent 0%,
    transparent 24%,
    rgba(0,0,0,.16) 31%,
    rgba(0,0,0,.64) 39%,
    #000 47%,
    #000 100%) !important;
}

.story--fixed-narrative .strategy-story-ui {
  z-index: 7 !important;
  padding: 106px clamp(48px, 5.4vw, 96px) 108px !important;
  align-items: center !important;
}

/* no card, no building shell, no border */
.story--fixed-narrative .strategy-story-card--hero {
  position: relative !important;
  width: min(760px, 45vw) !important;
  min-height: auto !important;
  padding: 0 !important;
  margin: 0 !important;
  color: var(--ink) !important;
  border: 0 !important;
  border-left: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  overflow: visible !important;
}

.story--fixed-narrative .strategy-story-card--hero::before,
.story--fixed-narrative .strategy-story-card--hero::after {
  content: none !important;
  display: none !important;
}

.story--fixed-narrative .strategy-story-card--hero .eyebrow {
  margin: 0 0 20px !important;
  color: #92705a !important;
  font-size: 10px !important;
  letter-spacing: .19em !important;
  text-shadow: none !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
  max-width: 12.6ch !important;
  margin: 0 !important;
  font-size: clamp(58px, 5.2vw, 88px) !important;
  line-height: .91 !important;
  letter-spacing: -.075em !important;
  font-weight: 650 !important;
  text-wrap: balance;
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-line {
  color: #171310 !important;
  text-shadow: none !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-title-line--accent {
  background: linear-gradient(135deg, #df846b 0%, #d65370 52%, #9f2f57 100%) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-lead {
  max-width: 43ch !important;
  margin: 24px 0 0 !important;
  color: #5c554f !important;
  font-size: 17px !important;
  line-height: 1.72 !important;
  text-shadow: none !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions {
  margin-top: 27px !important;
  gap: 10px !important;
}

.story--fixed-narrative .strategy-story-card--hero .button {
  min-height: 52px !important;
  border-radius: 12px !important;
  font-size: 12px !important;
}

.story--fixed-narrative .strategy-story-card--hero .button--dark {
  background: #171310 !important;
  color: #fff !important;
  border: 1px solid #171310 !important;
  box-shadow: 0 14px 30px rgba(24,18,14,.12) !important;
}

.story--fixed-narrative .strategy-story-card--hero .button--ghost {
  color: #312a25 !important;
  background: rgba(255,255,255,.54) !important;
  border: 1px solid rgba(24,18,14,.12) !important;
  backdrop-filter: blur(10px) !important;
}

/* make proof points editorial, not AI-chip UI */
.story--fixed-narrative .strategy-story-card--hero .micro-proof {
  margin-top: 22px !important;
  display: flex !important;
  align-items: center !important;
  gap: 0 !important;
  color: #756d66 !important;
  font-size: 10px !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span {
  padding: 0 13px !important;
  border: 0 !important;
  border-right: 1px solid rgba(24,18,14,.13) !important;
  border-radius: 0 !important;
  background: transparent !important;
  color: inherit !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span:first-child {
  padding-left: 0 !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span:last-child {
  border-right: 0 !important;
}

/* explicitly kill the V27 side menu even if old markup is cached temporarily */
.hero-building-nav,
.hero-building-label {
  display: none !important;
}

/* stronger, clean header on the open hero */
.header {
  background: rgba(250,248,244,.91) !important;
  border: 1px solid rgba(37,30,26,.10) !important;
  box-shadow: 0 18px 50px rgba(45,33,27,.09) !important;
  backdrop-filter: blur(20px) saturate(1.08) !important;
}

@media (max-width: 1180px) {
  .story--fixed-narrative .strategy-story-card--hero {
    width: min(680px, 49vw) !important;
  }

  .story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
    font-size: clamp(52px, 5.1vw, 76px) !important;
  }

  .story--fixed-narrative .living-map--executive canvas {
    transform: translateX(16%) scale(.96) !important;
  }
}

@media (max-width: 820px) {
  .story--fixed-narrative .story-canvas-wrap::after {
    background: linear-gradient(180deg,
      rgba(248,244,238,.96) 0%,
      rgba(248,244,238,.90) 30%,
      rgba(248,244,238,.58) 48%,
      rgba(248,244,238,.10) 66%,
      rgba(248,244,238,0) 78%) !important;
  }

  .story--fixed-narrative .strategy-story-ui {
    padding: 90px 20px 98px !important;
    align-items: flex-start !important;
  }

  .story--fixed-narrative .strategy-story-card--hero {
    width: 100% !important;
  }

  .story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
    max-width: 100% !important;
    font-size: clamp(44px, 11vw, 62px) !important;
  }

  .story--fixed-narrative .strategy-story-card--hero .hero-lead {
    max-width: 100% !important;
    font-size: 15px !important;
  }

  .story--fixed-narrative .living-map--executive canvas {
    transform: translateY(13%) scale(.9) !important;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.18) 18%, #000 35%, #000 100%) !important;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.18) 18%, #000 35%, #000 100%) !important;
  }
}

/* =========================================================
   V29 — contrast, product preview, FAQ/CTA and footer polish
   ========================================================= */

:root {
  --accent: linear-gradient(112deg, #f0785f 0%, #e04469 52%, #ad184c 100%);
  --coral: #ee765e;
  --pink: #df3e68;
  --wine: #a7194d;
}

/* stronger, less muddy accent typography */
.accent-text,
.step-copy h1 span,
.story--fixed-narrative .strategy-story-card--zone .accent-text,
.story--fixed-narrative .hero-title-line--accent {
  background: linear-gradient(112deg, #f0785f 0%, #df3f69 50%, #a8174b 100%) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
}

.story--fixed-narrative .strategy-story-card--zone .accent-text,
.principle--v7 h2 .accent-text,
.offer-v6-head h2 .accent-text,
.faq-section h2 .accent-text {
  filter: saturate(1.15) contrast(1.05);
}

/* principle headline: deliberate 2-line lockup */
.principle--v7 h2 {
  max-width: 1080px !important;
  line-height: .90 !important;
}

.principle--v7 h2 .accent-text {
  display: inline-block !important;
  margin-top: .14em;
}

/* smaller industry titles */
.industry-grid h3 {
  font-size: clamp(26px, 2.05vw, 34px) !important;
  line-height: 1 !important;
  letter-spacing: -.035em !important;
}

.industry-grid p {
  font-size: 11px !important;
  letter-spacing: .11em !important;
}

/* product: selected product preview becomes a high-contrast dark panel */
.offer-focus-card {
  background:
    radial-gradient(circle at 86% 8%, rgba(224,68,105,.18), transparent 28%),
    linear-gradient(155deg, #1d1816 0%, #12100f 62%, #191315 100%) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  box-shadow: 0 34px 88px rgba(42,28,23,.22) !important;
}

.offer-focus-top {
  color: #f18ca2 !important;
}

.offer-focus-top b {
  color: #ffdce5 !important;
  background: rgba(224,68,105,.16) !important;
  border: 1px solid rgba(240,139,164,.18);
}

.offer-focus-title h3 {
  color: #fff !important;
}

.offer-focus-title p {
  color: rgba(255,255,255,.68) !important;
}

.offer-focus-title > strong {
  color: #f06f8f !important;
}

.offer-fit-grid {
  border-color: rgba(255,255,255,.10) !important;
  background: rgba(255,255,255,.025);
}

.offer-fit-grid > div {
  background: rgba(255,255,255,.025) !important;
  border-color: rgba(255,255,255,.08) !important;
}

.offer-fit-grid span,
.offer-deliverables > span {
  color: #f08da3 !important;
}

.offer-fit-grid strong {
  color: rgba(255,255,255,.92) !important;
}

.offer-deliverable {
  background: rgba(255,255,255,.055) !important;
  border-color: rgba(255,255,255,.09) !important;
}

.offer-deliverable i {
  background: rgba(229,74,111,.16) !important;
  color: #ff9db2 !important;
}

.offer-deliverable strong {
  color: rgba(255,255,255,.91) !important;
}

.offer-value-anchor {
  color: rgba(255,255,255,.90) !important;
  background: rgba(229,74,111,.10) !important;
  border-left-color: #e54a70 !important;
}

.offer-cta-row small {
  color: rgba(255,255,255,.52) !important;
}

.offer-main-cta {
  background: #fff8f4 !important;
  color: #171210 !important;
  box-shadow: 0 14px 34px rgba(0,0,0,.18);
}

.offer-main-cta:hover {
  background: #fff !important;
}

/* offer support content below products: deliberately visible */
.offer-support-grid {
  margin-top: 22px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.offer-support-card {
  min-height: 190px;
  padding: 24px 26px;
  border: 1px solid rgba(18,17,16,.10);
  border-radius: 22px;
  background: rgba(255,255,255,.72);
  box-shadow: 0 14px 38px rgba(45,34,27,.045);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.offer-support-card > span {
  color: #a7194d;
  font-size: 13px;
  line-height: 1.35;
  font-weight: 800;
}

.offer-support-card p {
  margin: 18px 0 22px;
  max-width: 620px;
  color: #514a45;
  font-size: 15px !important;
  line-height: 1.7 !important;
}

.offer-support-card a {
  margin-top: auto;
  color: #171310;
  font-size: 14px;
  font-weight: 750;
  text-decoration: none;
  border-bottom: 1px solid rgba(23,19,16,.28);
  padding-bottom: 4px;
}

.offer-support-card--dark {
  background: linear-gradient(145deg, #241d1a, #151210);
  border-color: rgba(255,255,255,.08);
  box-shadow: 0 18px 48px rgba(36,26,21,.12);
}

.offer-support-card--dark > span {
  color: #f089a2;
}

.offer-support-card--dark p {
  color: rgba(255,255,255,.70);
}

.offer-support-card--dark strong {
  margin-top: auto;
  color: #fff;
  font-size: 14px;
  line-height: 1.55;
}

.offer-cost-note {
  max-width: none !important;
  margin: 14px 0 0 !important;
  padding: 18px 24px;
  color: #3d3732 !important;
  background: linear-gradient(90deg, rgba(229,74,111,.09), rgba(255,255,255,.50));
  border: 1px solid rgba(167,25,77,.12);
  border-radius: 18px;
  font-size: 14px !important;
  line-height: 1.65 !important;
  text-align: left !important;
}

/* FAQ: premium editorial split layout */
.faq-section {
  padding: 150px 0 132px !important;
  background:
    radial-gradient(circle at 8% 12%, rgba(224,68,105,.07), transparent 25%),
    #f3ede6 !important;
}

.faq-layout-premium {
  display: grid;
  grid-template-columns: minmax(300px, .72fr) minmax(0, 1.28fr);
  gap: 72px;
  align-items: start;
}

.faq-intro-panel {
  position: sticky;
  top: 118px;
  padding-right: 28px;
}

.faq-intro-panel h2 {
  margin: 22px 0 22px;
  max-width: 650px;
  font: 560 clamp(50px, 5.2vw, 80px)/.91 var(--display);
  letter-spacing: -.062em;
}

.faq-intro-panel > p {
  max-width: 540px;
  margin: 0;
  color: #625a54;
  font-size: 17px;
  line-height: 1.72;
}

.faq-intro-link {
  display: inline-flex;
  gap: 12px;
  margin-top: 30px;
  padding-bottom: 6px;
  border-bottom: 1px solid rgba(18,17,16,.24);
  color: #191512;
  text-decoration: none;
  font-size: 14px;
  font-weight: 750;
}

.faq-list-premium {
  display: block !important;
  border: 1px solid rgba(18,17,16,.09) !important;
  border-radius: 26px;
  overflow: hidden;
  background: rgba(255,255,255,.52);
  box-shadow: 0 24px 65px rgba(45,32,25,.06);
}

.faq-list-premium details,
.faq-list-premium details:nth-child(odd) {
  min-height: 0 !important;
  border: 0 !important;
  border-bottom: 1px solid rgba(18,17,16,.08) !important;
  background: transparent !important;
}

.faq-list-premium details:last-child {
  border-bottom: 0 !important;
}

.faq-list-premium details[open] {
  background: #fffaf6 !important;
}

.faq-list-premium summary {
  min-height: 86px !important;
  padding: 22px 24px !important;
  display: grid !important;
  grid-template-columns: 38px minmax(0,1fr) 34px;
  align-items: center;
  gap: 16px;
  color: #1d1815 !important;
  font-size: 16px !important;
  line-height: 1.4 !important;
  font-weight: 650 !important;
}

.faq-number {
  color: #be3d62;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .12em;
}

.faq-list-premium summary i {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  justify-self: end;
  border-radius: 50%;
  background: rgba(167,25,77,.07);
  color: #b22855 !important;
  font-size: 19px !important;
  transition: transform .2s ease, background .2s ease;
}

.faq-list-premium details[open] summary i {
  background: rgba(167,25,77,.12);
}

.faq-list-premium details > p {
  max-width: 820px !important;
  margin: -2px 74px 26px 78px !important;
  color: #625a54 !important;
  font-size: 15px !important;
  line-height: 1.75 !important;
}

/* CTA: clear contrast, no black-on-black / grey-on-black */
.final-cta-premium {
  position: relative;
  overflow: hidden;
  margin-top: 72px !important;
  padding: 44px 46px !important;
  border-radius: 30px !important;
  background:
    radial-gradient(circle at 86% 12%, rgba(239,110,135,.25), transparent 28%),
    linear-gradient(130deg, #211917 0%, #311d24 58%, #771f45 100%) !important;
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 30px 80px rgba(54,30,31,.16);
  grid-template-columns: 1.3fr .7fr !important;
}

.final-cta-premium::before {
  content: '';
  position: absolute;
  width: 360px;
  height: 360px;
  right: -110px;
  top: -190px;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 50%;
  box-shadow: 0 0 0 46px rgba(255,255,255,.025), 0 0 0 92px rgba(255,255,255,.018);
  pointer-events: none;
}

.final-cta-copy,
.final-cta-actions {
  position: relative;
  z-index: 1;
}

.final-cta-premium > .final-cta-copy > span {
  color: #ff9cb3 !important;
  font-size: 10px !important;
}

.final-cta-premium h3 {
  max-width: 850px;
  color: #fff !important;
  font-size: clamp(42px, 4.3vw, 66px) !important;
  line-height: .95 !important;
}

.final-cta-premium p {
  color: rgba(255,255,255,.70) !important;
  font-size: 16px !important;
}

.button--primary-light,
.button--outline-light {
  min-height: 60px;
  width: 100%;
  border-radius: 15px;
  font-size: 15px;
  font-weight: 800;
}

.button--primary-light {
  background: #fff8f4;
  color: #171210;
  box-shadow: 0 14px 32px rgba(0,0,0,.18);
}

.button--primary-light:hover {
  background: #fff;
}

.button--outline-light {
  color: #fff;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.26);
}

.button--outline-light:hover {
  background: rgba(255,255,255,.14);
}

/* footer: clear hierarchy and clean bottom line */
.site-footer {
  padding-top: 92px !important;
}

.footer-brand p {
  color: rgba(255,255,255,.58) !important;
  font-size: 13px !important;
  line-height: 1.75 !important;
}

.footer-brand > strong,
.footer-brand > span {
  display: none !important;
}

.footer-slogan {
  margin-top: 68px;
  padding: 34px 0 28px;
  color: #fff;
  font: 540 clamp(34px, 4.2vw, 62px)/.98 var(--display);
  letter-spacing: -.055em;
  border-top: 1px solid rgba(255,255,255,.07);
}

.footer-slogan span {
  color: rgba(255,255,255,.40);
}

.footer-bottom {
  margin-top: 0 !important;
  padding-top: 20px !important;
  border-top: 1px solid rgba(255,255,255,.09) !important;
  color: rgba(255,255,255,.44) !important;
  font-size: 11px !important;
}

.footer-bottom a {
  color: rgba(255,255,255,.72) !important;
}

@media (max-width: 1050px) {
  .offer-support-grid { grid-template-columns: 1fr; }
  .faq-layout-premium { grid-template-columns: 1fr; gap: 42px; }
  .faq-intro-panel { position: static; padding-right: 0; }
  .final-cta-premium { grid-template-columns: 1fr !important; }
}

@media (max-width: 760px) {
  .principle--v7 h2 .accent-text { margin-top: .10em; }
  .industry-grid h3 { font-size: 26px !important; }
  .offer-support-card { min-height: 0; padding: 20px; }
  .faq-section { padding: 96px 0 !important; }
  .faq-intro-panel h2 { font-size: 48px; }
  .faq-list-premium summary {
    min-height: 78px !important;
    padding: 20px 16px !important;
    grid-template-columns: 28px minmax(0,1fr) 30px;
    gap: 10px;
    font-size: 15px !important;
  }
  .faq-list-premium details > p {
    margin: -2px 16px 22px 54px !important;
    font-size: 14px !important;
  }
  .final-cta-premium { padding: 28px 22px !important; border-radius: 24px !important; }
  .footer-slogan { margin-top: 48px; font-size: 38px; }
  .footer-bottom { flex-direction: column; gap: 12px; }
}

/* =========================================================
   V30 — final interaction / readability polish
   ========================================================= */

/* HERO — make supporting controls visible, not washed out */
.story--fixed-narrative .strategy-story-card--hero .micro-proof {
  margin-top: 22px !important;
  gap: 10px !important;
  color: #5b514a !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span {
  padding: 9px 12px !important;
  border-radius: 999px !important;
  border: 1px solid rgba(28,22,18,.12) !important;
  background: rgba(255,255,255,.72) !important;
  color: #4f463f !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  box-shadow: 0 8px 24px rgba(43,32,26,.04);
}

.story--fixed-narrative .executive-map-nav {
  background: rgba(255,252,248,.94) !important;
  border: 1px solid rgba(31,24,20,.10) !important;
  box-shadow: 0 20px 60px rgba(43,31,25,.10) !important;
}

.story--fixed-narrative .executive-map-nav button {
  color: #5c514a !important;
  font-size: 12px !important;
  font-weight: 700 !important;
}

.story--fixed-narrative .executive-map-nav button.active,
.story--fixed-narrative .executive-map-nav button[aria-current="true"] {
  color: #fff !important;
  background: linear-gradient(110deg, #261f1b 0%, #5f3b38 54%, #9f3155 100%) !important;
}

/* journey cards — less AI-card, more editorial / interactive */
.story--fixed-narrative .strategy-story-card--zone {
  position: relative;
  width: min(560px, 40vw) !important;
  padding: 30px 34px 26px 38px !important;
  border: 1px solid rgba(29,23,19,.10) !important;
  border-left: 3px solid #d84d69 !important;
  border-radius: 0 24px 24px 0 !important;
  background: rgba(255,252,248,.92) !important;
  box-shadow: 0 28px 70px rgba(48,35,28,.10) !important;
  backdrop-filter: blur(16px) !important;
  transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease !important;
}

.story--fixed-narrative .strategy-story-card--zone:hover {
  transform: translateY(-4px) !important;
  box-shadow: 0 36px 88px rgba(48,35,28,.14) !important;
  border-left-color: #b72052 !important;
}

.story--fixed-narrative .strategy-story-card--zone::before {
  content: '' !important;
  position: absolute;
  left: -3px;
  top: 26px;
  width: 3px;
  height: 76px;
  background: linear-gradient(180deg, #f08a70, #d92964) !important;
}

.story--fixed-narrative .strategy-story-card--zone .eyebrow {
  color: #9c674f !important;
  font-size: 11px !important;
  letter-spacing: .14em !important;
}

.story--fixed-narrative .strategy-story-card--zone h2 {
  margin: 18px 0 18px !important;
  font-size: clamp(40px, 3.2vw, 58px) !important;
  line-height: .96 !important;
  letter-spacing: -.06em !important;
}

.story--fixed-narrative .strategy-story-card--zone p {
  color: #655c55 !important;
  font-size: 17px !important;
  line-height: 1.72 !important;
}

.story--fixed-narrative .strategy-zone-proof {
  margin-top: 24px !important;
  padding: 16px 0 0 !important;
  border-top: 1px solid rgba(26,21,18,.10) !important;
  color: #4d4540 !important;
  font-size: 13px !important;
  font-weight: 650 !important;
}

.strategy-zone-action {
  margin-top: 18px;
  padding: 18px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(232,87,105,.09), rgba(255,255,255,.76));
  border: 1px solid rgba(178,37,80,.10);
  display: grid;
  gap: 12px;
}

.strategy-zone-action > span {
  color: #6c5f57;
  font-size: 13px;
  line-height: 1.45;
  font-weight: 650;
}

.story--fixed-narrative .strategy-zone-cta {
  min-height: 56px !important;
  padding: 0 18px !important;
  border-radius: 14px !important;
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: linear-gradient(110deg, #c72e5a 0%, #e56f6a 100%) !important;
  color: #fff !important;
  font-size: 15px !important;
  font-weight: 800 !important;
  text-decoration: none;
  box-shadow: 0 16px 34px rgba(181,42,82,.18);
  transition: transform .2s ease, box-shadow .2s ease !important;
}

.story--fixed-narrative .strategy-zone-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 22px 44px rgba(181,42,82,.24);
}

/* PROCESS — remove tiny numeric labels and make sequence cleaner */
.process-no { display: none !important; }
.process-step {
  padding-top: 34px !important;
}
.process-step h3 {
  margin-top: 0 !important;
}

/* SAMPLE MAP heading */
.sample-heading h2 {
  max-width: 960px;
}

/* PRINCIPLE — keep second sentence on one line where room allows */
.principle--v7 h2 {
  max-width: 1280px !important;
  font-size: clamp(64px, 7vw, 112px) !important;
  line-height: .88 !important;
}

.principle--v7 h2 .accent-text {
  display: inline-block !important;
  margin-top: .08em;
  white-space: nowrap;
  background: linear-gradient(112deg, #ff745e 0%, #f04467 52%, #bd174f 100%) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
}

.principle-signature {
  margin-top: 40px !important;
  padding: 24px 0 0 !important;
  border-top: 1px solid rgba(18,17,16,.10) !important;
  background: linear-gradient(112deg, #ef735f 0%, #da3865 52%, #a7164b 100%) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  font-size: clamp(30px, 3.4vw, 50px) !important;
  line-height: 1.05 !important;
  font-weight: 650 !important;
}

/* OFFER CTA — premium split action instead of a flat white bar */
.offer-cta-row {
  margin-top: 24px !important;
  padding-top: 22px;
  border-top: 1px solid rgba(255,255,255,.10);
}

.offer-main-cta {
  min-height: 72px !important;
  padding: 12px 14px 12px 20px !important;
  border-radius: 18px !important;
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: linear-gradient(110deg, #fffaf6 0%, #f4e9df 100%) !important;
  color: #171210 !important;
  border: 1px solid rgba(255,255,255,.30) !important;
  box-shadow: 0 18px 42px rgba(0,0,0,.18) !important;
  text-decoration: none;
  transition: transform .22s ease, box-shadow .22s ease, background .22s ease !important;
}

.offer-main-cta > span {
  display: grid;
  gap: 5px;
}

.offer-main-cta small {
  color: #a84b61 !important;
  font-size: 9px !important;
  line-height: 1 !important;
  font-weight: 850 !important;
  letter-spacing: .14em;
}

.offer-main-cta strong {
  color: #171210 !important;
  font-size: 16px !important;
  line-height: 1.2 !important;
  font-weight: 800 !important;
}

.offer-main-cta > i {
  flex: none;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #171210;
  color: #fff;
  font-style: normal;
  font-size: 17px;
  transition: transform .22s ease, background .22s ease;
}

.offer-main-cta:hover {
  transform: translateY(-3px) !important;
  background: #fff !important;
  box-shadow: 0 24px 54px rgba(0,0,0,.24) !important;
}

.offer-main-cta:hover > i {
  transform: translate(2px,-2px);
  background: #a7194d;
}

.offer-cta-row > small {
  margin-top: 10px;
  display: block;
  color: rgba(255,255,255,.62) !important;
  font-size: 13px !important;
  line-height: 1.55 !important;
}

/* Support cards under offer — stronger hierarchy / contrast */
.offer-support-card,
.offer-support-card--dark {
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}
.offer-support-card:hover,
.offer-support-card--dark:hover {
  transform: translateY(-4px);
  box-shadow: 0 24px 58px rgba(39,28,23,.10);
}
.offer-cost-note {
  color: #2f2925 !important;
  font-weight: 600;
}

@media (max-width: 1000px) {
  .principle--v7 h2 .accent-text { white-space: normal; }
  .story--fixed-narrative .strategy-story-card--zone { width: min(540px, 48vw) !important; }
}

@media (max-width: 760px) {
  .story--fixed-narrative .strategy-story-card--zone {
    width: 100% !important;
    border-radius: 20px !important;
    padding: 24px 22px !important;
  }
  .story--fixed-narrative .strategy-story-card--zone h2 { font-size: 40px !important; }
  .principle--v7 h2 { font-size: 56px !important; }
  .principle--v7 h2 .accent-text { white-space: normal; }
  .offer-main-cta { min-height: 66px !important; }
}

/* =========================================================
   V31 — hero proof cleanup, editorial journey, modern product CTA
   ========================================================= */

/* HERO — stronger actions + plain trust line, no pill/tag treatment */
.story--fixed-narrative .strategy-story-card--hero .hero-title-clean {
  max-width: 13.4ch !important;
  font-size: clamp(68px, 5.55vw, 96px) !important;
  line-height: .91 !important;
  letter-spacing: -.076em !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-lead {
  max-width: 39ch !important;
  font-size: 18px !important;
  line-height: 1.72 !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions {
  margin-top: 30px !important;
  gap: 12px !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions .button {
  min-height: 62px !important;
  padding: 0 24px !important;
  border-radius: 14px !important;
  font-size: 14px !important;
  font-weight: 760 !important;
}

.story--fixed-narrative .strategy-story-card--hero .hero-actions .button--dark {
  box-shadow: 0 16px 38px rgba(19,15,13,.15) !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof {
  margin-top: 20px !important;
  display: flex !important;
  align-items: center !important;
  gap: 0 !important;
  color: #766d65 !important;
  font-size: 11px !important;
  line-height: 1 !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span {
  position: relative;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  color: #766d65 !important;
  box-shadow: none !important;
  font-size: 11px !important;
  font-weight: 650 !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span + span {
  margin-left: 13px;
  padding-left: 15px !important;
}

.story--fixed-narrative .strategy-story-card--hero .micro-proof span + span::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 1px;
  height: 14px;
  background: rgba(36,29,25,.16);
  transform: translateY(-50%);
}

/* Keep narrative content above every map/fog layer */
.story--fixed-narrative .strategy-story-ui {
  z-index: 20 !important;
}

.story--fixed-narrative .strategy-story-ui::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: min(760px, 52vw);
  z-index: -1;
  pointer-events: none;
  background: linear-gradient(90deg,
    rgba(248,244,238,.98) 0%,
    rgba(248,244,238,.95) 50%,
    rgba(248,244,238,.72) 72%,
    rgba(248,244,238,0) 100%);
}

/* JOURNEY — editorial open layout, no generic AI card */
.story--fixed-narrative .strategy-story-card--zone {
  position: relative;
  width: min(620px, 42vw) !important;
  padding: 8px 18px 12px 34px !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  overflow: visible !important;
  transition: none !important;
}

.story--fixed-narrative .strategy-story-card--zone:hover {
  transform: none !important;
  box-shadow: none !important;
}

.story--fixed-narrative .strategy-story-card--zone::before {
  content: '' !important;
  position: absolute;
  left: 0;
  top: 10px;
  width: 3px;
  height: 104px;
  border-radius: 3px;
  background: linear-gradient(180deg, #f08b71 0%, #d82d64 100%) !important;
  box-shadow: 0 0 0 1px rgba(214,50,96,.03);
}

.story--fixed-narrative .strategy-story-card--zone .eyebrow {
  color: #9d6750 !important;
