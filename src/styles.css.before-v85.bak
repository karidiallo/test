/* =========================================================
   V32 — hero scale correction + stage-specific readability
   ========================================================= */

/* Do not paint the hero readability wash over the later map stages. */
.story--fixed-narrative .strategy-story-ui::before {
  display: none !important;
}

.story--fixed-narrative .strategy-story-ui--hero::before {
  content: '';
  display: block !important;
